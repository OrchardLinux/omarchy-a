#!/bin/busybox sh
# First experiment: bounded observations only. No register dumps or writes.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
log=/run/charger-001-$(date +%s)-$$.log
echo "Recording ten power-supply snapshots to $log"
(
    uname -a
    n=0
    while [ "$n" -lt 10 ]; do
        printf '\nuptime: '; cat /proc/uptime
        found=false
        for supply in /sys/class/power_supply/*; do
            [ -d "$supply" ] || continue
            found=true
            echo "supply: ${supply##*/}"
            for field in type present online status capacity temp voltage_now current_now; do
                [ -r "$supply/$field" ] || continue
                printf '%s=' "$field"
                cat "$supply/$field" || echo unavailable
            done
        done
        if [ "$found" = false ]; then
            echo 'No power supplies registered. No drivers will be loaded automatically.'
        fi
        n=$((n + 1))
        sleep 1
    done
) > "$log" 2>&1
cat "$log"
echo 'Observation complete. This does not establish source capability or charging safety.'
