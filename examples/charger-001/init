#!/bin/busybox sh
# This experiment's PID 1. USB shell and SSH only; charger-test stays manually invoked.
set -eu
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid devtmpfs /dev
mount -t tmpfs -o nosuid,nodev tmpfs /run
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
exec </dev/console >/dev/console 2>&1
# No hotplug module loader; optional staged modules are for manual use only.
echo /bin/false > /proc/sys/kernel/modprobe
# USB serial, USB network and SSH for `orchard shell/exec/push/pull`.
sh /usr/libexec/orchard/usb-session || echo 'USB session failed; see above'
name=$(cat /etc/hostname)
echo "$name: RAM-only. USB root shell is unauthenticated; trusted host only."
[ ! -f /etc/motd ] || cat /etc/motd
while :; do
    setsid sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1 || true
    sleep 1
done
