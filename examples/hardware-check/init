#!/bin/busybox sh
# This example's PID 1: a RAM-only system that checks what the device offers.
# Storage is set read-only as soon as it appears; nothing mounts it. USB
# serial root shell plus USB networking and SSH; run `hardware-check` at the shell.
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
/bin/busybox --install -s /bin
mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t devtmpfs -o nosuid devtmpfs /dev
mount -t tmpfs -o nosuid,nodev tmpfs /run
mkdir -p /dev/pts /var/run /tmp
mount -t devpts devpts /dev/pts
exec </dev/console >/dev/console 2>&1

# Drivers request helper modules (brcmfmac its firmware vendor module) through
# the kernel's module loader; let them. Then load drivers for the devices that
# are already present.
echo /bin/modprobe > /proc/sys/kernel/modprobe
coldplug() {
    for alias in /sys/bus/*/devices/*/modalias; do
        [ -r "$alias" ] && modprobe -qb "$(cat "$alias")" 2>/dev/null || true
    done
}

# Storage: fence every NVMe namespace and partition read-only once they appear.
(
    i=0
    while [ ! -e /sys/class/block/nvme0n1 ] && [ "$i" -lt 60 ]; do
        coldplug
        sleep 1
        i=$((i + 1))
    done
    sleep 2
    for d in /sys/class/block/nvme*; do
        [ -e "$d" ] && blockdev --setro "/dev/${d##*/}"
    done
    echo "$i" > /run/storage-fence
) &
coldplug

# USB serial, USB network and SSH for `orchard shell/exec/push/pull`.
sh /usr/libexec/orchard/usb-session || echo 'USB session failed; see above'
name=$(cat /etc/hostname)

# The report (/run) is also served at http://172.16.42.1:8080/ over USB.
httpd -p 172.16.42.1:8080 -h /run 2>/dev/null || true

echo "$name: RAM-only. USB root shell is unauthenticated; trusted host only."
[ ! -f /etc/motd ] || cat /etc/motd
# Quick Wi-Fi check at boot when the image carries a network to join.
[ ! -f /etc/wpa_supplicant.conf ] || hardware-check wifi >/dev/null 2>&1 &
while :; do
    setsid -c sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1 || true
    sleep 1
done
