#!/usr/bin/env python3
"""Apply Omarchy artwork explicitly to the independent hardware loader producer."""
import argparse
from pathlib import Path
import subprocess
import sys
import tempfile
import orchard_hardware

# The splash only draws into m1n1's boot framebuffer. J71t applies the J71b
# patch unchanged on top of its own loader patches (m1n1 d5a10ac52a).
SPLASH = {'j71b': 'j71b', 'j71t': 'j71b'}

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', required=True, type=Path)
parser.add_argument('--device', default='j71b', choices=sorted(SPLASH))
parser.add_argument('--resume', action='store_true')
parser.add_argument('--logo-header', type=Path, help='pre-generated matching artwork header (CI)')
args = parser.parse_args()
here = Path(__file__).resolve().parent
with tempfile.TemporaryDirectory(prefix='omarchy-loader-') as temporary:
    header = args.logo_header or Path(temporary) / 'omarchy-logo.h'
    if not args.logo_header:
        subprocess.run([sys.executable, str(here / 'pongo/generate-logo.py'),
                        '--size', '480', '--output', str(header)], check=True)
    subprocess.run([str(Path(orchard_hardware.__file__).parent / 'boot/m1n1/build'),
                    args.device, '--output', str(args.output),
                    '--extra-patch', str(here / 'm1n1/patches' / SPLASH[args.device] / '0002-omarchy-splash.patch'),
                    '--include-header', str(header), '--extra-cflags', '-DOMARCHY_SPLASH',
                    *(['--resume'] if args.resume else [])], check=True)
