#!/usr/bin/env python3
"""The Omarchy boot artwork as data for orchard's m1n1: the boot splash and the m1n1 logo.

  boot/build-artwork --output DIR [--logo-header omarchy-logo.h]

DIR/splash is orchard's boot splash (docs/boot-contract.md), the green mark
at 480 px, which m1n1 paints for an installed boot entry. DIR/logo.bin, the
installer's picture after m1n1, is the same splash: orchard's m1n1 (patch
0014) draws it at its own size, so install and boot show the same mark.
Needs rsvg-convert and ImageMagick (generate-logo.py); no m1n1 build.
"""
import argparse
from pathlib import Path
import subprocess
import sys
import tempfile

HERE = Path(__file__).resolve().parent


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--logo-header', type=Path, help='pre-generated artwork header (CI)')
    args = parser.parse_args()
    if args.output.exists():
        parser.error('Choose a new output directory')
    args.output.mkdir(parents=True)
    with tempfile.TemporaryDirectory(prefix='omarchy-artwork-') as temporary:
        header = args.logo_header or Path(temporary) / 'omarchy-logo.h'
        if not args.logo_header:
            subprocess.run([sys.executable, str(HERE / 'generate-logo.py'), '--size', '480',
                            '--output', str(header)], check=True)
        subprocess.run([sys.executable, str(HERE / 'splash.py'), str(header), str(args.output / 'splash')],
                       check=True)
    (args.output / 'logo.bin').write_bytes((args.output / 'splash').read_bytes())
    print(f'Built {args.output}/splash and {args.output}/logo.bin')


if __name__ == '__main__':
    main()
