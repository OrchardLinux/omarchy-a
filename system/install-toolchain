#!/usr/bin/env bash
set -euo pipefail
sed -i '/^DownloadUser = /d; /^CheckSpace/a DisableSandboxFilesystem\nDisableSandboxSyscalls' /etc/pacman.conf
# Arch Linux ARM mirrors are slow per connection: ten downloads at a time.
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/' /etc/pacman.conf
# pacman's own stall timeout (nothing for 10 s: next mirror) must stay on.
sed -i '/^DisableDownloadTimeout/d' /etc/pacman.conf
# The mirrors that are fastest from here now, fastest first; a failing one
# hands over to the next. pacman-download bounds and retries the downloads.
install -m 755 "$(dirname "$0")/rank-mirrors" "$(dirname "$0")/pacman-download" /usr/local/bin/
rank-mirrors
pacman-key --init
pacman-key --populate archlinuxarm
# The base image's kernel and firmware are not needed to build: never download them.
mapfile -t unneeded < <(pacman -Qq | grep -E '^(linux-aarch64|linux-armv7|linux-firmware.*)$')
(( ${#unneeded[@]} == 0 )) || pacman -Rdd --noconfirm "${unneeded[@]}"
packages=(arch-install-scripts python)
pacman-download -Sy --noconfirm --needed "${packages[@]}"
pacman -S --noconfirm --needed "${packages[@]}"
pacman -Sc --noconfirm
