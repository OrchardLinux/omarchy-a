ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY desktop/install-toolchain desktop/rank-mirrors desktop/pacman-download /tmp/desktop/
RUN test "$(uname -m)" = armv7l && \
    bash /tmp/desktop/install-toolchain && \
    pacman-download -Syu --noconfirm --needed arch-install-scripts && \
    pacman -Su --noconfirm --needed arch-install-scripts && \
    pacman -Q > /usr/share/omarchy-builder-packages.lock && \
    pacman -Sc --noconfirm && rm -rf /tmp/desktop
LABEL org.orchard.target.architecture="armv7h"
WORKDIR /work
