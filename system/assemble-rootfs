#!/usr/bin/env bash
set -euo pipefail
root= output= desktop= release= architecture=aarch64
while (($#)); do
  case "$1" in
    --root) root=$2; shift 2;;
    --output) output=$2; shift 2;;
    --desktop) desktop=$2; shift 2;;
    --release) release=$2; shift 2;;
    --architecture) architecture=$2; shift 2;;
    *) echo "Unknown argument: $1" >&2; exit 2;;
  esac
done
for value in "$root" "$output" "$desktop" "$release"; do
  [[ -n "$value" ]] || { echo 'Missing required build input' >&2; exit 2; }
done
case "$architecture" in
  aarch64) expected_machine=aarch64;;
  armv7h) expected_machine=armv7l;;
  *) echo "Unsupported userspace architecture: $architecture" >&2; exit 2;;
esac
[[ $(uname -m) == "$expected_machine" && $EUID == 0 ]] || { echo "Requires an $expected_machine Arch Linux ARM build environment as root" >&2; exit 1; }
for cmd in pacman useradd usermod systemctl tar bsdtar python3; do command -v "$cmd" >/dev/null || { echo "Missing $cmd" >&2; exit 1; }; done
project=$(cd "$(dirname "$0")/.." && pwd)
root=$(realpath -m -- "$root")
output=$(realpath -m -- "$output")
[[ "$root" != / && ! -e "$root" && ! -e "$output" ]] || { echo 'Root and archive must be new paths' >&2; exit 1; }
mapfile -t requested < <(grep -vE '^\s*(#|$)' "$project/system/packages.txt")
[[ ${#requested[@]} -gt 0 ]] || exit 1
printf '%s\n' "${requested[@]}" | grep -Eq '^linux(-aarch64|-armv7|-rpi)?$' && { echo 'Generic kernel is not an input' >&2; exit 1; }
local_packages=("$desktop/packages/omafox.pkg.tar.xz" "$desktop/packages/wlroots0.20.pkg.tar.xz")
# Omacalc: upstream Omarchy publishes it for aarch64 only; ARMv7 builds it from source.
[[ $architecture == aarch64 ]] || local_packages+=("$desktop/packages/omacalc.pkg.tar.zst")
# 64-bit boards: the A10 GPU's Vulkan driver and the VA-API bridge to the
# hardware video decoders. Both sit unused on a board without that hardware.
[[ $architecture != aarch64 ]] || local_packages+=("$desktop/packages/vulkan-powervr-orchard.pkg.tar.zst" "$desktop/packages/libva-v4l2-request.pkg.tar.zst")
for package in "${local_packages[@]}"; do
  bsdtar -xOf "$package" .PKGINFO | grep -x "arch = $architecture" >/dev/null || { echo "Package architecture differs from $architecture: $package" >&2; exit 1; }
done

# Install signed packages into a clean target; no mounts or VM root are needed.
# The caller's umask 077 would make pacman's own state (/var/lib/pacman,
# /var/cache/pacman) root-only, breaking downloads as DownloadUser and queries
# as tablet. Image contents need distribution modes.
umask 022
mkdir -p "$root/var/lib/pacman" "$root/var/cache/pacman/pkg" "$root/etc"
# The image's mirror order was measured when it was built: measure again.
"$project/system/rank-mirrors"
# 64-bit images use upstream Omarchy's package repository the way upstream's
# aarch64 platforms do: listed before Arch Linux ARM's, signed with Omarchy's
# key, and kept in the installed system's pacman.conf, so its apps (Omacalc)
# update with the system. The build uses its own copies of pacman.conf and the
# keyring, so a native build host keeps its own.
omarchy_repo() { # SOURCE TARGET: SOURCE with [omarchy] before [core]
  grep -qx '\[omarchy\]' "$1" && { echo "Already lists [omarchy]: $1" >&2; return 1; }
  [[ $(grep -cx '\[core\]' "$1") == 1 ]] || { echo "Expected one [core]: $1" >&2; return 1; }
  awk '$0 == "[core]" { print "[omarchy]"; print "Server = https://pkgs.omarchy.org/stable/$arch"; print "" } { print }' \
    "$1" > "$2.new" && mv "$2.new" "$2"
}
config=/etc/pacman.conf gpgdir=/etc/pacman.d/gnupg
if [[ $architecture == aarch64 ]]; then
  build_pacman=$(mktemp -d)
  trap 'rm -rf -- "$build_pacman"' EXIT
  omarchy_repo /etc/pacman.conf "$build_pacman/pacman.conf"
  cp -a /etc/pacman.d/gnupg "$build_pacman/gnupg"
  config=$build_pacman/pacman.conf gpgdir=$build_pacman/gnupg
  pacman-key --gpgdir "$gpgdir" --add "$project/system/omarchy-pkgs.asc"
  pacman-key --gpgdir "$gpgdir" --lsign-key 40DFB630FF42BCFFB047046CF0134EE680CAC571
  requested+=(omarchy-keyring omacalc)
fi
# Download into the target's package cache with bounded, retried attempts that
# move on to the next mirror, then install from that cache.
"$project/system/pacman-download" --config "$config" --root "$root" --gpgdir "$gpgdir" -Sy --noconfirm "${requested[@]}"
pacman --config "$config" --root "$root" --gpgdir "$gpgdir" -S --noconfirm "${requested[@]}"
[[ $architecture != aarch64 ]] || omarchy_repo "$root/etc/pacman.conf" "$root/etc/pacman.conf"
# wlroots0.20 replaces Arch's build of the same version: fast rotated pixman compositing.
for package in "${local_packages[@]}"; do
  pacman --config "$config" --root "$root" --gpgdir "$gpgdir" --noconfirm -U "$package"
done
useradd --root "$root" --create-home --uid 1000 --user-group --shell /bin/bash tablet
# Native login needs seatd's socket and DRM/input device access (render: the
# GPU, video: the hardware video decoder, also over SSH); wheel
# makes the account polkit's admin, so prompts take its password.
usermod --root "$root" --append --groups seat,video,render,input,wheel tablet
# The greeter (greetd's own user) draws through seatd and wakes the panel.
usermod --root "$root" --append --groups seat,video,input greeter
# Normalize only copied desktop ownership. Recursive chown of the installed
# package tree clears setuid/setgid bits and file capabilities (including sudo).
cp -a --no-preserve=ownership "$desktop/payload/." "$root/"
chown -R 1000:1000 "$root/home/tablet"
install -d "$root/etc/systemd/system"
# Suspend stays possible; orchard allows it per board. Hibernation never is.
for unit in hibernate hybrid-sleep suspend-then-hibernate; do
  ln -s /dev/null "$root/etc/systemd/system/$unit.target"
done
systemctl --root="$root" enable greetd.service NetworkManager.service bluetooth.service seatd.service systemd-timesyncd.service
: > "$root/etc/machine-id"
# Without a static name, NetworkManager adopts the network's reverse DNS
# name and BlueZ advertises "archlinux" to accessories.
printf 'omarchy-ipad\n' > "$root/etc/hostname"
chmod 644 "$root/etc/hostname"
rm -f "$root/var/lib/dbus/machine-id" "$root/etc/ssh"/ssh_host_*
rm -rf -- "$root/etc/pacman.d/gnupg"
install -d "$root/etc/ipadlinux"
printf '%s\n' "$release" > "$root/etc/ipadlinux/release"
mkdir -p "$(dirname "$output")"
pacman --root "$root" -Q > "$(dirname "$output")/packages.lock"
tar --hard-dereference --numeric-owner --one-file-system -C "$root" \
  --exclude='./dev/*' --exclude='./proc/*' --exclude='./sys/*' \
  --exclude='./run/*' --exclude='./tmp/*' --exclude='./var/cache/pacman/pkg/*' \
  -cf - . | gzip -1 > "$output"
python3 - "$output" "$release" "$architecture" "$root" "$project" <<'PY'
import hashlib,json,pathlib,sys
archive,release=pathlib.Path(sys.argv[1]),sys.argv[2]
sys.path.insert(0,sys.argv[5])
from release.architecture import check_elf
architecture=sys.argv[3]
check_elf(pathlib.Path(sys.argv[4])/'usr/lib/systemd/systemd',architecture,'root systemd')
h=hashlib.sha256()
with archive.open('rb') as stream:
 for block in iter(lambda:stream.read(1024*1024),b''):h.update(block)
lock=archive.parent/'packages.lock'
metadata={'release':release,'architecture':architecture,'bytes':archive.stat().st_size,'sha256':h.hexdigest(),
          'packages_lock_sha256':hashlib.sha256(lock.read_bytes()).hexdigest()}
archive.with_suffix(archive.suffix+'.json').write_text(json.dumps(metadata,indent=2)+'\n')
print('Clean rootfs:',archive,'SHA-256',h.hexdigest())
PY
