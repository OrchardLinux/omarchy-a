// The local active session may request warm restart through the load unit.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "orchard-kexec-load.service" &&
        action.lookup("verb") == "start" && subject.local && subject.active &&
        subject.isInGroup("wheel")) return polkit.Result.YES;
});
