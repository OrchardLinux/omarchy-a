#%PAM-1.0
# greetd's default session (user greeter, omarchy-session-failed) needs no
# password. The tablet's session starts without a prompt through
# /etc/pam.d/greetd, which the installer writes; its PIN is the lock's.
auth     required pam_permit.so
account  include  system-local-login
session  include  system-local-login
