#!/usr/bin/python3
"""The one owner of screen, lock request and sleep. See docs/power-and-lock.md.

Machine is the state machine: no I/O, no clocks, every input defined in every
state. Daemon around it reads the keys, drives the backlight and talks to
logind and the session. The state is never inferred from brightness or files.
"""
import fcntl
import grp
import json
import os
from pathlib import Path
import pwd
import queue
import select
import signal
import socket
import struct
import subprocess
import sys
import threading
import time

ON, GRACE, SETTLING, DARK, SUSPENDING = 'ON', 'GRACE', 'SETTLING', 'DARK', 'SUSPENDING'
STATES = (ON, GRACE, SETTLING, DARK, SUSPENDING)
EVENTS = ('power', 'home', 'wake', 'idle', 'settle', 'lock-ok', 'lock-failed', 'playing', 'not-playing',
          'suspend-refused', 'suspend-unavailable', 'suspend-blocked', 'suspend-busy', 'sleep-signal', 'sleep-ended',
          'sleep-aborted', 'timeout', 'grace-ended', 'lock')
IDLE_GRACE_SECONDS = 8.0
FADE_SECONDS = 0.24
SETTLE_SECONDS = 10.0
# A sleep refused for now is asked for again after this, dark and locked meanwhile.
# (A board that cannot sleep at all stays DARK until pressed instead.)
RETRY_SECONDS = 60.0
# Kernel attempts that aborted in a row, nothing pressed, before it stops asking for a while:
# a board whose suspend never completes would otherwise freeze for every attempt, every settle.
ABORTS_BEFORE_DARK = 3
# How long it then stays dark and locked before it asks again; a press or a real sleep ends it.
BACKOFF_SECONDS = 600.0
TICK_SECONDS = 0.05
# A suspend asked for and not seen to begin (no PrepareForSleep, no kernel attempt) in this
# much time awake did not happen. Once it began, only its end ends it: logind's
# PrepareForSleep(false) or systemd-suspend finishing, and the kernel's counters say how.
SUSPEND_AWAKE_SECONDS = 30.0
# A sleep that began and whose end was never seen, as a last resort.
SLEEP_END_AWAKE_SECONDS = 120.0
# Time awake is what the loop ran: a gap between two of its turns longer than this was a
# freeze or a sleep, and counts as this much, whatever a kernel's clocks do in sleep.
AWAKE_STEP_MAX = 1.0
# Every backlight write is a kernel uevent (backlight_generate_event) on the socket this
# loop watches: a fade writes once a frame, else each write wakes the loop for the next.
FRAME_SECONDS = 1 / 60
# logind refuses a delay inhibitor until its sleep is over (PrepareForSleep(false)); if
# that is never seen, it is asked anyway this long after the end of systemd-suspend.
LOGIND_END_WAIT_SECONDS = 5.0
# CLOCK_MONOTONIC stops in a sleep. (getattr: the tests also run where there is no boot time.)
SLEEP_CLOCK = getattr(time, 'CLOCK_BOOTTIME', time.CLOCK_MONOTONIC)
LOGIND = 'org.freedesktop.login1'


class Machine:
    """state: see the invariants in docs/power-and-lock.md.

    inflight: a suspend was asked for and has not ended. It survives a wake
    press (state ON): the panel lights at once, while systemd-suspend finishes.
    """

    def __init__(self):
        self.state = ON
        self.lock_ok = False
        self.settle_due = False
        self.inflight = False
        self.playing = False
        self.no_suspend = False
        self.hold_release = False
        self.aborts = 0

    def _darken(self):
        self.lock_ok = self.settle_due = self.no_suspend = self.playing = False
        self.state = SETTLING
        return ['dark', 'lock', 'arm-settle']

    def _light(self, *first):
        self.state, self.aborts = ON, 0
        self.playing = self.settle_due = False
        return [*first, 'light', 'woke']

    def _settle_again(self):
        self.state, self.settle_due = SETTLING, False
        # Suspend keeps aborting here: ask again, but not before the backoff.
        return ['arm-backoff' if self.aborts >= ABORTS_BEFORE_DARK else 'arm-settle']

    def _begin_suspend(self):
        self.state, self.inflight = SUSPENDING, True
        return ['suspend']

    def _external_sleep(self, *first):
        # Someone else asked logind to sleep: dark and locked first, then let it.
        actions = list(first)
        if self.state in (ON, GRACE):
            self.lock_ok = False
            if self.state == GRACE:
                actions += ['cancel-grace']
            actions += ['dark', 'lock']
        self.state, self.inflight = SUSPENDING, True
        if self.lock_ok:
            actions.append('release-inhibitor')
        else:
            self.hold_release = True
        return actions

    def _lock_answer(self, ok):
        actions = []
        self.lock_ok = ok
        if self.hold_release:
            self.hold_release = False
            actions.append('release-inhibitor')
        return actions

    def handle(self, event):
        """The actions of EVENT, in order; the state afterwards is self.state."""
        if event not in EVENTS:
            raise ValueError(event)
        if event == 'sleep-ended':
            self.aborts = 0
        # A suspend ending or failing is bookkeeping unless it is what SUSPENDING waits for.
        if event in ('sleep-ended', 'sleep-aborted', 'suspend-refused', 'suspend-unavailable', 'suspend-blocked',
                     'suspend-busy', 'timeout') and self.state != SUSPENDING:
            if self.inflight:
                self.inflight = False
                # Pressed dark again while the last sleep was finishing, and settled since.
                if self.state == SETTLING and self.settle_due and self.lock_ok:
                    return ['take-inhibitor'] + self._begin_suspend()
                return ['take-inhibitor']
            return []
        return getattr(self, '_' + self.state.lower())(event)

    def _on(self, event):
        if event in ('power', 'lock'):
            return self._darken()
        if event == 'idle':
            self.state = GRACE
            self.lock_ok = False
            return ['dark', 'arm-grace']
        if event == 'sleep-signal':
            return [] if self.inflight else self._external_sleep()
        if event == 'lock-ok':
            return self._lock_answer(True)
        if event == 'lock-failed':
            return self._lock_answer(False)
        return []  # home and wake: already lit; playing, settle: not relevant while lit

    def _grace(self, event):
        if event in ('power', 'home', 'wake'):
            return self._light('cancel-grace')
        if event == 'grace-ended':
            return self._darken()
        if event == 'lock':  # asked for explicitly: no more grace
            return ['cancel-grace'] + self._darken()
        if event == 'sleep-signal':
            return self._external_sleep()
        return []

    def _settling(self, event):
        if event in ('power', 'home', 'wake'):
            return self._light('cancel-settle')
        if event == 'settle':
            self.settle_due = True
            return self._begin_suspend() if self.lock_ok and not self.inflight else []
        if event == 'lock-ok':
            actions = self._lock_answer(True)
            return actions + (self._begin_suspend() if self.settle_due and not self.inflight else [])
        if event == 'lock-failed':
            # Never an unsecured desktop that looks locked.
            return self._lock_answer(False) + self._light('cancel-settle', 'notify')
        if event == 'playing':
            self.state, self.playing = DARK, True
            return ['cancel-settle']
        if event == 'sleep-signal':
            return self._external_sleep('cancel-settle')
        return []

    def _dark(self, event):
        if event in ('power', 'home', 'wake'):
            return self._light()
        if event == 'lock-ok':
            return self._lock_answer(True)
        if event == 'lock-failed':
            return self._lock_answer(False) + self._light('notify')
        if event == 'playing':
            self.playing = True
            return []
        if event == 'not-playing':
            self.playing = False
            return [] if self.no_suspend else self._settle_again()
        if event == 'sleep-signal':
            return self._external_sleep()
        return []

    def _suspending(self, event):
        if event in ('power', 'home', 'wake'):
            # The kernel aborts or ends the sleep for this press (wakeup_count).
            return self._light('cancel-suspend')
        if event == 'lock-ok':
            return self._lock_answer(True)
        if event == 'lock-failed':
            return self._lock_answer(False)
        if event in ('sleep-ended', 'sleep-aborted'):
            # Nothing pressed: a charger, an alarm, an aborted attempt. Stay dark.
            # Aborted with nothing pressed counts: a press aborts it too, but lands in ON.
            if event == 'sleep-aborted':
                self.aborts = min(self.aborts + 1, ABORTS_BEFORE_DARK)
            self.inflight = False
            return ['take-inhibitor'] + self._settle_again()
        if event in ('suspend-busy', 'timeout'):
            # It did not happen this time: try again, never dark for no reason.
            self.inflight = False
            return ['take-inhibitor'] + self._settle_again()
        if event == 'suspend-refused':
            # Refused this time (logind's CanSuspend): never dark and awake
            # for good. Stay dark and locked, and ask again later.
            self.inflight, self.state, self.settle_due = False, SETTLING, False
            return ['take-inhibitor', 'arm-retry']
        if event == 'suspend-unavailable':
            # This board cannot sleep: asking again changes nothing. Dark until pressed.
            self.inflight, self.no_suspend, self.state = False, True, DARK
            return ['take-inhibitor']
        if event == 'suspend-blocked':
            self.inflight, self.playing, self.state = False, True, DARK
            return ['take-inhibitor']
        return []


def log(message):
    print(message, flush=True)


def parse_supply_uevent(message):
    """(name, online) from a kernel uevent of a power supply that has an online state, else None."""
    fields = dict(item.split('=', 1) for item in message.decode(errors='replace').split('\0') if '=' in item)
    if fields.get('SUBSYSTEM') != 'power_supply' or 'POWER_SUPPLY_ONLINE' not in fields:
        return None
    return fields.get('POWER_SUPPLY_NAME', ''), fields['POWER_SUPPLY_ONLINE'] == '1'


def plugged_in(known, name, online):
    """Whether this report is a source being plugged in; remembers it in known."""
    was = known.get(name, False)
    known[name] = online
    return online and not was


def parse_sleep_signal(line):
    """True or False from a `busctl --json=short monitor` line of PrepareForSleep, else None."""
    try:
        message = json.loads(line)
        if message.get('member') == 'PrepareForSleep':
            return bool(message['payload']['data'][0])
    except (ValueError, KeyError, IndexError, TypeError, AttributeError):
        pass
    return None


def parse_logind_started(line):
    """Whether a `busctl --json=short monitor` line says logind just took its name."""
    try:
        message = json.loads(line)
        if message.get('member') == 'NameOwnerChanged':
            name, _, owner = message['payload']['data']
            return name == LOGIND and bool(owner)
    except (ValueError, KeyError, TypeError, AttributeError):
        pass
    return False


def streams_running(dump):
    """Whether `pw-dump` output has an audio or video playback stream that is running."""
    try:
        for item in json.loads(dump):
            info = item.get('info') or {}
            media = (info.get('props') or {}).get('media.class', '')
            if media.startswith('Stream/Output/') and info.get('state') == 'running':
                return True
    except (ValueError, AttributeError):
        pass
    return False


EV_KEY, KEY_POWER, KEY_HOMEPAGE = 1, 116, 172
EV_SW, SW_MACHINE_COVER = 5, 0x10
EV_SYN, SYN_REPORT, SYN_DROPPED = 0, 0, 3
INPUT_EVENT = struct.Struct('qqHHi')
EVIOCSCLOCKID = 0x400445a0
SWITCH_BITMAP = struct.Struct('@L')
EVIOCGSW = 0x8000451b | (SWITCH_BITMAP.size << 16)
SOCKET = '/run/omarchy-powerd.sock'
# OMARCHY_PATH: the omarchy-a package's Omarchy tree.
SHELL_ROOT = '/usr/share/omarchy'
STATS = Path('/sys/power/suspend_stats')
WAKEUP_COUNT = Path('/sys/power/wakeup_count')
BACKLIGHTS = Path('/sys/class/backlight')
BRIGHTNESS = Path('/var/lib/omarchy-powerd/brightness')
USB_DEVICES = Path('/sys/bus/usb/devices')


def usb_new_devices(allowed):
    """Whether newly plugged USB devices are enabled, on every USB host.

    Off while the screen is locked: a stick or a USB keyboard plugged into a
    locked tablet stays off, also after the unlock, until it is plugged in
    again unlocked. Devices already enabled stay as they are.
    """
    for switch in sorted(USB_DEVICES.glob('usb*/authorized_default')):
        try:
            switch.write_text('1' if allowed else '0')
        except OSError as error:
            log(f'{switch}: {error}')


# A longer hold of Power is not a press: it is the start of a forced restart or DFU.
LONG_HOLD_SECONDS = 1.5


def key_edges(data):
    """(key name, down, kernel seconds) of every Power and Home press and release in evdev bytes."""
    edges = []
    for sec, usec, kind, code, value in INPUT_EVENT.iter_unpack(data):
        if kind == EV_KEY and value in (0, 1) and code in (KEY_POWER, KEY_HOMEPAGE):
            edges.append(('power' if code == KEY_POWER else 'home', value == 1, sec + usec / 1e6))
    return edges


def cover_edges(data):
    """(closed, kernel seconds) of every Smart Cover switch change in evdev bytes."""
    return [(value == 1, sec + usec / 1e6) for sec, usec, kind, code, value in INPUT_EVENT.iter_unpack(data)
            if kind == EV_SW and code == SW_MACHINE_COVER and value in (0, 1)]


def reports_cover(capabilities_sw):
    """Whether an input device's sysfs capabilities/sw bitmap includes SW_MACHINE_COVER."""
    words = capabilities_sw.split()
    if not words:
        return False
    # Hex words, most significant first; the last word holds bits 0-63 (or 0-31).
    bits = int(words[-1], 16)
    return bool(bits >> SW_MACHINE_COVER & 1)


def reports_keys(capabilities_key):
    """Whether an input device's sysfs capabilities/key bitmap has KEY_POWER or KEY_HOMEPAGE."""
    words = capabilities_key.split()
    # Hex words of the kernel's long, most significant first.
    width = struct.calcsize('L') * 8
    bits = 0
    for word in words:
        bits = bits << width | int(word, 16)
    return bool(bits >> KEY_POWER & 1 or bits >> KEY_HOMEPAGE & 1)


def open_input(path):
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        fcntl.ioctl(fd, EVIOCSCLOCKID, struct.pack('i', time.CLOCK_MONOTONIC))
    except OSError:
        os.close(fd)
        raise
    return fd


def cover_is_closed(fd):
    bits = bytearray(SWITCH_BITMAP.size)
    fcntl.ioctl(fd, EVIOCGSW, bits)
    return bool(SWITCH_BITMAP.unpack(bits)[0] & (1 << SW_MACHINE_COVER))


class Cover:
    """The Smart Cover from its switches: closing locks, opening wakes.

    An iPad has two hall sensors, each its own input device. The cover is
    closed while any of them reports closed; the machine sees one 'lock'
    when it closes and one 'wake' when it opens again.
    """

    def __init__(self):
        self.closed = {}

    def change(self, source, closed):
        """The machine event of one switch report ('lock', 'wake'), or None."""
        before = any(self.closed.values())
        self.closed[source] = closed
        after = any(self.closed.values())
        if after == before:
            return None
        return 'lock' if after else 'wake'

    def forget(self, source):
        self.closed.pop(source, None)


class Buttons:
    """The machine's key events from Power and Home edges.

    Home and a Power press on a dark screen act at once, so a wake stays as
    fast as the press. On a lit screen Power darkens on release, and only
    after a short press alone. Home and Power pressed together on a lit
    screen take a screenshot when the first of them comes up, if that is
    soon: held (the DFU and restart combination), they do nothing, and a
    restart never releases them at all. Home let go after a press alone on a
    lit screen is 'home-up': the session's Home action (omarchy-home-button).
    It comes from the button itself, so no keyboard state, compositor
    binding or held modifier stands between the press and the action.
    """

    def __init__(self):
        self.held = None        # Power down on a lit screen since
        self.spoiled = False    # that Power press is not a press alone
        self.home_down = None   # Home down since
        self.combo = None       # both down on a lit screen since
        self.combo_spent = False
        self.home_in_combo = False  # the last Home press was part of a combination
        self.home_woke = False      # the last Home press came on a dark screen and woke it

    def _start_combo(self, when):
        self.spoiled = True
        self.combo, self.combo_spent, self.home_in_combo = when, False, True

    def _end_combo(self, when):
        if self.combo is None or self.combo_spent:
            return None
        self.combo_spent = True
        return 'screenshot' if when - self.combo < LONG_HOLD_SECONDS else None

    def _both_up(self):
        if self.held is None and self.home_down is None:
            self.combo = None

    def edge(self, name, down, when, lit):
        """The event of one edge (a machine event or 'screenshot'), or None."""
        if name == 'home':
            if down:
                self.home_down, self.home_in_combo, self.home_woke = when, False, not lit
                if self.held is not None:
                    self._start_combo(when)
                return 'home'
            pressed = self.home_down is not None
            self.home_down = None
            event = self._end_combo(when)
            self._both_up()
            if event is None and pressed and not self.home_in_combo and not self.home_woke:
                return 'home-up'
            return event
        if down:
            if not lit:
                self.held = None
                return 'power'
            self.held, self.spoiled = when, False
            if self.home_down is not None:
                self._start_combo(when)
            return None
        if self.held is None:
            return None
        event = self._end_combo(when)
        short = when - self.held < LONG_HOLD_SECONDS and not self.spoiled
        self.held = None
        self._both_up()
        if event or self.combo is not None or self.spoiled:
            return event
        return 'power' if short else None


def command(*argv, timeout=5, **options):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, **options)


def session_user():
    """The desktop user on seat0, or None for the greeter (nothing to lock) or no session."""
    session = command('loginctl', 'show-seat', 'seat0', '-p', 'ActiveSession', '--value').stdout.strip()
    if not session:
        return None
    fields = dict(line.split('=', 1) for line in
                  command('loginctl', 'show-session', session, '-p', 'Name', '-p', 'Class').stdout.splitlines()
                  if '=' in line)
    if fields.get('Class') != 'user' or not fields.get('Name'):
        return None
    return pwd.getpwnam(fields['Name'])


def user_env(user):
    return {'HOME': user.pw_dir, 'USER': user.pw_name, 'XDG_RUNTIME_DIR': f'/run/user/{user.pw_uid}',
            'OMARCHY_PATH': SHELL_ROOT, 'PATH': '/usr/local/bin:/usr/bin'}


def spawn_as_user(user, *argv, env=None):
    """Start ARGV as the user and return at once (as_user waits for it)."""
    return subprocess.Popen(('setpriv', f'--reuid={user.pw_uid}', f'--regid={user.pw_gid}', '--init-groups', '--',
                             *argv), env={**user_env(user), **(env or {})}, cwd='/',
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True)


def as_user(user, *argv, timeout=5):
    env = user_env(user)
    # setpriv looks the groups up in the child. In here, os.getgrouplist holds
    # Python's interpreter lock through NSS, and nss-systemd (group merges
    # with it) answers only once systemd has finished a sleep: the whole
    # daemon, the wake's backlight fade included, stood still up to a second.
    return command('setpriv', f'--reuid={user.pw_uid}', f'--regid={user.pw_gid}', '--init-groups', '--',
                   *argv, timeout=timeout, env=env, cwd='/')


class Daemon:
    def __init__(self):
        self.machine = Machine()
        self.cover = Cover()
        self.covers = {}
        self.cover_dropped = set()
        self.events = queue.Queue()
        self.wake_read, self.wake_write = os.pipe()
        os.set_blocking(self.wake_read, False)
        self.keys = {}
        self.next_scan = 0.0
        self.settle_at = None
        self.grace_at = None
        self.fade = None
        self.saved = None
        self.counters = None
        self.sleep_started = None
        self.buttons = Buttons()
        self.sleep_record = 0       # which sleep the unit watcher's end belongs to
        self.sleep_begun = False    # logind or the kernel is on it: only its end ends it
        self.kernel_attempted = False
        self.awake = 0.0            # seconds this loop ran since the sleep was asked for (or began)
        self.last_turn = time.monotonic()
        self.logind_asleep = False  # PrepareForSleep(true) seen, (false) not yet
        self.logind_busy_until = float('inf')
        self.monitor_buffer = b''
        self.cancel = threading.Event()
        self.dim_saved = None
        self.dim_level = None
        self.dark = threading.Event()
        self.session_jobs = queue.Queue()
        self.inhibitor = None
        self.monitor = None
        self.key_time = None
        self.stopping = False
        self.want_inhibitor = False
        self.next_inhibitor = 0.0
        self.lit_at = None
        self.watching_unit = False
        self.supplies = {}
        self.uevents = None

    # --- plumbing -----------------------------------------------------------
    def post(self, event):
        self.events.put(event)
        os.write(self.wake_write, b'.')

    def backlight(self):
        panels = sorted(BACKLIGHTS.iterdir())
        return panels[0] if len(panels) == 1 else None

    def start_uevents(self):
        """Being plugged in lights the screen, as on any tablet; being unplugged does not."""
        for supply in Path('/sys/class/power_supply').glob('*'):
            try:
                self.supplies[supply.name] = (supply / 'online').read_text().strip() == '1'
            except OSError:
                pass  # a battery has no online state
        try:
            self.uevents = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM | socket.SOCK_NONBLOCK, 15)
            self.uevents.bind((0, 1))
        except (AttributeError, OSError) as error:  # AttributeError: no netlink on this system
            log(f'no power supply events: {error}')
            self.uevents = None

    def read_uevents(self):
        try:
            while True:
                report = parse_supply_uevent(self.uevents.recv(8192))
                if report and plugged_in(self.supplies, *report):
                    self.feed('wake')
        except BlockingIOError:
            pass
        except OSError as error:  # the kernel dropped some: the next report sets it right
            log(f'power supply events: {error}')

    def scan_keys(self):
        for device in Path('/sys/class/input').glob('event*'):
            path = f'/dev/input/{device.name}'
            if path in self.covers.values() or path in self.keys.values():
                continue
            try:
                sw = (device / 'device/capabilities/sw').read_text()
                key = (device / 'device/capabilities/key').read_text()
            except OSError:
                continue
            if reports_cover(sw):
                fd = None
                try:
                    fd = open_input(path)
                    closed = cover_is_closed(fd)
                except OSError as error:
                    if fd is not None:
                        os.close(fd)
                    log(f'cannot read {path}: {error}')
                    continue
                self.covers[fd] = path
                log(f'cover: {path}')
                event = self.cover.change(fd, closed)
                if event:
                    self.feed(event)
                continue
            # The iPad's buttons are gpio-keys; a keyboard's Power or Home key, or
            # the simulator's buttons on QEMU's virtual keyboard, count the same.
            if not reports_keys(key):
                continue
            try:
                fd = open_input(path)
            except OSError as error:
                log(f'cannot read {path}: {error}')
                continue
            self.keys[fd] = path
            log(f'keys: {path}')

    def read_cover(self, fd):
        data = os.read(fd, INPUT_EVENT.size * 64)
        if not data:
            raise OSError('end of cover input')

        # After an overrun, wait for the first complete packet. EVIOCGSW
        # samples current state and flushes queued switch events. Discard
        # this batch as well since the snapshot already accounts for it.
        dropped = fd in self.cover_dropped
        resync = dropped
        for _, _, kind, code, _ in INPUT_EVENT.iter_unpack(data):
            if kind == EV_SYN and code == SYN_DROPPED:
                dropped = resync = True
            elif kind == EV_SYN and code == SYN_REPORT:
                dropped = False
        if dropped:
            self.cover_dropped.add(fd)
            return
        self.cover_dropped.discard(fd)
        edges = ([(cover_is_closed(fd), time.monotonic())]
                 if resync else cover_edges(data))
        for closed, when in edges:
            event = self.cover.change(fd, closed)
            if event:
                log(f't={when:.6f} cover {"closed" if closed else "opened"}')
                self.feed(event, when)

    def logind_busy(self):
        """logind is still in its sleep: it refuses delay inhibitors ("already running")."""
        return self.logind_asleep and time.monotonic() < self.logind_busy_until

    def take_inhibitor(self):
        """Not while logind is still in a sleep: keep_inhibitor() takes it once it is over, or again if refused."""
        self.want_inhibitor = True
        if self.logind_busy():
            return
        if self.inhibitor is None or self.inhibitor.poll() is not None:
            self.inhibitor = subprocess.Popen(['systemd-inhibit', '--what=sleep', '--mode=delay',
                                               '--who=omarchy-powerd', '--why=Lock and darken first',
                                               'sleep', 'infinity'])

    def keep_inhibitor(self):
        # Not during a sleep: after it ended, then slowly if logind still refused.
        if (self.want_inhibitor and not self.machine.inflight and not self.logind_busy()
                and (self.inhibitor is None or self.inhibitor.poll() is not None)
                and time.monotonic() >= self.next_inhibitor):
            self.next_inhibitor = time.monotonic() + 2
            self.take_inhibitor()

    def release_inhibitor(self):
        self.want_inhibitor = False
        if self.inhibitor is not None:
            self.inhibitor.terminate()
            self.inhibitor.wait()
            self.inhibitor = None

    def renew_inhibitor(self):
        """A logind that started again owes us nothing: ask the new one."""
        if self.want_inhibitor:
            self.release_inhibitor()
            self.take_inhibitor()

    def start_monitor(self):
        # Unbuffered bytes: read_monitor() takes every line a read brings. A buffered
        # readline() left the later lines of a read behind, unseen by select().
        self.monitor_buffer = b''
        self.monitor = subprocess.Popen(
            ['busctl', '--json=short', 'monitor', LOGIND,
             "--match=type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'",
             f"--match=type='signal',sender='org.freedesktop.DBus',member='NameOwnerChanged',arg0='{LOGIND}'"],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)

    def read_monitor(self):
        chunk = os.read(self.monitor.stdout.fileno(), 65536)
        if not chunk:
            self.monitor.wait()
            self.start_monitor()
            return
        *lines, self.monitor_buffer = (self.monitor_buffer + chunk).split(b'\n')
        for line in lines:
            self.monitor_line(line.decode(errors='replace'))

    def monitor_line(self, line):
        if parse_logind_started(line):
            log('logind started')
            self.logind_asleep = False  # a new logind is in no sleep
            self.renew_inhibitor()
            return
        sleeping = parse_sleep_signal(line)
        if sleeping is None:
            return
        self.logind_asleep, self.logind_busy_until = sleeping, float('inf')
        if sleeping and self.machine.inflight:
            self.sleep_began('logind')  # ours: logind is on it
        elif sleeping:
            # Someone else's suspend: a press must end it just the same.
            self.lit_at = None
            self.begin_sleep_record()
            self.arm_wakeup()
            self.feed('sleep-signal')
            self.sleep_began('logind')
        else:
            self.sleep_finished('logind')

    def sleep_counters(self):
        return tuple(int((STATS / name).read_text()) for name in ('success', 'fail'))

    # --- the machine --------------------------------------------------------
    def feed(self, event, when=None):
        before = self.machine.state
        when = time.monotonic() if when is None else when
        self.key_time = when
        actions = self.machine.handle(event)
        # A lock-screen swipe sends many a wake; keys are always logged, consumed ones too.
        if actions or before != self.machine.state or event != 'wake':
            log(f't={when:.6f} {event}: {before} -> {self.machine.state} {" ".join(actions) or "-"}')
        for action in actions:
            getattr(self, 'do_' + action.replace('-', '_'))(before)
        self.dark.set() if self.machine.state in (SETTLING, DARK) else self.dark.clear()

    def undim(self):
        panel = self.backlight()
        if self.dim_saved is not None and panel:
            current = int((panel / 'brightness').read_text())
            if self.machine.state == ON:
                (panel / 'brightness').write_text(f'{self.dim_saved}\n')
        self.dim_saved = self.dim_level = None

    def do_dark(self, _):
        panel = self.backlight()
        if panel:
            current = int((panel / 'brightness').read_text())
            if current > 0 and self.fade is None:
                self.saved = self.dim_saved or current
                self.remember_brightness(self.saved)
            self.dim_saved = self.dim_level = None
            self.start_fade(panel, 0)

    def start_fade(self, panel, target):
        current = int((panel / 'brightness').read_text())
        if FADE_SECONDS <= 0 or current == target:
            self.fade = None
            (panel / 'brightness').write_text(f'{target}\n')
            return
        # (panel, from, to, began, last write): the first frame is written at once.
        self.fade = (panel, current, target, time.monotonic(), float('-inf'))

    def next_frame(self):
        """Seconds until the fade's next write is due (0 without a fade written yet)."""
        return max(0.0, self.fade[4] + FRAME_SECONDS - time.monotonic())

    def tick_fade(self):
        if self.fade is None:
            return
        panel, start, target, began, written = self.fade
        now = time.monotonic()
        t = min(1.0, max(0.0, (now - began) / FADE_SECONDS))
        # One write a frame: each write's uevent wakes this loop, which must not write again at once.
        if t < 1.0 and now - written < FRAME_SECONDS:
            return
        eased = t * t * (3.0 - 2.0 * t)
        (panel / 'brightness').write_text(f'{round(start + (target - start) * eased)}\n')
        self.fade = None if t >= 1.0 else (panel, start, target, began, now)

    def finish_dark_fade(self):
        # A suspend must never freeze halfway through a visual transition.
        if self.fade is not None and self.fade[2] == 0:
            (self.fade[0] / 'brightness').write_text('0\n')
            self.fade = None

    def remember_brightness(self, level):
        """The last lit level, for the next boot; a hard reset keeps it too."""
        try:
            BRIGHTNESS.parent.mkdir(parents=True, exist_ok=True)
            temporary = BRIGHTNESS.with_suffix('.new')
            temporary.write_text(f'{level}\n')
            os.replace(temporary, BRIGHTNESS)
        except OSError as error:
            log(f'brightness not remembered: {error}')

    def restore_brightness(self):
        """First start of a boot: the remembered level, never too dim to see; full on the first boot."""
        panel = self.backlight()
        if not panel:
            return
        maximum = int((panel / 'max_brightness').read_text())
        try:
            level = max(int(BRIGHTNESS.read_text()), max(1, maximum // 20))
        except (OSError, ValueError):
            level = maximum
        self.saved = min(level, maximum)
        (panel / 'brightness').write_text(f'{self.saved}\n')

    def stop_brightness(self, *_):
        """Shutdown: a level changed since the last dark, unless the panel is dark now."""
        panel = self.backlight()
        if panel:
            current = int((panel / 'brightness').read_text())
            if self.fade is not None and self.saved:
                self.remember_brightness(self.saved)
            elif current > 0:
                self.remember_brightness(current)
        raise SystemExit(0)

    def do_light(self, origin):
        panel = self.backlight()
        if panel:
            maximum = int((panel / 'max_brightness').read_text())
            self.start_fade(panel, min(self.saved or max(1, maximum // 2), maximum))
        lit = self.lit_at = time.monotonic()
        came_from = 'ASLEEP-or-entering' if origin == SUSPENDING else origin
        log(f'wake from={came_from} press={self.key_time:.6f} lit={lit:.6f} '
            f'press_to_lit_ms={(lit - self.key_time) * 1000:.1f}')

    def do_lock(self, _):
        self.session_jobs.put('lock')

    def do_woke(self, _):
        self.session_jobs.put('woke')

    def do_notify(self, _):
        self.session_jobs.put('notify')

    def do_arm_grace(self, _):
        self.grace_at = time.monotonic() + IDLE_GRACE_SECONDS

    def do_cancel_grace(self, _):
        self.grace_at = None

    def do_arm_settle(self, _):
        self.settle_at = time.monotonic() + SETTLE_SECONDS

    def do_arm_backoff(self, _):
        log(f'{ABORTS_BEFORE_DARK} sleeps in a row aborted: asking again in {BACKOFF_SECONDS:.0f} s')
        self.settle_at = time.monotonic() + BACKOFF_SECONDS

    def do_cancel_settle(self, _):
        self.settle_at = None

    def do_arm_retry(self, _):
        self.settle_at = time.monotonic() + RETRY_SECONDS

    def do_take_inhibitor(self, _):
        self.take_inhibitor()

    def do_release_inhibitor(self, _):
        self.finish_dark_fade()
        self.release_inhibitor()

    def do_cancel_suspend(self, _):
        self.cancel.set()

    def arm_wakeup(self):
        """From here on the kernel aborts or ends the sleep for any key press."""
        try:
            WAKEUP_COUNT.write_text(WAKEUP_COUNT.read_text().strip() + '\n')
            return True
        except OSError as error:
            log(f'wakeup_count: {error}')
            return False

    def begin_sleep_record(self):
        self.sleep_record += 1
        self.sleep_begun = self.kernel_attempted = False
        self.awake = 0.0
        self.sleep_started = time.clock_gettime(SLEEP_CLOCK)
        self.counters = self.seen_counters = self.sleep_counters()
        self.watching_unit = False

    def sleep_began(self, how):
        """logind announced it, or the kernel attempted it: from now on only its end ends it."""
        if not self.sleep_begun:
            self.sleep_begun, self.awake = True, 0.0
            log(f'sleep began: {how}')
        if not self.watching_unit:
            self.watching_unit = True
            threading.Thread(target=self.wait_for_unit, args=(self.sleep_record,), daemon=True).start()

    def do_suspend(self, _):
        self.finish_dark_fade()
        self.settle_at = None
        self.lit_at = None
        self.cancel.clear()
        self.begin_sleep_record()
        self.release_inhibitor()
        if not self.arm_wakeup():
            self.post('suspend-busy')
            return
        threading.Thread(target=self.request_suspend, daemon=True).start()

    # --- workers: never in the event loop -----------------------------------
    def block_inhibited(self):
        result = command('busctl', 'get-property', 'org.freedesktop.login1', '/org/freedesktop/login1',
                         'org.freedesktop.login1.Manager', 'BlockInhibited')
        return 'sleep' in result.stdout

    def request_suspend(self):
        try:
            answer = command('busctl', 'call', 'org.freedesktop.login1', '/org/freedesktop/login1',
                             'org.freedesktop.login1.Manager', 'CanSuspend').stdout.strip()
            if answer in ('s "na"', 's "no"'):
                log(f'no suspend on this board: CanSuspend {answer}')
                self.post('suspend-unavailable')
            elif answer != 's "yes"':
                log(f'suspend refused for now: CanSuspend {answer}')
                self.post('suspend-refused')
            elif self.block_inhibited():
                self.post('suspend-blocked')
            elif self.cancel.is_set():
                self.post('timeout')  # pressed before it was asked for: nothing will end it
            elif command('systemctl', 'suspend', timeout=10).returncode:
                log('systemctl suspend failed')
                self.post('suspend-busy')
        except (OSError, subprocess.SubprocessError) as error:
            log(f'suspend request: {error}')
            self.post('suspend-busy')

    def session_worker(self):
        while True:
            job = self.session_jobs.get()
            try:
                user = session_user()
                if job == 'lock':
                    if user is not None:
                        # The on-screen keyboard must not stay up over the lock screen.
                        as_user(user, 'omarchy-keyboard', 'hide')
                    locked = user is None or self.lock_session(user)
                    if locked:
                        usb_new_devices(False)
                    self.post('lock-ok' if locked else 'lock-failed')
                elif user is not None and job == 'woke':
                    as_user(user, 'omarchy-shell', '-q', 'lock', 'woke')
                elif user is not None and job == 'screenshot':
                    # Omarchy's capture service; it flashes the screen once the shot is taken.
                    as_user(user, 'omarchy-capture-screenshot', 'fullscreen', timeout=15)
                elif user is not None and job == 'notify':
                    as_user(user, 'notify-send', 'Unable to lock', 'The screen stays on.')
            except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
                log(f'session {job}: {error}')
                if job == 'lock':
                    self.post('lock-failed')

    def home_action(self, when):
        """Home let go after a press alone: the session's Home, at once.

        Started, not waited for: the script tells one press from two by
        when each starts. Only on a lit screen (a wake's press was handled
        above); the script itself leaves a locked session alone.
        """
        if self.machine.state != ON:
            log(f't={when:.6f} home-up: {self.machine.state}, nothing')
            return
        try:
            user = session_user()
            if user is None:
                return
            labwc = command('pgrep', '-u', str(user.pw_uid), '-x', 'labwc').stdout.split()
            spawn_as_user(user, 'omarchy-home-button', env={'LABWC_PID': labwc[0]} if labwc else None)
            log(f't={when:.6f} home-up: omarchy-home-button')
        except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
            log(f'home: {error}')

    def lock_session(self, user):
        if as_user(user, 'omarchy-shell', 'lock', 'lock').stdout.strip() != 'ok':
            return False
        deadline = time.monotonic() + 8
        while time.monotonic() < deadline:
            if json.loads(as_user(user, 'omarchy-shell', 'lock', 'status').stdout or '{}').get('secure'):
                return True
            time.sleep(0.1)
        return False

    def playback_worker(self):
        while not self.stopping:
            self.dark.wait(1)
            if not self.dark.is_set():
                continue
            try:
                user = session_user()
                playing = self.block_inhibited() or (
                    user is not None and streams_running(as_user(user, 'pw-dump', timeout=2).stdout))
            except (OSError, KeyError, ValueError, subprocess.SubprocessError) as error:
                # No answer is not "nothing is playing".
                log(f'playback check: {error}')
                time.sleep(1)
                continue
            if playing != self.machine.playing:
                self.post('playing' if playing else 'not-playing')
            time.sleep(1)

    # --- control socket -----------------------------------------------------
    def control(self, server):
        connection, _ = server.accept()
        with connection:
            connection.settimeout(0.2)
            try:
                request = connection.recv(64).decode().strip()
                if request == 'input':
                    if self.machine.state == GRACE:
                        self.feed('wake')
                    connection.sendall(b'lit\n' if self.machine.state == ON else b'dark\n')
                elif request == 'unlocked':
                    # The lock screen let the user in: new USB devices work again.
                    usb_new_devices(True)
                    connection.sendall(b'ok\n')
                elif request == 'status':
                    connection.sendall(self.machine.state.encode() + b'\n')
                elif request.startswith('brightness '):
                    parts = request.split()
                    panel = self.backlight()
                    reply = b'held\n'
                    if (len(parts) == 4 and panel and parts[1] == panel.name and
                            parts[2].isascii() and parts[2].isdigit() and
                            parts[3].isascii() and parts[3].isdigit()):
                        level, expected = int(parts[2]), int(parts[3])
                        current = int((panel / 'brightness').read_text())
                        maximum = int((panel / 'max_brightness').read_text())
                        if self.machine.state == ON and self.fade is None and self.dim_saved is None and current > 0 and current == expected and 1 <= level <= maximum:
                            (panel / 'brightness').write_text(f'{level}\n')
                            reply = b'ok\n'
                    connection.sendall(reply)
                elif request == 'als-state':
                    connection.sendall(b'lit\n' if self.machine.state == ON and self.fade is None and self.dim_saved is None else b'dark\n')
                elif request == 'dim':
                    panel = self.backlight()
                    if self.machine.state == ON and self.dim_saved is None and panel:
                        # Half the panel's range, never brighter than it is.
                        current = int((panel / 'brightness').read_text())
                        level = max(1, int((panel / 'max_brightness').read_text()) // 2)
                        if current > level:
                            self.dim_saved, self.dim_level = current, level
                            (panel / 'brightness').write_text(f'{level}\n')
                    connection.sendall(b'ok\n')
                elif request == 'undim':
                    self.undim()
                    connection.sendall(b'ok\n')
                elif request in ('idle', 'wake', 'lock'):
                    self.feed(request)
                    connection.sendall(b'ok\n')
                else:
                    connection.sendall(b'unknown\n')
            except (OSError, UnicodeDecodeError) as error:
                log(f'control: {error}')

    def open_socket(self):
        Path(SOCKET).unlink(missing_ok=True)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(SOCKET)
        os.chown(SOCKET, 0, grp.getgrnam('video').gr_gid)  # the tablet user's session
        os.chmod(SOCKET, 0o660)
        server.listen(8)
        return server

    # --- event loop ---------------------------------------------------------
    def timeout(self):
        now = time.monotonic()
        if now >= self.next_scan:
            self.scan_keys()
            self.next_scan = now + 5
        delay = TICK_SECONDS if self.machine.inflight else 1.0
        if self.fade is not None:
            delay = min(delay, self.next_frame())
        for deadline in (self.settle_at, self.grace_at):
            if deadline is not None:
                delay = min(delay, max(0.0, deadline - now))
        return delay

    def watch_kernel(self):
        """A kernel attempt ending is not the sleep ending: systemd-sleep may try again."""
        if not self.machine.inflight:
            return
        now = self.sleep_counters()
        if now == self.seen_counters:
            return
        if now[1] != self.seen_counters[1]:
            last = {}
            for name in ('last_failed_dev', 'last_failed_errno', 'last_failed_step'):
                try:
                    last[name] = (STATS / name).read_text().strip()
                except OSError:
                    last[name] = '?'
            log(f'kernel attempt failed: suspend_stats {now} device {last["last_failed_dev"] or "-"} '
                f'errno {last["last_failed_errno"]} step {last["last_failed_step"]}')
            self.arm_wakeup()  # the failed attempt used it up
        self.seen_counters = now
        self.kernel_attempted = True
        self.sleep_began('kernel')

    def wait_for_unit(self, record):
        """Posts the end of systemd-suspend for this sleep: once seen running, or the kernel attempted it.

        Started when logind announces the sleep, systemd-suspend may not have started yet:
        its inactive state then is not its end.
        """
        running = False
        while not self.stopping and self.machine.inflight and self.sleep_record == record:
            try:
                state = command('systemctl', 'show', '-p', 'ActiveState', '--value',
                                'systemd-suspend.service').stdout.strip()
                if state in ('inactive', 'failed') and (running or self.kernel_attempted):
                    self.post(f'sleep-over {record}')
                    return
                running = running or state in ('activating', 'active', 'deactivating')
            except (OSError, subprocess.SubprocessError) as error:
                log(f'watching systemd-suspend: {error}')
            time.sleep(0.1)

    def sleep_finished(self, how):
        """systemd-suspend finished, or logind says so: every attempt of this sleep is over.

        The verdict is the kernel's: suspend_stats now against before the sleep was asked for.
        """
        if not self.machine.inflight:
            return
        now = self.sleep_counters()
        result = 'slept' if now[0] != self.counters[0] else 'aborted' if now != self.counters else 'not-entered'
        try:
            irq = Path('/sys/power/pm_wakeup_irq').read_text().strip()
        except OSError:
            irq = 'none'
        log(f'sleep-ended result={result} seconds={time.clock_gettime(SLEEP_CLOCK) - self.sleep_started:.3f} '
            f'wakeup_irq={irq} end={how} awake={self.awake:.1f}')
        if how != 'logind' and self.logind_asleep:
            # logind's own end not seen (yet): its inhibitor waits for it, a while.
            self.logind_busy_until = time.monotonic() + LOGIND_END_WAIT_SECONDS
        self.feed('sleep-aborted' if result == 'aborted' else 'sleep-ended')

    def count_awake(self, now):
        """Adds the time the loop ran since its last turn; the safeties of a suspend in flight."""
        step, self.last_turn = now - self.last_turn, now
        if not self.machine.inflight:
            return
        self.awake += min(max(step, 0.0), AWAKE_STEP_MAX)
        if not self.sleep_begun and self.awake > SUSPEND_AWAKE_SECONDS:
            log(f'suspend did not happen: not begun in {self.awake:.1f} s awake')
            self.feed('timeout')
        elif self.sleep_begun and self.awake > SLEEP_END_AWAKE_SECONDS:
            log(f'no end of the sleep seen in {self.awake:.1f} s awake')
            self.sleep_finished('none')

    def run(self):
        if not os.path.exists(SOCKET):  # /run: gone only at boot, kept by a restart
            self.restore_brightness()
        panel = self.backlight()
        if panel and int((panel / 'brightness').read_text()) == 0:
            # State ON after a restart: never dark without an owner.
            self.key_time = time.monotonic()
            self.do_light(ON)
        server = self.open_socket()
        self.take_inhibitor()
        self.start_monitor()
        self.start_uevents()
        for worker in (self.session_worker, self.playback_worker):
            threading.Thread(target=worker, daemon=True).start()
        log('ready: ON')
        while not self.stopping:
            delay = self.timeout()
            watched = [*self.keys, *self.covers, server, self.wake_read, self.monitor.stdout]
            if self.uevents:
                watched.append(self.uevents)
            readable, _, _ = select.select(watched, [], [], delay)
            # Keys first: a press that woke the tablet decides before the sleep's end is seen.
            for fd in [fd for fd in readable if fd in self.keys]:
                try:
                    for key, down, when in key_edges(os.read(fd, INPUT_EVENT.size * 64)):
                        name = self.buttons.edge(key, down, when, self.machine.state == ON)
                        if name is None:
                            continue
                        if name == 'screenshot':
                            log(f't={when:.6f} screenshot')
                            self.session_jobs.put('screenshot')
                            continue
                        if name == 'home-up':
                            self.home_action(when)
                            continue
                        # Pressed before this wake's panel lit: that wake took care of it.
                        if self.machine.inflight and self.lit_at is not None and when <= self.lit_at:
                            log(f't={when:.6f} {name}: consumed by the wake')
                        else:
                            self.feed(name, when)
                except OSError as error:
                    log(f'keys lost: {error}')
                    os.close(fd)
                    del self.keys[fd]
            for fd in [fd for fd in readable if fd in self.covers]:
                try:
                    self.read_cover(fd)
                except BlockingIOError:
                    continue
                except OSError as error:
                    log(f'cover lost: {error}')
                    os.close(fd)
                    del self.covers[fd]
                    self.cover_dropped.discard(fd)
                    self.cover.forget(fd)
            if self.wake_read in readable:
                os.read(self.wake_read, 512)
                while not self.events.empty():
                    event = self.events.get()
                    if event.startswith('sleep-over '):
                        if int(event.split()[1]) == self.sleep_record:
                            self.sleep_finished('unit')
                    else:
                        self.feed(event)
            if self.monitor.stdout in readable:
                self.read_monitor()
            if server in readable:
                self.control(server)
            if self.uevents in readable:
                self.read_uevents()
            self.tick_fade()
            self.watch_kernel()
            self.keep_inhibitor()
            if self.grace_at is not None and time.monotonic() >= self.grace_at:
                self.grace_at = None
                self.feed('grace-ended')
            if self.settle_at is not None and time.monotonic() >= self.settle_at:
                self.settle_at = None
                self.feed('settle')
            self.count_awake(time.monotonic())


if __name__ == '__main__':
    try:
        daemon = Daemon()
        signal.signal(signal.SIGTERM, daemon.stop_brightness)
        daemon.run()
    except KeyboardInterrupt:
        sys.exit(0)
