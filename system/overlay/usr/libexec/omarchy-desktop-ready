#!/usr/bin/python3
"""Called by the greeter's and the tablet session's shells once they are up: record readiness.

The greeter's record (/run/omarchy-greeter/ready.json) is what the installer
waits for: the PIN screen is on. The tablet session keeps its own record in
its runtime directory.
"""
import json
import os
from pathlib import Path
import pwd

user = pwd.getpwuid(os.getuid()).pw_name
if user == 'greeter':
    target = Path('/run/omarchy-greeter')
elif user == 'tablet':
    target = Path(os.environ['XDG_RUNTIME_DIR'])
else:
    raise SystemExit('Readiness comes from the greeter or the tablet session')
socket = Path(os.environ['XDG_RUNTIME_DIR']) / os.environ['WAYLAND_DISPLAY']
if not socket.is_socket() or target.stat().st_uid != os.getuid():
    raise SystemExit('No owned Wayland session')
record = {'boot_id': Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
          'shell_pid': os.getppid(), 'wayland_socket': str(socket)}
name = 'ready.json' if user == 'greeter' else 'omarchy-desktop-ready.json'
temporary = target / (name + '.pending')
temporary.write_text(json.dumps(record))
temporary.chmod(0o644)
os.replace(temporary, target / name)
