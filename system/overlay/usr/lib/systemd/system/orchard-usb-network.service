[Unit]
Description=USB network for the host computer (172.16.42.1, DHCP hands out .2)
# orchard's USB gadget provides usb0; after the installer's handover the
# recovery has already configured it.
BindsTo=sys-subsystem-net-devices-usb0.device
After=sys-subsystem-net-devices-usb0.device

[Service]
ExecStartPre=/usr/libexec/orchard-usb-network
ExecStart=/usr/lib/orchard/busybox udhcpd -f /etc/orchard/udhcpd.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
