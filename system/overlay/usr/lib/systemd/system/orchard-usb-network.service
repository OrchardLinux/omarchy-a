[Unit]
Description=USB network for the computer: 172.16.42.1 here, DHCP hands out .2
BindsTo=sys-subsystem-net-devices-usb0.device
After=sys-subsystem-net-devices-usb0.device

[Service]
ExecStartPre=/usr/libexec/orchard-usb-network
ExecStart=/usr/lib/orchard/busybox udhcpd -f /etc/orchard/udhcpd.conf
Restart=on-failure

[Install]
# usb0 also comes back without a boot: a host's USB reset, the gadget rebound
WantedBy=multi-user.target sys-subsystem-net-devices-usb0.device
