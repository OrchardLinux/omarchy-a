[Unit]
Description=Verify Orchard warm boot storage now and across the NVMe late window
After=local-fs.target orchard-kexec-provenance.service
ConditionPathExists=/dev/nvme0n1

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/lib/orchard-kexec/health.py --quick
ExecStart=/usr/bin/python3 -I /usr/lib/orchard-kexec/health.py --min-uptime 120 --min-observe 60
TimeoutStartSec=700

[Install]
WantedBy=multi-user.target
