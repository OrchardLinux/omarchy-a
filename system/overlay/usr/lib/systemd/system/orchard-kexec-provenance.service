[Unit]
Description=Retain the running Orchard pristine device tree
After=local-fs.target
Before=orchard-kexec-load.service orchard-kexec-health.service systemd-user-sessions.service
ConditionPathExists=/run/orchard-kexec/pristine.dtb

[Service]
Type=oneshot
ExecStart=/usr/bin/orchard-kexec snapshot
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
