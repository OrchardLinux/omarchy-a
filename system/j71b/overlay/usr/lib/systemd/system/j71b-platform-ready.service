[Unit]
Description=Verify J71b hardware payload and boot activation
After=systemd-udev-trigger.service
Before=j71b-charge.service getty@tty1.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/rm -f /run/ipadlinux/platform-verified
ExecStart=/usr/libexec/j71b-check-platform
ExecStartPost=/usr/bin/touch /run/ipadlinux/platform-verified
RemainAfterExit=yes
