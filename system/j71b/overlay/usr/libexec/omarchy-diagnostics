#!/bin/sh
# Key-only USB diagnostics, using only this boot's explicitly provisioned key.
set -eu
[ ! -e /run/orchard/ssh-revoking.json ] && [ ! -e /run/orchard/ssh-revoked.json ]
[ -s /run/recovery/authorized_keys ] && [ ! -L /run/recovery/authorized_keys ]
[ -s /run/recovery/ssh_host_ed25519_key ]
install -d -m700 /root/.ssh
[ ! -L /root/.ssh/authorized_keys ]
touch /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
if ! [ /run/recovery/authorized_keys -ef /root/.ssh/authorized_keys ]; then
    mount --bind /run/recovery/authorized_keys /root/.ssh/authorized_keys
fi
exec /usr/libexec/omarchy-dropbear -F -E -s -g -j -k -P /run/recovery/dropbear.pid \
 -r /run/recovery/ssh_host_ed25519_key -p 172.16.42.1:22
