#!/usr/bin/env bash
set -euo pipefail
umask 077

here=$(cd "$(dirname "$0")" && pwd)
project=$(cd "$here/.." && pwd)
output='' desktop='' release='' architecture=aarch64 builder_image=''
while (($#)); do
  case "$1" in
    --output) output=$2; shift 2;;
    --desktop) desktop=$2; shift 2;;
    --release) release=$2; shift 2;;
    --architecture) architecture=$2; shift 2;;
    --builder-image) builder_image=$2; shift 2;;
    *) echo "Unknown argument: $1" >&2; exit 2;;
  esac
done
if [[ -z "$output" || -z "$release" || ! -d "$desktop/payload" ||
      ! -d "$desktop/packages" || -e "$output" ]]; then
  echo 'Usage: ./system/build-rootfs --output DIRECTORY --desktop DIRECTORY --release NAME [--architecture aarch64|armv7h] [--builder-image IMAGE]' >&2
  exit 2
fi
case "$architecture" in
  aarch64) expected_machine=aarch64; container_args=(--arch arm64);;
  armv7h) expected_machine=armv7l; container_args=(--platform linux/arm/v7);;
  *) echo "Unsupported userspace architecture: $architecture" >&2; exit 2;;
esac
podman=$(command -v podman || true)
if [[ ${ORCHARD_BUILD_NATIVE:-0} != 1 ]]; then
  [[ -n "$podman" ]] || { echo 'Podman is required' >&2; exit 1; }
  "$podman" info >/dev/null || { echo 'Podman is unavailable' >&2; exit 1; }
else
  [[ $EUID == 0 && $(uname -m) == "$expected_machine" ]] || { echo "Native rootfs assembly requires Linux $expected_machine as root" >&2; exit 1; }
fi
absolute() { python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).expanduser().resolve())' "$1"; }
output=$(absolute "$output")
desktop=$(absolute "$desktop")
"$project/desktop/build" --verify "$desktop" --architecture "$architecture"

mkdir -p "$here/.work/rootfs"
stage=$(mktemp -d "$here/.work/rootfs/result.XXXXXX")
volume=
native_work=
cleanup() {
  [[ -z "$native_work" ]] || rm -rf -- "$native_work"
  if [[ -n "$volume" ]]; then
    "$podman" volume rm "$volume" >/dev/null || echo "Remove temporary Podman volume: $volume" >&2
  fi
  [[ ! -d "$stage" ]] || rm -rf -- "$stage"
}
trap cleanup EXIT
if [[ ${ORCHARD_BUILD_NATIVE:-0} == 1 ]]; then
  native_work=$(mktemp -d "$here/.work/rootfs/native.XXXXXX")
  "$here/assemble-rootfs" --root "$native_work/root" \
    --output "$native_work/rootfs.tar.gz" --desktop "$desktop" --release "$release" --architecture "$architecture"
  cp "$native_work/rootfs.tar.gz" "$native_work/rootfs.tar.gz.json" "$native_work/packages.lock" "$stage/"
else
  if [[ -z "$builder_image" ]]; then
    [[ "$architecture" == aarch64 ]] || { echo 'ARMv7 builds require --builder-image with an ARMv7 Arch Linux ARM environment, or ORCHARD_BUILD_NATIVE=1 on ARMv7' >&2; exit 1; }
    builder_image=localhost/omarchy-a-arch-builder:latest
    "$podman" build -f "$here/Containerfile" -t "$builder_image" "$here"
  fi
  volume_name="omarchy-a-rootfs-${stage##*/}-$$"
  "$podman" volume create "$volume_name" >/dev/null
  volume=$volume_name
  "$podman" run --rm "${container_args[@]}" \
    -v "$volume:/work:rw" \
    -v "$project:/repo:ro" -v "$desktop:/inputs/desktop:ro" \
    "$builder_image" \
    /repo/system/assemble-rootfs \
      --root /work/root --output /work/rootfs.tar.gz \
      --desktop /inputs/desktop --release "$release" --architecture "$architecture"
  # Drain the export through EOF, including tar's trailing zero padding.
  "$podman" run --rm "${container_args[@]}" --network none -v "$volume:/work:ro" \
    "$builder_image" \
    tar -C /work -cf - rootfs.tar.gz rootfs.tar.gz.json packages.lock \
    | tar -C "$stage" --ignore-zeros -xf -
fi
python3 - "$stage" "$architecture" <<'PY'
import hashlib, json, pathlib, sys
root = pathlib.Path(sys.argv[1])
archive = root / 'rootfs.tar.gz'
receipt = json.loads((root / 'rootfs.tar.gz.json').read_text())
assert receipt['architecture'] == sys.argv[2]
digest = hashlib.sha256()
with archive.open('rb') as stream:
    for block in iter(lambda: stream.read(1024 * 1024), b''):
        digest.update(block)
assert archive.stat().st_size == receipt['bytes']
assert digest.hexdigest() == receipt['sha256']
lock = root / 'packages.lock'
assert lock.stat().st_size > 0
assert hashlib.sha256(lock.read_bytes()).hexdigest() == receipt['packages_lock_sha256']
print('Verified rootfs:', archive)
PY
[[ ! -e "$output" ]] || { echo "Output exists: $output" >&2; exit 1; }
mkdir -p "$(dirname "$output")"
mv "$stage" "$output"
echo "Rootfs output: $output"
