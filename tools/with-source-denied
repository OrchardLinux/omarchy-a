#!/usr/bin/env python3
"""Test instrumentation: deny selected source trees in a command and Python children."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--deny', type=Path, action='append', default=[])
parser.add_argument('--allow', type=Path, action='append', default=[])
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ['--'] else args.command
if not command:
    parser.error('Supply -- COMMAND ...')
settings = {'deny': [str(p.resolve()) for p in args.deny], 'allow': [str(p.resolve()) for p in args.allow]}
with tempfile.TemporaryDirectory(prefix='source-denied-') as temporary:
    hook = '''import json, os, sys
settings = json.loads(SETTINGS)
def within(path, roots):
    return any(path == root or path.startswith(root + os.sep) for root in roots)
def guard(event, args):
    if event in ('open', 'os.listdir', 'os.scandir') and args and isinstance(args[0], (str, bytes)):
        path = os.path.abspath(os.fsdecode(args[0]))
        if within(path, settings['deny']) and not within(path, settings['allow']):
            raise RuntimeError('Forbidden source access: ' + path)
sys.addaudithook(guard)
'''.replace('SETTINGS', repr(json.dumps(settings)))
    (Path(temporary) / 'sitecustomize.py').write_text(hook)
    environment = {**os.environ, 'PYTHONPATH': temporary, 'PYTHONDONTWRITEBYTECODE': '1'}
    raise SystemExit(subprocess.run(command, env=environment).returncode)
