#!/usr/bin/env bash
# Install a published, hashed wheel pair and verified public component bundle.
# DEVICE (default j71b) selects the bundle; other devices extract to out/DEVICE.
set -euo pipefail
: "${HARDWARE_TAG:?Set HARDWARE_TAG to an immutable hardware release}"
: "${CLI_TAG:?Set CLI_TAG to an immutable CLI release}"
[[ "$HARDWARE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ && "$CLI_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo 'Hardware and CLI tags must be vMAJOR.MINOR.PATCH' >&2; exit 2;
}
mode=${1:-}
case "$#:$mode" in
  0:|1:--wheels-only|1:--components-only) ;;
  *) echo 'Usage: ci/dependencies [--wheels-only|--components-only]' >&2; exit 2;;
esac
device=${DEVICE:-j71b}
[[ "$device" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo 'Invalid DEVICE' >&2; exit 2; }
if [[ "$mode" != --components-only ]]; then
  python3 -m venv .venv
  if [[ -n "${CLI_ARTIFACT_DIR:-}" ]]; then
    .venv/bin/python -m pip install --only-binary=:all: "$CLI_ARTIFACT_DIR"/*.whl
  else
    .venv/bin/python -m pip install --only-binary=:all: -r \
      "https://github.com/OrchardLinux/cli/releases/download/$CLI_TAG/requirements.txt"
  fi
  .venv/bin/python - <<'PY'
import importlib.metadata as m, os
for package, variable in (('orchard-hardware', 'HARDWARE_TAG'), ('orchard-cli', 'CLI_TAG')):
    if 'v' + m.version(package) != os.environ[variable]:
        raise SystemExit('Published wheel pair does not match ' + variable)
PY
  .venv/bin/python -m pip check
  if [[ "$mode" == --wheels-only ]]; then exit 0; fi
fi
bundle="$device-components.tar.gz"
destination=out
[[ $device == j71b ]] || destination="out/$device"
mkdir -p out/downloads "$destination"
base="https://github.com/OrchardLinux/hardware/releases/download/$HARDWARE_TAG"
if [[ -n "${HARDWARE_ARTIFACT_DIR:-}" ]]; then
  cp "$HARDWARE_ARTIFACT_DIR/$bundle" "$HARDWARE_ARTIFACT_DIR/SHA256SUMS" out/downloads/
else
  curl -fL --retry 3 "$base/$bundle" -o "out/downloads/$bundle"
  curl -fL --retry 3 "$base/SHA256SUMS" -o out/downloads/SHA256SUMS
fi
grep -Eq " (\./)?$bundle\$" out/downloads/SHA256SUMS
(cd out/downloads && grep -E " (\./)?$bundle\$" SHA256SUMS | sha256sum --check --strict)
tar -xzf "out/downloads/$bundle" -C "$destination"
if [[ "$mode" != --components-only ]]; then .venv/bin/python -m pip check; fi
