#!/usr/bin/env bash
# Install orchard main (or ORCHARD_REF) and a verified public component bundle.
set -euo pipefail
: "${HARDWARE_TAG:?Set HARDWARE_TAG to the immutable orchard release with the components}"
[[ "$HARDWARE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo 'The component release tag must be vMAJOR.MINOR.PATCH' >&2; exit 2;
}
# The tools are orchard's current main; the release receipt records its commit.
if [[ ! -f .orchard/pyproject.toml ]]; then
  git clone --quiet --depth 1 --branch "${ORCHARD_REF:-main}" https://github.com/OrchardLinux/orchard.git .orchard
fi
echo "orchard $(git -C .orchard rev-parse HEAD)"
python3 -m venv .venv
.venv/bin/python -m pip install -e ./.orchard
.venv/bin/python -m pip check
if [[ "${1:-}" == --tools-only ]]; then exit 0; fi
[[ $# == 0 ]] || { echo 'Usage: ci/dependencies [--tools-only]' >&2; exit 2; }
mkdir -p out/downloads
base="https://github.com/OrchardLinux/orchard/releases/download/$HARDWARE_TAG"
if [[ -n "${HARDWARE_ARTIFACT_DIR:-}" ]]; then
  cp "$HARDWARE_ARTIFACT_DIR/j71b-components.tar.gz" "$HARDWARE_ARTIFACT_DIR/SHA256SUMS" out/downloads/
else
  curl -fL --retry 3 "$base/j71b-components.tar.gz" -o out/downloads/j71b-components.tar.gz
  curl -fL --retry 3 "$base/SHA256SUMS" -o out/downloads/SHA256SUMS
fi
grep -Eq ' (\./)?j71b-components.tar.gz$' out/downloads/SHA256SUMS
(cd out/downloads && grep -E ' (\./)?j71b-components.tar.gz$' SHA256SUMS | sha256sum --check --strict)
tar -xzf out/downloads/j71b-components.tar.gz -C out
