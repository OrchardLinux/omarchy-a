#!/bin/sh
# Always use this checkout's editable CLI, regardless of globally installed tools.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v uv >/dev/null 2>&1 || {
    echo 'Install uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
    exit 1
}
for member in hardware cli; do
    # Initialize absent dependencies only; never reset/update existing local edits.
    if [ ! -f "$root/$member/pyproject.toml" ]; then
        git -C "$root" submodule update --init -- "$member"
    fi
done
export UV_PROJECT_ENVIRONMENT="$root/.venv"
exec uv run --project "$root" orchard "$@"
