+
+/* A Super+pointer gesture is not a standalone Super tap. Keep unrelated
+ * release bindings (power, home, etc.) intact. */
+void
+keyboard_cancel_super_release(void)
+{
+	if (cur_keybind && cur_keybind->on_release
+			&& (keybind_contains_keysym(cur_keybind, XKB_KEY_Super_L)
+			|| keybind_contains_keysym(cur_keybind, XKB_KEY_Super_R))) {
+		cur_keybind = NULL;
+	}
 }
 
