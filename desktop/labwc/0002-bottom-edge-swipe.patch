+static bool
+bottom_swipe_locked(void)
+{
+	return server.session_lock_manager && server.session_lock_manager->locked;
+}
+
+static struct bottom_swipe_box
+bottom_swipe_output(double lx, double ly, struct output **lab_output)
+{
+	/* Clamp the absolute 1.0 endpoint to the output layout for edge touches. */
+	double cx, cy;
+	wlr_output_layout_closest_point(server.output_layout, NULL, lx, ly, &cx, &cy);
+	struct wlr_output *output = wlr_output_layout_output_at(server.output_layout, cx, cy);
+	*lab_output = output ? output_from_wlr_output(output) : NULL;
+	if (!output) {
+		return (struct bottom_swipe_box){0};
+	}
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output, &box);
+	return (struct bottom_swipe_box){box.x, box.y, box.width, box.height};
+}
+
+static bool
+bottom_swipe_ignored(struct output *output, const char *namespace)
+{
+	if (!output || !namespace || !*namespace) {
+		return false;
+	}
+	for (size_t i = 0; i < ARRAY_SIZE(output->layer_tree); ++i) {
+		struct wlr_scene_node *node;
+		wl_list_for_each(node, &output->layer_tree[i]->children, link) {
+			struct lab_layer_surface *layer = node_layer_surface_from_node(node);
+			if (layer->mapped && layer->layer_surface->namespace
+					&& !strcmp(layer->layer_surface->namespace, namespace)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static struct touch_config_entry *
+bottom_swipe_config(struct wlr_touch *device)
+{
+	struct touch_config_entry *config = touch_find_config_for_device(device->base.name);
+	/* Output-mapping entries are generated per touchscreen. They must not
+	 * erase the default gesture binding merely by omitting gesture fields.
+	 * A named empty command still explicitly disables the gesture. */
+	if (config && config->bottom_swipe_command) {
+		return config;
+	}
+	wl_list_for_each_reverse(config, &rc.touch_configs, link) {
+		if (!config->device_name && config->bottom_swipe_command) {
+			return config;
+		}
+	}
+	return NULL;
+}
+
+static bool
+bottom_swipe_allowed(struct touch_config_entry *config, struct output *output)
+{
+	return config && config->bottom_swipe_command && *config->bottom_swipe_command
+		&& !bottom_swipe_locked() && server.input_mode == LAB_INPUT_STATE_PASSTHROUGH
+		&& !bottom_swipe_ignored(output, config->bottom_swipe_ignore_namespace);
+}
+
+static void
+flush_deferred_mouse(struct seat *seat, struct touch_point *point)
+{
+	if (!point->mouse_deferred) {
+		return;
+	}
+	point->mouse_deferred = false;
+	cursor_emulate_move_absolute(seat, &point->device->base,
+		point->start_x, point->start_y, point->start_time);
+	cursor_emulate_button(seat, BTN_LEFT, WL_POINTER_BUTTON_STATE_PRESSED,
+		point->start_time);
+}
+
+static void
+cancel_touch_client(struct seat *seat, struct touch_point *point)
+{
+	struct wlr_touch_point *wlr_point = wlr_seat_touch_get_point(seat->wlr_seat,
+		point->touch_id);
+	if (wlr_point) {
+		wlr_seat_touch_notify_cancel(seat->wlr_seat, wlr_point->client);
+		/* wl_touch.cancel ends the whole client's sequence, not just one ID.
+		 * wlroots has removed those points; consume their remaining events. */
+		struct touch_point *other;
+		wl_list_for_each(other, &seat->touch_points, link) {
+			if (other->surface && !wlr_seat_touch_get_point(seat->wlr_seat, other->touch_id)) {
+				other->consumed = true;
+				other->swipe.pending = false;
+			}
+		}
+	}
+	point->consumed = true;
+	point->swipe.pending = false;
+	point->mouse_deferred = false;
+}
+
+static bool
+handle_bottom_swipe_motion(struct seat *seat, struct touch_point *point,
+		struct wlr_touch_motion_event *event)
+{
+	if (point->consumed) {
+		return true;
+	}
+	if (!point->swipe.pending) {
+		return false;
+	}
+	double lx, ly;
+	wlr_cursor_absolute_to_layout_coords(seat->cursor, &event->touch->base,
+		event->x, event->y, &lx, &ly);
+	struct output *output;
+	struct bottom_swipe_box box = bottom_swipe_output(lx, ly, &output);
+	/* Resolve config on every motion: reconfigure must not leave stale pointers. */
+	struct touch_config_entry *config = bottom_swipe_config(event->touch);
+	enum bottom_swipe_result result = bottom_swipe_motion(&point->swipe, box,
+		lx, ly, event->time_msec, bottom_swipe_allowed(config, output));
+	if (result == BOTTOM_CLAIM || result == BOTTOM_CANCEL) {
+		cancel_touch_client(seat, point);
+		if (result == BOTTOM_CLAIM) {
+			spawn_async_no_shell(config->bottom_swipe_command);
+		}
+		return true;
+	}
+	if (result == BOTTOM_PASS) {
+		flush_deferred_mouse(seat, point);
+	}
+	/* Native clients see a cancellable touch sequence until the claim.
+	 * Pointer emulation has no cancel protocol, so do not click it early. */
+	return point->mouse_deferred;
+}
