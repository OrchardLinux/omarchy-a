+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_BOTTOM_SWIPE_H
+#define LABWC_BOTTOM_SWIPE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <math.h>
+
+/* Logical output coordinates, after device/output rotation and scale. */
+struct bottom_swipe_box { double x, y, width, height; };
+struct bottom_swipe {
+	bool pending;
+	double x, y;
+	uint32_t time;
+	struct bottom_swipe_box box;
+};
+enum bottom_swipe_result { BOTTOM_PASS, BOTTOM_WAIT, BOTTOM_CLAIM, BOTTOM_CANCEL };
+
+static inline void
+bottom_swipe_begin(struct bottom_swipe *s, struct bottom_swipe_box box,
+		double x, double y, uint32_t time, bool allowed)
+{
+	*s = (struct bottom_swipe){ .x = x, .y = y, .time = time, .box = box };
+	s->pending = allowed && box.width > 0 && box.height > 0
+		&& x >= box.x && x <= box.x + box.width
+		&& y >= box.y + box.height - 12 && y <= box.y + box.height;
+}
+
+static inline enum bottom_swipe_result
+bottom_swipe_motion(struct bottom_swipe *s, struct bottom_swipe_box box,
+		double x, double y, uint32_t time, bool allowed)
+{
+	if (!s->pending) {
+		return BOTTOM_PASS;
+	}
+	if (!allowed || box.x != s->box.x || box.y != s->box.y
+			|| box.width != s->box.width || box.height != s->box.height) {
+		s->pending = false;
+		return BOTTOM_CANCEL;
+	}
+	double dx = fabs(x - s->x), dy = s->y - y;
+	if ((uint32_t)(time - s->time) > 700 || dx > 24 || dy < -12) {
+		s->pending = false;
+		return BOTTOM_PASS;
+	}
+	if (dy >= 40 && dy > dx * 1.5) {
+		s->pending = false;
+		return BOTTOM_CLAIM;
+	}
+	return BOTTOM_WAIT;
+}
+#endif
