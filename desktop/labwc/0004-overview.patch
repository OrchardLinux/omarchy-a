+/* Row layout: how far to scroll to have card @index in the middle. */
+static double
+row_scroll_for(int index)
+{
+	struct card *card = card_at_index(index);
+	return card ? card->tx + card->tw / 2 - (ov.area.x + ov.area.width / 2.0) : 0;
+}
+
+static int
+row_index_at(double scroll)
+{
+	int index = 0, best = 0;
+	double distance = INFINITY;
+	struct card *card;
+	wl_list_for_each(card, &ov.cards, link) {
+		double d = fabs(row_scroll_for(index) - scroll);
+		if (d < distance) {
+			distance = d;
+			best = index;
+		}
+		index++;
+	}
+	return best;
+}
+
+static void
+update_dots(void)
+{
+	if (!ov.dots) {
+		return;
+	}
+	struct wlr_scene_node *child, *tmp;
+	wl_list_for_each_safe(child, tmp, &ov.dots->children, link) {
+		wlr_scene_node_destroy(child);
+	}
+	int count = nr_cards(), current = row_index_at(ov.scroll_target);
+	if (count < 2) {
+		return;
+	}
+	float *color = rc.theme->osd_label_text_color;
+	float dimmed[4];
+	for (int i = 0; i < 4; i++) {
+		dimmed[i] = color[i] * 0.35f;
+	}
+	int x = 0;
+	for (int i = 0; i < count; i++) {
+		int width = i == current ? 18 : 6;
+		struct wlr_scene_rect *dot = lab_wlr_scene_rect_create(ov.dots, width, 6,
+			i == current ? color : dimmed);
+		wlr_scene_node_set_position(&dot->node, x, 0);
+		x += width + 6;
+	}
+	struct card *first = card_at_index(0);
+	wlr_scene_node_set_position(&ov.dots->node,
+		ov.area.x + (ov.area.width - (x - 6)) / 2,
+		first ? (int)(first->ty + ov.area.height * 0.62 + 28) : ov.area.y);
+}
+
+/* Give every card its place. @snap: no easing from the old place. */
+static void
+relayout(bool snap)
+{
+	int count = nr_cards();
+	if (!count) {
+		return;
+	}
+	double aspect = 0;
+	struct card *card;
+	wl_list_for_each(card, &ov.cards, link) {
+		aspect += (double)card->from.width / card->from.height;
+	}
+	aspect /= count;
+
+	int label_width;
+	if (ov.row) {
+		double height = floor(ov.area.height * 0.62);
+		double top = ov.area.y + (ov.area.height - height) / 2 + LABEL_HEIGHT / 4.0;
+		double x = 0;
+		wl_list_for_each(card, &ov.cards, link) {
+			double a = (double)card->from.width / card->from.height;
+			card->tw = fmin(height * a, ov.area.width * 0.72);
+			card->th = card->tw / a;
+			card->tx = x;
+			card->ty = top + (height - card->th) / 2;
+			x += card->tw + ROW_GAP;
+		}
+		/* Scroll 0 has the first card in the middle. */
+		struct card *first = card_at_index(0);
+		double shift = ov.area.x + (ov.area.width - first->tw) / 2;
+		wl_list_for_each(card, &ov.cards, link) {
+			card->tx += shift;
+		}
+		ov.scroll_max = row_scroll_for(count - 1);
+		ov.titles = false;
+		label_width = 0;
+	} else {
+		ov.grid = overview_grid(count, ov.area.width, ov.area.height, aspect,
+			GAP, LABEL_HEIGHT);
+		struct overview_grid *grid = &ov.grid;
+		double row_height = grid->pic_height + LABEL_HEIGHT + GAP;
+		double content = grid->rows * row_height + GAP;
+		double top = ov.area.y + GAP;
+		if (content <= ov.area.height) {
+			top += (ov.area.height - content) / 2;
+			ov.scroll_max = 0;
+		} else {
+			ov.scroll_max = content - ov.area.height;
+		}
+		int index = 0;
+		wl_list_for_each(card, &ov.cards, link) {
+			int row = index / grid->cols, col = index % grid->cols;
+			int length = overview_grid_row_length(grid, count, row);
+			double row_width = length * grid->pic_width + (length - 1) * GAP;
+			double x = ov.area.x + (ov.area.width - row_width) / 2
+				+ col * (grid->pic_width + GAP);
+			double y = top + row * row_height;
+			double a = (double)card->from.width / card->from.height;
+			card->tw = fmin(grid->pic_width, grid->pic_height * a);
+			card->th = card->tw / a;
+			card->tx = x + (grid->pic_width - card->tw) / 2;
+			card->ty = y + grid->pic_height - card->th;
+			index++;
+		}
+		ov.titles = grid->pic_width >= TITLES_FROM_WIDTH;
+		label_width = grid->pic_width + GAP / 2;
+	}
+	ov.scroll_target = clamp(ov.scroll_target, 0, ov.scroll_max);
+	ov.scroll = clamp(ov.scroll, 0, ov.scroll_max);
+
+	wl_list_for_each(card, &ov.cards, link) {
+		if (snap || !card->placed || !ov.live) {
+			card->sx = card->tx;
+			card->sy = card->ty;
+			card->sw = card->tw;
+			card->sh = card->th;
+			card->placed = true;
+		}
+		card_build_label(card, ov.row ? (int)card->tw : label_width);
+		if (card->shadow) {
+			wlr_scene_node_destroy(&card->shadow->node);
+		}
+		card->shadow = create_shadow(card->tree, lround(card->tw), lround(card->th));
+		if (card->shadow) {
+			wlr_scene_node_lower_to_bottom(&card->shadow->node);
+		}
+		if (!ov.live) {
+			for (int i = 0; i < card->nr_parts; i++) {
+				struct part *part = &card->parts[i];
+				part_snapshot(part, lround(card->tw * part->fw),
+					lround(card->th * part->fh));
+			}
+		}
+		card->width = card->height = 0;
+	}
+	update_dots();
+}
+
+/*
+ * Drawing
+ */
+
+static void
+card_apply(struct card *card)
+{
+	double p = ov.progress;
+	/* Windows travel from their place; what has none (minimised) fades. */
+	bool travels = ov.live && !card->minimized;
+	double e = travels ? p : 1;
+	double scroll_x = ov.row ? ov.scroll : 0, scroll_y = ov.row ? 0 : ov.scroll;
+	double sx = card->sx - scroll_x, sy = card->sy - scroll_y;
+	double x = card->from.x + (sx - card->from.x) * e;
+	double y = card->from.y + (sy - card->from.y) * e - card->lift;
+	int width = MAX(1, (int)lround(card->from.width + (card->sw - card->from.width) * e));
+	int height = MAX(1, (int)lround(card->from.height + (card->sh - card->from.height) * e));
+	float alpha = travels ? 1.0f : (float)p;
+	float extras = ov.live ? (float)clamp((p - 0.4) / 0.6, 0, 1) : (float)p;
+
+	wlr_scene_node_set_position(&card->tree->node, lround(x), lround(y));
+
+	bool resized = width != card->width || height != card->height;
+	bool refaded = fabsf(alpha * 2 + extras - card->alpha) > 0.0005f;
+	for (int i = 0; i < card->nr_parts; i++) {
+		struct part *part = &card->parts[i];
+		if (!resized && !part->dirty) {
+			continue;
+		}
+		int px = lround(part->fx * width), py = lround(part->fy * height);
+		int pw = (int)lround((part->fx + part->fw) * width) - px;
+		int ph = (int)lround((part->fy + part->fh) * height) - py;
+		wlr_scene_node_set_position(&part->tree->node, px, py);
+		part_place(part, MAX(1, pw), MAX(1, ph));
+		part->dirty = false;
+		refaded = true;
+	}
+	if (resized) {
+		card->width = width;
+		card->height = height;
+		wlr_scene_rect_set_size(card->shade, width, height);
+		if (card->shadow) {
+			wlr_scene_node_set_position(&card->shadow->node, -SHADOW, -SHADOW + 4);
+			wlr_scene_buffer_set_dest_size(card->shadow,
+				width + 2 * SHADOW, height + 2 * SHADOW);
+		}
+		if (card->tag) {
+			wlr_scene_node_set_position(&card->tag->node, 8,
+				height - card->tag_text->height - 16);
+		}
+		refaded = true;
+	}
+	if (refaded) {
+		card->alpha = alpha * 2 + extras;
+		set_tree_opacity(&card->pictures->node, alpha);
+		for (int i = 0; i < card->nr_parts; i++) {
+			struct part *part = &card->parts[i];
+			for (int j = 0; j < part->nr_mirrors; j++) {
+				struct mirror *mirror = &part->mirrors[j];
+				if (mirror->rect) {
+					set_rect_color(mirror->rect, mirror->color, alpha);
+				}
+			}
+		}
+		set_rect_color(card->shade, (float[4]){ 0, 0, 0, 0.5f }, alpha);
+		frame_set(&card->hairline, width, height, extras);
+		frame_set(&card->marker, width, height, extras);
+		if (card->shadow) {
+			wlr_scene_buffer_set_opacity(card->shadow, extras);
+		}
+		if (card->tag) {
+			set_rect_color(card->tag_bg, rc.theme->osd_bg_color, 0.9f * extras);
+			wlr_scene_buffer_set_opacity(card->tag_text->scene_buffer, extras);
+		}
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &card->label->children, link) {
+			if (child->type == WLR_SCENE_NODE_RECT) {
+				set_rect_color(wlr_scene_rect_from_node(child),
+					rc.theme->osd_bg_color, 0.9f * extras);
+			} else {
+				set_tree_opacity(child, extras);
+			}
+		}
+	}
+
+	bool marked = card->attention || (ov.keyboard && ov.selected == card);
+	wlr_scene_node_set_enabled(&card->marker.tree->node, marked);
+	wlr_scene_node_set_enabled(&card->tree->node, !card->closing || card->flying);
+	wlr_scene_node_set_enabled(&card->label->node, !card->closing);
+
+	/* The label keeps its place in the grid while the window travels. */
+	int label_x = ov.row ? lround(sx)
+		: lround(sx + card->sw / 2 - card->label_width / 2.0);
+	int label_y = ov.row ? lround(sy - TILE - LABEL_OFFSET)
+		: lround(sy + card->sh + LABEL_OFFSET);
+	wlr_scene_node_set_position(&card->label->node, label_x, label_y);
+}
+
+static void
+apply(void)
+{
+	set_rect_color(ov.dim, (float[4]){ 0, 0, 0, 1 }, (float)(DIM * ov.progress));
+	struct card *card;
+	wl_list_for_each(card, &ov.cards, link) {
+		card_apply(card);
+	}
+	if (ov.dots) {
+		float extras = ov.live ? clamp((ov.progress - 0.4) / 0.6, 0, 1) : ov.progress;
+		struct wlr_scene_node *dot;
+		int index = 0, current = row_index_at(ov.scroll_target);
+		wl_list_for_each(dot, &ov.dots->children, link) {
+			float *color = rc.theme->osd_label_text_color;
+			set_rect_color(wlr_scene_rect_from_node(dot), color,
+				(index == current ? 1.0f : 0.35f) * extras);
+			index++;
+		}
+	}
+}
+
+/*
+ * Opening and closing
+ */
+
+static void
+hide_desktop(bool hide)
+{
+	wlr_scene_node_set_enabled(&server.workspace_tree->node, !hide);
+	wlr_scene_node_set_enabled(&server.xdg_popup_tree->node, !hide);
+#if HAVE_XWAYLAND
+	wlr_scene_node_set_enabled(&server.unmanaged_tree->node, !hide);
+#endif
+}
+
+static void
+destroy(void)
+{
+	if (ov.state == CLOSED) {
+		return;
+	}
+	struct output *output = ov.output;
+	struct card *card, *tmp;
+	wl_list_for_each_safe(card, tmp, &ov.cards, link) {
+		card_destroy(card);
+	}
+	wlr_scene_node_destroy(&ov.tree->node);
+	hide_desktop(false);
+	memset(&ov, 0, sizeof(ov));
+	wlr_output_schedule_frame(output->wlr_output);
+	cursor_update_focus();
+}
+
+static void
+select_card(struct card *card)
+{
+	ov.selected = card;
+	if (!card) {
+		return;
+	}
+	if (ov.row) {
+		ov.scroll_target = row_scroll_for(card_index(card));
+		update_dots();
+	} else if (ov.scroll_max > 0) {
+		double top = card->ty - GAP - ov.area.y;
+		double bottom = card->ty + card->th + LABEL_HEIGHT + GAP
+			- (ov.area.y + ov.area.height);
+		ov.scroll_target = clamp(ov.scroll_target, bottom, top);
+		ov.scroll_target = clamp(ov.scroll_target, 0, ov.scroll_max);
+	}
+	if (!ov.live) {
+		ov.scroll = ov.scroll_target;
+	}
+}
+
+static bool
+begin(struct output *output, bool keyboard, enum state state)
+{
+	if (ov.state == CLOSING) {
+		destroy();
+	}
+	if (ov.state != CLOSED || server.input_mode != LAB_INPUT_STATE_PASSTHROUGH
+			|| locked() || !output_is_usable(output)) {
+		return false;
+	}
+	if (!count_views()) {
+		/* Nothing to switch between: let the shell offer its apps. */
+		if (rc.overview_empty_command && *rc.overview_empty_command) {
+			spawn_async_no_shell(rc.overview_empty_command);
+		}
+		return false;
+	}
+
+	memset(&ov, 0, sizeof(ov));
+	wl_list_init(&ov.cards);
+	ov.state = state;
+	ov.output = output;
+	ov.keyboard = keyboard;
+	ov.live = rc.overview_live == LAB_STATE_ENABLED
+		|| (rc.overview_live != LAB_STATE_DISABLED
+			&& !wlr_renderer_is_pixman(server.renderer));
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output, &ov.box);
+	ov.area = output_usable_area_in_layout_coords(output);
+	ov.row = MIN(ov.box.width, ov.box.height) < 500;
+	ov.last_tick = now();
+
+	ov.tree = lab_wlr_scene_tree_create(&server.scene->tree);
+	wlr_scene_node_place_above(&ov.tree->node, &server.workspace_tree->node);
+	ov.dim = lab_wlr_scene_rect_create(ov.tree, ov.box.width, ov.box.height,
+		(float[4]){0});
+	wlr_scene_node_set_position(&ov.dim->node, ov.box.x, ov.box.y);
+	ov.labels = lab_wlr_scene_tree_create(ov.tree);
+	if (ov.row) {
+		ov.dots = lab_wlr_scene_tree_create(ov.tree);
+	}
+	ov.cards_tree = lab_wlr_scene_tree_create(ov.tree);
+
+	/* Most recently used first; a snapped pair is one card. */
+	struct view *view;
+	for_each_overview_view(view) {
+		if (!view_wanted(view) || card_of(view, NULL)) {
+			continue;
+		}
+		struct view *partner = NULL, *other;
+		if (view_snapped(view)) {
+			for_each_overview_view(other) {
+				if (other != view && view_wanted(other) && view_snapped(other)
+						&& other->output == view->output
+						&& other->tiled == opposite(view->tiled)
+						&& !card_of(other, NULL)) {
+					partner = other;
+					break;
+				}
+			}
+		}
+		/* Left (or top) half first, whichever was used last. */
+		if (partner && (view->tiled == LAB_EDGE_RIGHT || view->tiled == LAB_EDGE_BOTTOM)) {
+			card_create(partner, view);
+		} else {
+			card_create(view, partner);
+		}
+	}
+
+	if (ov.live) {
+		struct card *card;
+		wl_list_for_each(card, &ov.cards, link) {
+			for (int i = 0; i < card->nr_parts; i++) {
+				part_sync_mirrors(&card->parts[i]);
+			}
+		}
+	}
+	relayout(/*snap*/ true);
+
+	/* As with Alt-Tab, start on the window before this one. */
+	struct card *start = card_at_index(nr_cards() > 1 ? 1 : 0);
+	if (keyboard || ov.row) {
+		select_card(start);
+		ov.scroll = ov.scroll_target;
+	}
+	if (!keyboard) {
+		ov.selected = NULL;
+	}
+
+	seat_focus_override_begin(&server.seat, LAB_INPUT_STATE_OVERVIEW,
+		LAB_CURSOR_DEFAULT);
+	if (!ov.live) {
+		cover_begin(output, &ov.tree->node);
+		ov.progress = 1;
+		if (ov.state == OPENING) {
+			ov.state = OPEN;
+		}
+	}
+	hide_desktop(true);
+	ov.target = 1;
+	apply();
+	if (rc.overview_open_command && *rc.overview_open_command) {
+		spawn_async_no_shell(rc.overview_open_command);
+	}
+	cursor_update_focus();
+	redraw();
+	return true;
+}
+
+/* Tell the session that the overview is no longer what is on screen. */
+static void
+announce_close(void)
+{
+	if (rc.overview_close_command && *rc.overview_close_command) {
+		spawn_async_no_shell(rc.overview_close_command);
+	}
+}
+
+/* Leave for the desktop; @chosen comes to the front, if any. */
+static void
+finish(struct view *chosen)
+{
+	if (ov.state == CLOSED || ov.state == CLOSING) {
+		return;
+	}
+	announce_close();
+	int index = 0;
+	struct card *card = chosen ? card_of(chosen, &index) : NULL;
+	ov.press.down = false;
+	ov.gesture.pending = false;
+
+	seat_focus_override_end(&server.seat, /*restore_focus*/ !chosen);
+	if (chosen) {
+		/* A pair comes back as a pair. */
+		if (card && card->nr_parts == 2) {
+			desktop_focus_view(card->parts[!index].view, /*raise*/ true);
+		}
+		desktop_focus_view(chosen, /*raise*/ true);
+	}
+	if (!ov.live) {
+		struct output *output = ov.output;
+		destroy();
+		cover_begin(output, &server.workspace_tree->node);
+		return;
+	}
+	ov.state = CLOSING;
+	ov.target = 0;
+	struct card *other;
+	wl_list_for_each(other, &ov.cards, link) {
+		other->lift = 0;
+		other->flying = false;
+	}
+	if (card) {
+		/* It is a window again: it grows back to where it is. */
+		if (card->minimized) {
+			card->minimized = false;
+			wlr_scene_node_set_enabled(&card->shade->node, false);
+			if (card->tag) {
+				wlr_scene_node_set_enabled(&card->tag->node, false);
+			}
+		}
+		card_measure(card);
+		card->alpha = -1;
+		wlr_scene_node_raise_to_top(&card->tree->node);
+	}
+	cursor_update_focus();
+	redraw();
+}
+
+void
+overview_toggle(bool keyboard)
+{
+	if (ov.state == OPEN || ov.state == OPENING || ov.state == TRACKING) {
+		finish(NULL);
+		return;
+	}
+	struct output *output = server.active_view && output_is_usable(server.active_view->output)
+		? server.active_view->output : output_nearest_to_cursor();
+	begin(output, keyboard, OPENING);
+}
+
+bool
+overview_active(void)
+{
+	return server.input_mode == LAB_INPUT_STATE_OVERVIEW;
+}
+
+void
+overview_abort(void)
+{
+	cover_remove();
+	if (ov.state == CLOSED) {
+		return;
+	}
+	if (overview_active()) {
+		seat_focus_override_end(&server.seat, /*restore_focus*/ true);
+	}
+	if (ov.state != CLOSING) {
+		announce_close();
+	}
+	destroy();
+}
+
+static void
+choose(struct card *card, int part)
+{
+	finish(card->parts[part < card->nr_parts ? part : 0].view);
+}
+
+static void
+close_card(struct card *card)
+{
+	if (card->closing) {
+		return;
+	}
+	card->closing = true;
+	card->attention = false;
+	card->close_deadline = now() + CLOSE_WAIT;
+	card->flying = ov.live;
+	if (card->lift_velocity < 1800) {
+		card->lift_velocity = 1800;
+	}
+	if (ov.selected == card) {
+		struct card *next = card_at_index(card_index(card) + 1);
+		ov.selected = next ? next : card_at_index(card_index(card) - 1);
+	}
+	for (int i = 0; i < card->nr_parts; i++) {
+		view_close(card->parts[i].view);
+	}
+	redraw();
+}
+
+void
+overview_tick(struct output *output)
+{
+	cover_tick(output, now());
+	if (ov.state == CLOSED || output != ov.output) {
+		return;
+	}
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output, &box);
+	if (locked() || !wlr_box_equal(&box, &ov.box)) {
+		/* Locked or turned: nothing here is in the right place any more. */
+		overview_abort();
+		return;
+	}
+	double time = now();
+	double dt = clamp(time - ov.last_tick, 0, 0.1);
+	ov.last_tick = time;
+	bool moving = false;
+
+	if (ov.state == OPENING || ov.state == CLOSING) {
+		ov.progress = approach(ov.progress, ov.target, dt, 14);
+		if (ov.progress == ov.target) {
+			if (ov.state == CLOSING) {
+				destroy();
+				return;
+			}
+			ov.state = OPEN;
+		}
+		moving = true;
+	}
+
+	if (ov.scroll != ov.scroll_target) {
+		ov.scroll = ov.live ? approach(ov.scroll, ov.scroll_target, dt, 16)
+			: ov.scroll_target;
+		if (fabs(ov.scroll - ov.scroll_target) < 0.5) {
+			ov.scroll = ov.scroll_target;
+		}
+		moving = true;
+	}
+
+	bool regrid = false;
+	struct card *card, *tmp;
+	wl_list_for_each_safe(card, tmp, &ov.cards, link) {
+		if (card->sx != card->tx || card->sy != card->ty
+				|| card->sw != card->tw || card->sh != card->th) {
+			card->sx = approach(card->sx, card->tx, dt, 14);
+			card->sy = approach(card->sy, card->ty, dt, 14);
+			card->sw = approach(card->sw, card->tw, dt, 14);
+			card->sh = approach(card->sh, card->th, dt, 14);
+			moving = true;
+		}
+		bool held = ov.press.down && ov.press.card == card && ov.press.drag == DRAG_LIFT;
+		if (card->flying) {
+			card->lift += card->lift_velocity * dt;
+			if (card->sy - card->lift + card->sh < ov.box.y - SHADOW) {
+				card->flying = false;
+			}
+			moving = true;
+		} else if (card->lift > 0 && !held && !card->closing) {
+			card->lift = ov.live ? approach(card->lift, 0, dt, 18) : 0;
+			if (card->lift < 0.5) {
+				card->lift = 0;
+			}
+			moving = true;
+		}
+		if (card->closing && time >= card->close_deadline) {
+			/* Still there: the app wants an answer first. */
+			card->closing = false;
+			card->flying = false;
+			card->attention = true;
+			card->lift = 0;
+			frame_set_color(&card->marker, rc.theme->overview_attention_color);
+			if (!ov.live) {
+				for (int i = 0; i < card->nr_parts; i++) {
+					card->parts[i].snapshot_width = 0;
+				}
+			}
+			regrid = true;
+		}
+		moving |= card->closing;
+	}
+	if (regrid) {
+		relayout(/*snap*/ false);
+	}
+
+	if (ov.live) {
+		struct timespec stamp;
+		clock_gettime(CLOCK_MONOTONIC, &stamp);
+		wl_list_for_each(card, &ov.cards, link) {
+			for (int i = 0; i < card->nr_parts; i++) {
+				struct part *part = &card->parts[i];
+				if (!view_wanted(part->view)) {
+					continue;
+				}
+				part_sync_mirrors(part);
+				/* Hidden windows get no frame callbacks; ours keep them drawing. */
+				wlr_surface_for_each_surface(part->view->surface,
+					send_frame_done, &stamp);
+			}
+		}
+		moving = true;
+	}
+
+	apply();
+	if (moving) {
+		wlr_output_schedule_frame(output->wlr_output);
+	}
+}
+
+/*
+ * Windows coming and going
+ */
+
+void
+overview_on_view_gone(struct view *view)
+{
+	if (ov.state == CLOSED) {
+		return;
+	}
+	int index;
+	struct card *card = card_of(view, &index);
+	if (!card) {
+		return;
+	}
+	if (card->nr_parts == 2) {
+		/* Half of a pair is left: it is a card of its own now. */
+		struct part *gone = &card->parts[index];
+		wlr_scene_node_destroy(&gone->tree->node);
+		if (index == 0) {
+			card->parts[0] = card->parts[1];
+		}
+		card->nr_parts = 1;
+		card_measure(card);
+		card->parts[0].snapshot_width = 0;
+	} else {
+		card_destroy(card);
+	}
+	if (wl_list_empty(&ov.cards)) {
+		if (ov.state == CLOSING) {
+			destroy();
+		} else {
+			overview_abort();
+		}
+		return;
+	}
+	if (ov.state != CLOSING) {
+		relayout(/*snap*/ false);
+		if (ov.row) {
+			ov.scroll_target = row_scroll_for(row_index_at(ov.scroll_target));
+			update_dots();
+		}
+	}
+	redraw();
+}
+
+void
+overview_on_view_mapped(struct view *view)
+{
+	if (ov.state == CLOSED || ov.state == CLOSING) {
+		return;
+	}
+	struct view *root = view_get_root(view);
+	struct card *card = root != view ? card_of(root, NULL) : NULL;
+	if (card) {
+		/* A dialog of a window here: most likely "Save changes?". */
+		if (card->closing) {
+			card->close_deadline = 0;
+			redraw();
+		}
+		return;
+	}
+	/* A new window is what the user asked for last: show it. */
+	overview_abort();
+}
+
+/*
+ * Input
+ */
+
+static bool
+on_overview(double lx, double ly)
+{
+	double sx, sy;
+	struct wlr_scene_node *node =
+		wlr_scene_node_at(&server.scene->tree.node, lx, ly, &sx, &sy);
+	while (node) {
+		if (node == &ov.tree->node) {
+			return true;
+		}
+		node = node->parent ? &node->parent->node : NULL;
+	}
+	return false;
+}
+
+static struct card *
+card_at(double lx, double ly, int *part)
+{
+	struct card *card;
+	wl_list_for_each_reverse(card, &ov.cards, link) {
+		if (card->closing) {
+			continue;
+		}
+		int x, y;
+		wlr_scene_node_coords(&card->tree->node, &x, &y);
+		if (lx < x || ly < y || lx >= x + card->width || ly >= y + card->height) {
+			continue;
+		}
+		*part = 0;
+		for (int i = 0; i < card->nr_parts; i++) {
+			struct part *p = &card->parts[i];
+			if (lx >= x + p->fx * card->width && ly >= y + p->fy * card->height) {
+				*part = i;
+			}
+		}
+		return card;
+	}
+	return NULL;
+}
+
+bool
+overview_press(double lx, double ly, uint32_t time_msec)
+{
+	if (!overview_active()) {
+		return false;
+	}
+	if (!on_overview(lx, ly)) {
+		finish(NULL);
+		return false;
+	}
+	int part;
+	ov.press.down = true;
+	ov.press.moved = false;
+	ov.press.drag = DRAG_UNDECIDED;
+	ov.press.card = ov.state == TRACKING ? NULL : card_at(lx, ly, &part);
+	ov.press.x0 = ov.press.x = lx;
+	ov.press.y0 = ov.press.y = ly;
+	ov.press.scroll0 = ov.scroll;
+	ov.press.velocity = 0;
+	ov.press.last_time = time_msec;
+	return true;
+}
+
+void
+overview_motion(double lx, double ly, uint32_t time_msec)
+{
+	if (!ov.press.down) {
+		return;
+	}
+	ov.press.x = lx;
+	ov.press.y = ly;
+	double dx = lx - ov.press.x0, dy = ly - ov.press.y0;
+	if (ov.press.drag == DRAG_UNDECIDED) {
+		if (hypot(dx, dy) < 10) {
+			return;
+		}
+		ov.press.moved = true;
+		bool vertical = fabs(dy) > fabs(dx);
+		bool scrolls = ov.scroll_max > 0 && vertical != ov.row;
+		if (scrolls) {
+			ov.press.drag = DRAG_SCROLL;
+		} else if (ov.press.card && vertical && dy < 0) {
+			ov.press.drag = DRAG_LIFT;
+			wlr_scene_node_raise_to_top(&ov.press.card->tree->node);
+		} else {
+			ov.press.drag = DRAG_NONE;
+		}
+		ov.press.last_pos = ov.row == (ov.press.drag == DRAG_SCROLL) ? lx : ly;
+		ov.press.last_time = time_msec;
+	}
+	double pos = ov.row == (ov.press.drag == DRAG_SCROLL) ? lx : ly;
+	uint32_t elapsed = time_msec - ov.press.last_time;
+	if (elapsed > 0) {
+		double v = (pos - ov.press.last_pos) * 1000.0 / elapsed;
+		ov.press.velocity = ov.press.velocity * 0.5 + v * 0.5;
+		ov.press.last_pos = pos;
+		ov.press.last_time = time_msec;
+	}
+	if (ov.press.drag == DRAG_SCROLL) {
+		ov.scroll = clamp(ov.press.scroll0 - (ov.row ? dx : dy), 0, ov.scroll_max);
+		ov.scroll_target = ov.scroll;
+	} else if (ov.press.drag == DRAG_LIFT && ov.press.card) {
+		ov.press.card->lift = fmax(0, -dy);
+	}
+	redraw();
+}
+
+void
+overview_release(uint32_t time_msec)
+{
+	if (!ov.press.down) {
+		return;
+	}
+	ov.press.down = false;
+	struct card *card = ov.press.card;
+	if (!ov.press.moved) {
+		int part = 0;
+		struct card *hit = card_at(ov.press.x, ov.press.y, &part);
+		if (hit && hit == card) {
+			choose(hit, part);
+		} else if (!card) {
+			finish(NULL);
+		}
+		return;
+	}
+	/* A finger that rested before lifting has no speed left. */
+	double velocity = time_msec - ov.press.last_time > 80 ? 0 : ov.press.velocity;
+	if (ov.press.drag == DRAG_LIFT && card) {
+		if (card->lift > card->height * 0.3 || (velocity < -500 && card->lift > 20)) {
+			card->lift_velocity = fmax(-velocity, 0);
+			close_card(card);
+		}
+	} else if (ov.press.drag == DRAG_SCROLL && ov.row) {
+		int index = row_index_at(ov.scroll);
+		if (velocity < -300 && row_scroll_for(index) <= ov.scroll) {
+			index++;
+		} else if (velocity > 300 && row_scroll_for(index) >= ov.scroll) {
+			index--;
+		}
+		index = clamp(index, 0, nr_cards() - 1);
+		ov.scroll_target = row_scroll_for(index);
+		if (ov.keyboard) {
+			ov.selected = card_at_index(index);
+		}
+		update_dots();
+	}
+	redraw();
+}
+
+void
+overview_press_cancel(void)
+{
+	ov.press.down = false;
+	if (ov.row && ov.state != CLOSED) {
+		ov.scroll_target = row_scroll_for(row_index_at(ov.scroll));
+	}
+	redraw();
+}
+
+void
+overview_scroll(double delta)
+{
+	if (ov.state != OPEN && ov.state != OPENING) {
+		return;
+	}
+	if (ov.row) {
+		int index = row_index_at(ov.scroll_target) + (delta > 0 ? 1 : -1);
+		ov.scroll_target = row_scroll_for(clamp(index, 0, nr_cards() - 1));
+		update_dots();
+	} else {
+		ov.scroll_target = clamp(ov.scroll_target + delta, 0, ov.scroll_max);
+	}
+	redraw();
+}
+
+bool
+overview_handle_key(xkb_keysym_t sym)
+{
+	if (!overview_active() || ov.state == TRACKING) {
+		return false;
+	}
+	int count = nr_cards();
+	int index = ov.selected ? card_index(ov.selected) : -1;
+	int step = 0;
+	switch (sym) {
+	case XKB_KEY_Escape:
+		finish(NULL);
+		return true;
+	case XKB_KEY_Return:
+	case XKB_KEY_KP_Enter:
+	case XKB_KEY_space:
+		if (ov.selected && ov.keyboard) {
+			choose(ov.selected, 0);
+		} else {
+			finish(NULL);
+		}
+		return true;
+	case XKB_KEY_Delete:
+	case XKB_KEY_BackSpace:
+		if (ov.selected && ov.keyboard) {
+			close_card(ov.selected);
+		}
+		return true;
+	case XKB_KEY_Right:
+	case XKB_KEY_Tab:
+		step = 1;
+		break;
+	case XKB_KEY_Left:
+	case XKB_KEY_ISO_Left_Tab:
+		step = -1;
+		break;
+	case XKB_KEY_Down:
+		step = ov.row ? 1 : ov.grid.cols;
+		break;
+	case XKB_KEY_Up:
+		step = ov.row ? -1 : -ov.grid.cols;
+		break;
+	default:
+		return false;
+	}
+	if (!ov.keyboard || index < 0) {
+		/* The first key only shows where the keys are. */
+		ov.keyboard = true;
+		index = ov.row ? row_index_at(ov.scroll_target) : 0;
+	} else if (sym == XKB_KEY_Tab || sym == XKB_KEY_ISO_Left_Tab) {
+		index = (index + step + count) % count;
+	} else if (index + step >= 0 && index + step < count) {
+		index += step;
+	} else if (sym == XKB_KEY_Down && index / ov.grid.cols < (count - 1) / ov.grid.cols) {
+		/* The last row is short: go to its end. */
+		index = count - 1;
+	}
+	select_card(card_at_index(index));
+	redraw();
+	return true;
+}
+
+/*
+ * Four fingers
+ */
+
+static double
+gesture_distance(void)
+{
+	return fmax(120, ov.box.height * 0.3);
+}
+
+bool
+overview_gesture_begin(struct output *output, bool towards_overview)
+{
+	bool open = ov.state == OPEN || ov.state == OPENING;
+	ov.gesture.pending = false;
+	if (ov.state == TRACKING || (open && towards_overview)
+			|| (!open && !towards_overview)) {
+		return false;
+	}
+	bool live = open ? ov.live : rc.overview_live == LAB_STATE_ENABLED
+		|| (rc.overview_live != LAB_STATE_DISABLED
+			&& !wlr_renderer_is_pixman(server.renderer));
+	if (!open) {
+		if (ov.state == CLOSING) {
+			destroy();
+		}
+		if (server.input_mode != LAB_INPUT_STATE_PASSTHROUGH || locked()) {
+			return false;
+		}
+		if (!live) {
+			/* Opens once the fingers have gone far enough. */
+			if (!count_views()) {
+				return begin(output, false, OPENING);
+			}
+			ov.output = output;
+			ov.gesture.pending = true;
+			ov.gesture.towards = true;
+			return true;
+		}
+		if (!begin(output, false, TRACKING)) {
+			return false;
+		}
+	} else if (!live) {
+		ov.gesture.pending = true;
+		ov.gesture.towards = false;
+		return true;
+	}
+	overview_press_cancel();
+	ov.state = TRACKING;
+	ov.gesture.base = ov.progress;
+	ov.gesture.velocity = 0;
+	ov.gesture.last_progress = ov.progress;
+	ov.gesture.last_time = 0;
+	return true;
+}
+
+void
+overview_gesture_update(double travel, uint32_t time_msec)
+{
+	if (ov.gesture.pending) {
+		if (ov.gesture.towards && travel >= OVERVIEW_SWIPE_COMMIT) {
+			struct output *output = ov.output;
+			ov.gesture.pending = false;
+			ov.output = NULL;
+			begin(output, false, OPENING);
+		} else if (!ov.gesture.towards && travel <= -OVERVIEW_SWIPE_COMMIT) {
+			ov.gesture.pending = false;
+			finish(NULL);
+		}
+		return;
+	}
+	if (ov.state != TRACKING) {
+		return;
+	}
+	ov.progress = clamp(ov.gesture.base + travel / gesture_distance(), 0, 1);
+	if (ov.gesture.last_time && time_msec != ov.gesture.last_time) {
+		double v = (ov.progress - ov.gesture.last_progress) * 1000.0
+			/ (uint32_t)(time_msec - ov.gesture.last_time);
+		ov.gesture.velocity = ov.gesture.velocity * 0.5 + v * 0.5;
+	}
+	ov.gesture.last_progress = ov.progress;
+	ov.gesture.last_time = time_msec;
+	redraw();
+}
+
+void
+overview_gesture_end(void)
+{
+	if (ov.gesture.pending) {
+		ov.gesture.pending = false;
+		if (ov.state == CLOSED) {
+			ov.output = NULL;
+		}
+		return;
+	}
+	if (ov.state != TRACKING) {
+		return;
+	}
+	if (overview_swipe_settle(ov.progress, ov.gesture.velocity)) {
+		ov.state = OPENING;
+		ov.target = 1;
+		ov.last_tick = now();
+	} else {
+		ov.state = OPEN;
+		finish(NULL);
+		ov.last_tick = now();
+	}
+	redraw();
+}
