diff --git a/include/overview-math.h b/include/overview-math.h
new file mode 100644
index 0000000..80e4dad
--- /dev/null
+++ b/include/overview-math.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_OVERVIEW_MATH_H
+#define LABWC_OVERVIEW_MATH_H
+#include <math.h>
+#include <stdbool.h>
+
+/*
+ * The parts of the overview that are plain arithmetic: where the cards go
+ * and when four fingers mean it. Kept free of compositor state so they can
+ * be tested on their own.
+ */
+
+/* Past this many windows the grid stops shrinking and scrolls instead. */
+#define OVERVIEW_MAX_FIT 20
+
+struct overview_grid {
+	int cols, rows;
+	/* The picture area of one cell; the label sits below it. */
+	double pic_width, pic_height;
+};
+
+/*
+ * The grid that shows @count windows of the usual @aspect (width / height)
+ * as large as possible in @width x @height. Every cell needs @gap around it
+ * and @label_height below its picture.
+ */
+static inline struct overview_grid
+overview_grid(int count, double width, double height, double aspect,
+		double gap, double label_height)
+{
+	struct overview_grid best = {0};
+	if (count <= 0 || aspect <= 0) {
+		return best;
+	}
+	int fit = count < OVERVIEW_MAX_FIT ? count : OVERVIEW_MAX_FIT;
+	for (int cols = 1; cols <= fit; cols++) {
+		int rows = (fit + cols - 1) / cols;
+		double cell_w = (width - (cols + 1) * gap) / cols;
+		double cell_h = (height - (rows + 1) * gap) / rows - label_height;
+		if (cell_w <= 0 || cell_h <= 0) {
+			continue;
+		}
+		double pic_w = fmin(cell_w, cell_h * aspect);
+		/* One or two windows are not blown up to the whole screen. */
+		pic_w = fmin(pic_w, fmin(width * 0.6, height * 0.6 * aspect));
+		/* On a tie the wider grid wins: fewer rows to read. */
+		if (pic_w > best.pic_width + 0.5) {
+			best = (struct overview_grid){
+				.cols = cols, .rows = rows,
+				.pic_width = pic_w, .pic_height = pic_w / aspect,
+			};
+		}
+	}
+	if (best.cols) {
+		best.rows = (count + best.cols - 1) / best.cols;
+	}
+	return best;
+}
+
+/* How many cells row @row of the grid holds; the last row may be short. */
+static inline int
+overview_grid_row_length(const struct overview_grid *grid, int count, int row)
+{
+	int before = row * grid->cols;
+	int left = count - before;
+	return left < grid->cols ? left : grid->cols;
+}
+
+enum overview_swipe {
+	OVERVIEW_SWIPE_WAIT,   /* not decided yet */
+	OVERVIEW_SWIPE_UP,     /* four fingers moved up together */
+	OVERVIEW_SWIPE_DOWN,   /* four fingers moved down together */
+	OVERVIEW_SWIPE_REJECT, /* something else: a sideways swipe, a pinch */
+};
+
+/* The move that makes a four-finger touch ours, in logical pixels. */
+#define OVERVIEW_SWIPE_CLAIM 16.0
+/* Software look: how far the fingers travel before the overview opens. */
+#define OVERVIEW_SWIPE_COMMIT 60.0
+
+/*
+ * @dx, @dy: how far the middle of the four fingers has moved (down is
+ * positive). @spread: how much the fingers' distance from that middle has
+ * changed, which is what tells a pinch from a swipe.
+ */
+static inline enum overview_swipe
+overview_swipe_decide(double dx, double dy, double spread)
+{
+	if (fabs(spread) > 40 || fabs(dx) > 40) {
+		return OVERVIEW_SWIPE_REJECT;
+	}
+	if (fabs(dy) < OVERVIEW_SWIPE_CLAIM || fabs(dy) < fabs(dx) * 1.5) {
+		return OVERVIEW_SWIPE_WAIT;
+	}
+	return dy < 0 ? OVERVIEW_SWIPE_UP : OVERVIEW_SWIPE_DOWN;
+}
+
+/*
+ * Where a released gesture settles: 1 is the overview, 0 the desktop.
+ * @progress: where the fingers left it; @velocity: progress per second at
+ * release, positive towards the overview. A flick decides; without one the
+ * nearer end wins.
+ */
+static inline int
+overview_swipe_settle(double progress, double velocity)
+{
+	if (velocity > 1.0) {
+		return 1;
+	}
+	if (velocity < -1.0) {
+		return 0;
+	}
+	return progress >= 0.5;
+}
+
+#endif /* LABWC_OVERVIEW_MATH_H */
diff --git a/include/overview.h b/include/overview.h
new file mode 100644
index 0000000..9d7248d
--- /dev/null
+++ b/include/overview.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_OVERVIEW_H
+#define LABWC_OVERVIEW_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <xkbcommon/xkbcommon.h>
+
+struct output;
+struct view;
+
+/*
+ * The overview: every window of the workspace side by side, to pick one.
+ *
+ * Opened by the ToggleOverview action, by `labwc --overview` and by a
+ * four-finger swipe up. It takes the keys that move in it and leaves every
+ * other one to its binding: a session that wants a button to close the
+ * overview binds it, and learns from openCommand and closeCommand whether
+ * the overview is open. With a hardware renderer the windows are live and
+ * shrink out of their places, following the fingers; with the software
+ * renderer they are pictures taken once, and desktop and overview crossfade.
+ */
+
+/* Open, or close if open. @keyboard: opened from a key, so mark a card. */
+void overview_toggle(bool keyboard);
+
+/* True while the overview takes the input (server.input_mode). */
+bool overview_active(void);
+
+/* Close at once without choosing a window: lock, reconfigure, rotation. */
+void overview_abort(void);
+
+/* Called for the output's every frame. */
+void overview_tick(struct output *output);
+
+/* A view was unmapped or destroyed / a new one was mapped. */
+void overview_on_view_gone(struct view *view);
+void overview_on_view_mapped(struct view *view);
+
+/* Returns true if the key was the overview's. */
+bool overview_handle_key(xkb_keysym_t sym);
+
+/*
+ * One finger (or the mouse button) in the open overview, in layout
+ * coordinates. overview_press() returns false if the point is not on the
+ * overview (a shell panel above it): the overview closes and the press is
+ * the panel's.
+ */
+bool overview_press(double lx, double ly, uint32_t time_msec);
+void overview_motion(double lx, double ly, uint32_t time_msec);
+void overview_release(uint32_t time_msec);
+void overview_press_cancel(void);
+void overview_scroll(double delta);
+
+/*
+ * Four fingers. @towards_overview is the direction they started in;
+ * returns false if there is nothing to do with it (no windows).
+ * @travel is how far they have moved towards the overview since, in
+ * logical pixels, negative for away from it.
+ */
+bool overview_gesture_begin(struct output *output, bool towards_overview);
+void overview_gesture_update(double travel, uint32_t time_msec);
+void overview_gesture_end(void);
+
+#endif /* LABWC_OVERVIEW_H */
