+
+static struct wlr_scene_buffer *
+create_shadow(struct wlr_scene_tree *parent, int width, int height)
+{
+	struct lab_data_buffer *buffer = buffer_create_cairo(width + 2 * SHADOW,
+		height + 2 * SHADOW, ov.output->wlr_output->scale);
+	if (!buffer) {
+		return NULL;
+	}
+	cairo_t *cairo = cairo_create(buffer->surface);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	for (int ring = 0; ring < SHADOW; ring++) {
+		double strength = (ring + 1) / (double)SHADOW;
+		cairo_set_source_rgba(cairo, 0, 0, 0, 0.4 * strength * strength);
+		cairo_rectangle(cairo, ring, ring, width + 2 * (SHADOW - ring),
+			height + 2 * (SHADOW - ring));
+		cairo_fill(cairo);
+	}
+	cairo_surface_flush(buffer->surface);
+	cairo_destroy(cairo);
+	struct wlr_scene_buffer *shadow = lab_wlr_scene_buffer_create(parent, &buffer->base);
+	wlr_buffer_drop(&buffer->base);
+	return shadow;
+}
+
+static bool
+view_wanted(struct view *view)
+{
+	return view->mapped && view->surface && view->content_tree
+		&& view->current.width > 0 && view->current.height > 0;
+}
+
+#define for_each_overview_view(view) \
+	for_each_view(view, &server.views, LAB_VIEW_CRITERIA_CURRENT_WORKSPACE \
+		| LAB_VIEW_CRITERIA_NO_DIALOG | LAB_VIEW_CRITERIA_NO_SKIP_WINDOW_SWITCHER)
+
+static int
+count_views(void)
+{
+	int count = 0;
+	struct view *view;
+	for_each_overview_view(view) {
+		count += view_wanted(view);
+	}
+	return count;
+}
+
+static enum lab_edge
+opposite(enum lab_edge edge)
+{
+	switch (edge) {
+	case LAB_EDGE_LEFT: return LAB_EDGE_RIGHT;
+	case LAB_EDGE_RIGHT: return LAB_EDGE_LEFT;
+	case LAB_EDGE_TOP: return LAB_EDGE_BOTTOM;
+	case LAB_EDGE_BOTTOM: return LAB_EDGE_TOP;
+	default: return LAB_EDGE_NONE;
+	}
+}
+
+static bool
+view_snapped(struct view *view)
+{
+	return !view->minimized && !view->fullscreen && !view->shaded
+		&& opposite(view->tiled) != LAB_EDGE_NONE;
+}
+
+static struct card *
+card_of(struct view *view, int *index)
+{
+	struct card *card;
+	wl_list_for_each(card, &ov.cards, link) {
+		for (int i = 0; i < card->nr_parts; i++) {
+			if (card->parts[i].view == view) {
+				if (index) {
+					*index = i;
+				}
+				return card;
+			}
+		}
+	}
+	return NULL;
+}
+
+/* Where the card's windows are on the desktop, and each one's share of it. */
+static void
+card_measure(struct card *card)
+{
+	struct wlr_box box = view_extents(card->parts[0].view);
+	for (int i = 1; i < card->nr_parts; i++) {
+		struct wlr_box geo = view_extents(card->parts[i].view);
+		int x1 = MAX(box.x + box.width, geo.x + geo.width);
+		int y1 = MAX(box.y + box.height, geo.y + geo.height);
+		box.x = MIN(box.x, geo.x);
+		box.y = MIN(box.y, geo.y);
+		box.width = x1 - box.x;
+		box.height = y1 - box.y;
+	}
+	card->from = box;
+	for (int i = 0; i < card->nr_parts; i++) {
+		struct part *part = &card->parts[i];
+		struct wlr_box geo = view_extents(part->view);
+		part->fx = (double)(geo.x - box.x) / box.width;
+		part->fy = (double)(geo.y - box.y) / box.height;
+		part->fw = (double)geo.width / box.width;
+		part->fh = (double)geo.height / box.height;
+		part->view_width = geo.width;
+		part->view_height = geo.height;
+		part->dirty = true;
+	}
+}
+
+static void
+card_add_part(struct card *card, struct view *view)
+{
+	struct part *part = &card->parts[card->nr_parts++];
+	*part = (struct part){ .view = view };
+	part->tree = lab_wlr_scene_tree_create(card->pictures);
+}
+
+static struct card *
+card_create(struct view *view, struct view *partner)
+{
+	struct theme *theme = rc.theme;
+	struct card *card = znew(*card);
+	wl_list_append(&ov.cards, &card->link);
+	card->minimized = view->minimized;
+	card->alpha = -1;
+
+	card->tree = lab_wlr_scene_tree_create(ov.cards_tree);
+	/* Cards come most recent first, and that one is in front. */
+	wlr_scene_node_lower_to_bottom(&card->tree->node);
+	/* Shadow first: everything else of the card is drawn over it. */
+	frame_create(&card->marker, card->tree, theme->osd_border_color, 2, 4);
+	wlr_scene_node_set_enabled(&card->marker.tree->node, false);
+	card->pictures = lab_wlr_scene_tree_create(card->tree);
+	card->shade = lab_wlr_scene_rect_create(card->tree, 1, 1, (float[4]){0});
+	wlr_scene_node_set_enabled(&card->shade->node, card->minimized);
+	frame_create(&card->hairline, card->tree,
+		theme->window[SSD_INACTIVE].border_color, 1, 1);
+
+	card_add_part(card, view);
+	if (partner) {
+		card_add_part(card, partner);
+	}
+	card_measure(card);
+
+	if (card->minimized) {
+		card->tag = lab_wlr_scene_tree_create(card->tree);
+		card->tag_bg = lab_wlr_scene_rect_create(card->tag, 1, 1, theme->osd_bg_color);
+		card->tag_text = scaled_font_buffer_create(card->tag);
+		scaled_font_buffer_update(card->tag_text, _("Minimised"), 400,
+			&rc.font_osd, theme->osd_label_text_color, (float[4]){0});
+		wlr_scene_rect_set_size(card->tag_bg, card->tag_text->width + 16,
+			card->tag_text->height + 8);
+		wlr_scene_node_set_position(&card->tag_text->scene_buffer->node, 8, 4);
+	}
+
+	card->label = lab_wlr_scene_tree_create(ov.labels);
+	return card;
+}
+
+static void
+card_destroy(struct card *card)
+{
+	if (ov.selected == card) {
+		ov.selected = NULL;
+	}
+	if (ov.press.card == card) {
+		ov.press.card = NULL;
+		ov.press.drag = DRAG_NONE;
+	}
+	wl_list_remove(&card->link);
+	wlr_scene_node_destroy(&card->tree->node);
+	wlr_scene_node_destroy(&card->label->node);
+	free(card);
+}
+
+static const char *
+app_name(struct view *view)
+{
+	const char *name = NULL;
+#if HAVE_LIBSFDO
+	name = desktop_entry_name_lookup(view->app_id);
+#endif
+	if (!name || !*name) {
+		name = view->app_id;
+	}
+	return name && *name ? name : view->title;
+}
+
+static int
+label_add_text(struct card *card, int x, const char *text, int max_width,
+		struct font *font, const float *color)
+{
+	if (max_width < 24 || !text || !*text) {
+		return x;
+	}
+	struct scaled_font_buffer *buffer = scaled_font_buffer_create(card->label);
+	scaled_font_buffer_update(buffer, text, max_width, font, color, (float[4]){0});
+	wlr_scene_node_set_position(&buffer->scene_buffer->node, x,
+		(TILE - buffer->height) / 2);
+	return x + buffer->width;
+}
+
+static int
+label_add_app(struct card *card, int x, struct view *view, int max_width)
+{
+	struct theme *theme = rc.theme;
+	struct wlr_scene_rect *tile =
+		lab_wlr_scene_rect_create(card->label, TILE, TILE, theme->osd_bg_color);
+	wlr_scene_node_set_position(&tile->node, x, 0);
+	struct scaled_icon_buffer *icon = scaled_icon_buffer_create(card->label, ICON, ICON);
+	scaled_icon_buffer_set_view(icon, view);
+	wlr_scene_node_set_position(&icon->scene_buffer->node,
+		x + (TILE - ICON) / 2, (TILE - ICON) / 2);
+	x += TILE + 10;
+	struct font bold = rc.font_osd;
+	bold.weight = PANGO_WEIGHT_BOLD;
+	return label_add_text(card, x, app_name(view), max_width - TILE - 10, &bold,
+		theme->osd_label_text_color);
+}
+
+/* The line under (on a phone: over) a card: icon, app name, maybe the title. */
+static void
+card_build_label(struct card *card, int max_width)
+{
+	struct theme *theme = rc.theme;
+	struct wlr_scene_node *child, *tmp;
+	wl_list_for_each_safe(child, tmp, &card->label->children, link) {
+		wlr_scene_node_destroy(child);
+	}
+	float soft[4];
+	for (int i = 0; i < 4; i++) {
+		soft[i] = theme->osd_label_text_color[i] * 0.6f;
+	}
+	int share = max_width / card->nr_parts;
+	int x = 0;
+	for (int i = 0; i < card->nr_parts; i++) {
+		if (i > 0) {
+			x = label_add_text(card, x + 12, "+", 40, &rc.font_osd, soft) + 12;
+		}
+		x = label_add_app(card, x, card->parts[i].view, share - (i > 0 ? 40 : 0));
+	}
+	const char *title = card->nr_parts == 1 ? card->parts[0].view->title : NULL;
+	if (card->attention) {
+		struct view *dialog = view_get_modal_dialog(card->parts[0].view);
+		char text[256];
+		if (dialog && *dialog->title && ov.titles) {
+			snprintf(text, sizeof(text), "· %s  %s", dialog->title,
+				_("Tap to answer"));
+		} else {
+			snprintf(text, sizeof(text), "· %s", _("Tap to answer"));
+		}
+		x = label_add_text(card, x + 10, text, max_width - x - 10, &rc.font_osd,
+			theme->overview_attention_color);
+	} else if (ov.titles && title && *title && strcmp(title, app_name(card->parts[0].view))) {
+		char text[256];
+		snprintf(text, sizeof(text), "· %s", title);
+		x = label_add_text(card, x + 10, text, max_width - x - 10, &rc.font_osd, soft);
+	}
+	card->label_width = x;
+	card->alpha = -1;
+}
