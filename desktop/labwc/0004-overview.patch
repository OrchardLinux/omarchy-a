+static int
+nr_cards(void)
+{
+	return wl_list_length(&ov.cards);
+}
+
+static int
+card_index(struct card *wanted)
+{
+	int index = 0;
+	struct card *card;
+	wl_list_for_each(card, &ov.cards, link) {
+		if (card == wanted) {
+			return index;
+		}
+		index++;
