+#define TITLES_FROM_WIDTH 220
+#define DIM 0.65
+#define MAX_MIRRORS 64
+
+/* Seconds */
+#define CROSSFADE 0.2
+#define CLOSE_WAIT 0.9
+
+enum state {
+	CLOSED = 0,
+	OPENING,  /* on its way to the overview */
+	OPEN,
+	TRACKING, /* follows four fingers */
+	CLOSING,  /* on its way back to the desktop; input is released */
+};
+
+struct frame {
+	struct wlr_scene_tree *tree;
+	struct wlr_scene_rect *side[4];
+	float color[4];
+	int thickness, outset;
+};
+
+/*
+ * One piece of a live window (a surface, or a part of its title bar and
+ * border), shown a second time at card size.
+ */
+struct mirror {
+	struct wlr_scene_buffer *node;   /* a picture, or */
+	struct wlr_scene_rect *rect;     /* a plain rectangle */
+	struct wlr_scene_node *source;   /* compared, never dereferenced */
+	struct wlr_buffer *shown;        /* likewise */
+	uint32_t seq;
+	float color[4];
+	int x, y, width, height;         /* within the window */
+	int buffer_width, buffer_height;
+	struct wlr_fbox src;
+	enum wl_output_transform transform;
+};
+
+/* One window's picture. A card has two for a pair snapped side by side. */
+struct part {
+	struct view *view;
+	double fx, fy, fw, fh; /* its place in the card, as fractions */
+	int view_width, view_height; /* with title bar and border */
+	struct wlr_scene_tree *tree;
+	struct wlr_scene_buffer *snapshot;
+	int snapshot_width, snapshot_height;
+	struct mirror mirrors[MAX_MIRRORS];
+	int nr_mirrors;
+	bool dirty;
+};
+
+struct card {
+	struct wl_list link;
+	struct part parts[2];
+	int nr_parts;
+
+	struct wlr_box from;       /* where the window really is */
+	double tx, ty, tw, th;     /* its place in the grid */
+	double sx, sy, sw, sh;     /* the same, eased when the grid changes */
+	bool placed;
+	int width, height;         /* as last drawn */
+	float alpha;
+
+	bool minimized;
+	bool closing;              /* asked to close, hidden meanwhile */
+	bool attention;            /* did not close: the app asks something */
+	bool flying;
+	double close_deadline;
+	double lift;               /* pulled up this far by a finger */
+	double lift_velocity;
+
+	struct wlr_scene_tree *tree;
+	struct wlr_scene_buffer *shadow;
+	struct wlr_scene_tree *pictures;
+	struct wlr_scene_rect *shade; /* minimised: the picture at half strength */
+	struct frame hairline, marker;
+	struct wlr_scene_tree *tag;
+	struct wlr_scene_rect *tag_bg;
+	struct scaled_font_buffer *tag_text;
+
+	struct wlr_scene_tree *label;
+	int label_width;
+};
+
+static struct {
+	enum state state;
+	struct output *output;
+	struct wlr_box box;  /* the output, in layout coordinates */
+	struct wlr_box area; /* what the shell leaves free of it */
+	bool live;           /* live windows that move, or pictures that fade */
+	bool row;            /* a phone: one row of large cards */
+	bool keyboard;       /* show which card the keys are on */
+	bool titles;
+
+	struct wlr_scene_tree *tree, *labels, *cards_tree, *dots;
+	struct wlr_scene_rect *dim;
+	struct wl_list cards;
+	struct card *selected;
+	struct overview_grid grid;
+
+	double progress, target; /* 0: the desktop, 1: the overview */
+	double scroll, scroll_target, scroll_max;
+	double last_tick;
+
