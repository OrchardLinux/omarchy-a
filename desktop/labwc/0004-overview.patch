 #include <wlr/types/wlr_cursor.h>
@@ -24,6 +25,8 @@
 #include "layers.h"
 #include "node.h"
 #include "output.h"
+#include "overview.h"
+#include "overview-math.h"
 #include "session-lock.h"
 #include "ssd.h"
 #include "view.h"
@@ -41,8 +44,24 @@ struct touch_point {
 	bool mouse_deferred;
 	double start_x, start_y; /* device-normalized coordinates for mouse replay */
 	uint32_t start_time;
+	double lx, ly;           /* where the finger is now, in layout coordinates */
+	double four_lx, four_ly; /* where it was when the fourth finger landed */
 };
 
+/* Four fingers moving up or down together open and close the overview. */
+static struct {
+	bool tracking; /* four fingers are down and may still mean it */
+	bool claimed;  /* they do: the overview follows them */
+	bool towards;  /* started upwards, towards the overview */
+	struct output *output;
+} four;
+
+/* The one finger that taps, drags or flicks in the open overview. */
+static struct {
+	bool active;
+	int32_t touch_id;
+} overview_finger;
+
 static struct wlr_surface *
 touch_get_coords(struct seat *seat, struct wlr_touch *touch, double x, double y,
 		double *x_offset, double *y_offset)
@@ -172,6 +191,120 @@ cancel_touch_client(struct seat *seat, struct touch_point *point)
 	point->mouse_deferred = false;
 }
 
+static void
+four_middle(struct seat *seat, bool start, double *x, double *y, double *spread)
+{
+	*x = *y = *spread = 0;
+	struct touch_point *point;
+	wl_list_for_each(point, &seat->touch_points, link) {
+		*x += (start ? point->four_lx : point->lx) / 4;
+		*y += (start ? point->four_ly : point->ly) / 4;
+	}
+	wl_list_for_each(point, &seat->touch_points, link) {
+		*spread += hypot((start ? point->four_lx : point->lx) - *x,
+			(start ? point->four_ly : point->ly) - *y) / 4;
+	}
+}
+
+static void
+four_fingers_stop(void)
+{
+	if (four.claimed) {
+		overview_gesture_end();
+	}
+	four.tracking = false;
+	four.claimed = false;
+}
+
+/*
+ * Take the touch from whoever has it. This happens as soon as the fourth
+ * finger is down, not when the fingers have shown where they are going: an
+ * application would use the way there for a gesture of its own (a browser
+ * zooms its page).
+ */
+static void
+four_fingers_claim(struct seat *seat, uint32_t time_msec)
+{
+	struct touch_point *point;
+	wl_list_for_each(point, &seat->touch_points, link) {
+		if (point->consumed) {
+			continue;
+		}
+		if (point->surface) {
+			cancel_touch_client(seat, point);
+			continue;
+		}
+		if (!point->mouse_deferred) {
+			cursor_emulate_button(seat, BTN_LEFT,
+				WL_POINTER_BUTTON_STATE_RELEASED, time_msec);
+			ssd_update_hovered_button(NULL);
+		}
+		point->consumed = true;
+		point->swipe.pending = false;
+		point->mouse_deferred = false;
+	}
+}
+
+/* Called with the new finger already in seat->touch_points. */
+static void
+four_fingers_down(struct seat *seat, struct touch_point *newest, uint32_t time_msec)
+{
+	int count = wl_list_length(&seat->touch_points);
+	if (count != 4) {
+		/* A fifth finger, or fewer again: not this gesture. */
+		if (count > 4) {
+			four_fingers_stop();
+		}
+		return;
+	}
+	if (!rc.overview_swipe || bottom_swipe_locked()
+			|| (server.input_mode != LAB_INPUT_STATE_PASSTHROUGH
+				&& server.input_mode != LAB_INPUT_STATE_OVERVIEW)) {
+		return;
+	}
+	struct touch_point *point;
+	wl_list_for_each(point, &seat->touch_points, link) {
+		point->four_lx = point->lx;
+		point->four_ly = point->ly;
+	}
+	four.tracking = true;
+	four.claimed = false;
+	overview_finger.active = false;
+	/* The fourth finger has not been shown to anyone yet. */
+	newest->consumed = true;
+	four_fingers_claim(seat, time_msec);
+}
+
+/* Returns true while the four fingers are the overview's. */
+static bool
+four_fingers_motion(struct seat *seat, uint32_t time_msec)
+{
+	if (!four.tracking || wl_list_length(&seat->touch_points) != 4) {
+		return false;
+	}
+	double x0, y0, spread0, x, y, spread;
+	four_middle(seat, true, &x0, &y0, &spread0);
+	four_middle(seat, false, &x, &y, &spread);
+	if (!four.claimed) {
+		enum overview_swipe swipe =
+			overview_swipe_decide(x - x0, y - y0, spread - spread0);
+		if (swipe == OVERVIEW_SWIPE_WAIT) {
+			return false;
+		}
+		bottom_swipe_output(x0, y0, &four.output);
+		four.towards = swipe == OVERVIEW_SWIPE_UP;
+		if (swipe == OVERVIEW_SWIPE_REJECT || !four.output || bottom_swipe_locked()
+				|| !overview_gesture_begin(four.output, four.towards)) {
+			four.tracking = false;
+			return false;
+		}
+		four.claimed = true;
+	}
+	/* Up is towards the overview. */
+	overview_gesture_update(y0 - y, time_msec);
+	return true;
+}
+
 static bool
 handle_bottom_swipe_motion(struct seat *seat, struct touch_point *point,
 		struct wlr_touch_motion_event *event)
@@ -218,13 +351,22 @@ handle_touch_motion(struct wl_listener *listener, void *data)
 		if (touch_point->touch_id != event->touch_id) {
 			continue;
 		}
+		double lx, ly;
+		wlr_cursor_absolute_to_layout_coords(seat->cursor,
+			&event->touch->base, event->x, event->y, &lx, &ly);
+		touch_point->lx = lx;
+		touch_point->ly = ly;
+		if (four_fingers_motion(seat, event->time_msec)) {
