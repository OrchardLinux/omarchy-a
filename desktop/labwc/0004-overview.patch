+		enum { DRAG_UNDECIDED, DRAG_NONE, DRAG_SCROLL, DRAG_LIFT } drag;
+		struct card *card;
+		double x0, y0, x, y;
+		double scroll0;
+		double velocity; /* along the drag, logical pixels per second */
+		double last_pos;
+		uint32_t last_time;
+	} press;
+} ov;
+
+/*
+ * Software look: the change between desktop and overview is one crossfade.
+ * The picture that was on screen stays on top and fades away over the new
+ * one, which is complete below it from the start. Moving and scaling every
+ * window for every frame is more than a processor can draw smoothly; one
+ * picture at its own size with a changing opacity it can.
+ */
+static struct {
+	struct wlr_scene_buffer *node;
+	struct output *output;
+	double began; /* 0 until its first frame: preparing must not eat the fade */
+} cover;
+
+static void finish(struct view *chosen);
+static void destroy(void);
+
+static bool
+cover_accepts_input(struct wlr_scene_buffer *buffer, double *x, double *y)
+{
+	return false;
+}
+
+static void
+cover_remove(void)
+{
+	if (cover.node) {
+		wlr_scene_node_destroy(&cover.node->node);
+	}
+	cover.node = NULL;
+	cover.output = NULL;
+}
+
+/* Keep what @output shows now on screen, just above @above in the scene. */
+static void
+cover_begin(struct output *output, struct wlr_scene_node *above)
+{
+	cover_remove();
+	if (!output->rotation_last_frame) {
+		return;
+	}
+	struct wlr_box box;
+	wlr_output_layout_get_box(server.output_layout, output->wlr_output, &box);
+	cover.node = wlr_scene_buffer_create(&server.scene->tree,
+		output->rotation_last_frame);
+	if (!cover.node) {
+		return;
+	}
+	cover.output = output;
+	cover.began = 0;
+	cover.node->point_accepts_input = cover_accepts_input;
+	wlr_scene_node_place_above(&cover.node->node, above);
+	wlr_scene_node_set_position(&cover.node->node, box.x, box.y);
+	wlr_scene_buffer_set_dest_size(cover.node, box.width, box.height);
+	/* As for the rotation cover: the scene inverts this when it draws. */
+	wlr_scene_buffer_set_transform(cover.node, output->wlr_output->transform);
+	wlr_output_schedule_frame(output->wlr_output);
+}
+
+static void
+cover_tick(struct output *output, double time)
+{
+	if (!cover.node || cover.output != output) {
+		return;
+	}
+	if (!cover.began) {
+		cover.began = time;
+	}
+	double t = (time - cover.began) / CROSSFADE;
+	if (t >= 1 || (server.session_lock_manager && server.session_lock_manager->locked)) {
+		cover_remove();
+	} else {
+		wlr_scene_buffer_set_opacity(cover.node, (float)(1 - t * t * (3 - 2 * t)));
+	}
+	wlr_output_schedule_frame(output->wlr_output);
+}
+
+static double
+now(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec + ts.tv_nsec / 1000000000.0;
+}
+
+static double
+clamp(double value, double low, double high)
+{
+	return value < low ? low : value > high ? high : value;
+}
+
+static double
+approach(double value, double target, double dt, double rate)
+{
+	double next = value + (target - value) * (1 - exp(-dt * rate));
+	return fabs(target - next) < 0.002 * fmax(1, fabs(target)) ? target : next;
+}
+
+static void
+redraw(void)
+{
+	if (ov.output) {
+		wlr_output_schedule_frame(ov.output->wlr_output);
+	}
+}
+
+static bool
+locked(void)
+{
+	return server.session_lock_manager && server.session_lock_manager->locked;
+}
+
+static void
+set_rect_color(struct wlr_scene_rect *rect, const float color[4], float alpha)
+{
+	float faded[4] = {
+		color[0] * alpha, color[1] * alpha, color[2] * alpha, color[3] * alpha,
+	};
+	wlr_scene_rect_set_color(rect, faded);
+}
+
+/* Every picture below @node gets @alpha. */
+static void
+set_tree_opacity(struct wlr_scene_node *node, float alpha)
+{
+	if (node->type == WLR_SCENE_NODE_BUFFER) {
+		wlr_scene_buffer_set_opacity(wlr_scene_buffer_from_node(node), alpha);
+	} else if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &wlr_scene_tree_from_node(node)->children, link) {
+			set_tree_opacity(child, alpha);
+		}
+	}
+}
+
+/*
+ * A rectangular outline around a box, @outset pixels outside it.
+ */
+static void
+frame_create(struct frame *frame, struct wlr_scene_tree *parent,
+		const float color[4], int thickness, int outset)
+{
+	frame->tree = lab_wlr_scene_tree_create(parent);
+	frame->thickness = thickness;
+	frame->outset = outset;
+	memcpy(frame->color, color, sizeof(frame->color));
+	for (int i = 0; i < 4; i++) {
+		frame->side[i] = lab_wlr_scene_rect_create(frame->tree, 1, 1, color);
+	}
+}
+
+static void
+frame_set(struct frame *frame, int width, int height, float alpha)
+{
+	int t = frame->thickness, o = frame->outset;
+	int w = width + 2 * o, h = height + 2 * o;
+	struct wlr_box sides[4] = {
+		{ -o, -o, w, t },             /* top */
+		{ -o, height + o - t, w, t }, /* bottom */
+		{ -o, -o + t, t, h - 2 * t }, /* left */
+		{ width + o - t, -o + t, t, h - 2 * t },
+	};
+	for (int i = 0; i < 4; i++) {
+		wlr_scene_node_set_position(&frame->side[i]->node, sides[i].x, sides[i].y);
+		wlr_scene_rect_set_size(frame->side[i],
+			MAX(1, sides[i].width), MAX(1, sides[i].height));
+		set_rect_color(frame->side[i], frame->color, alpha);
+	}
+}
+
+static void
+frame_set_color(struct frame *frame, const float color[4])
+{
+	memcpy(frame->color, color, sizeof(frame->color));
+}
+
+/*
+ * Window pictures
+ */
+
+struct source {
+	struct wlr_scene_buffer *buffer; /* or */
+	struct wlr_scene_rect *rect;
+	struct wlr_buffer *content;      /* what the buffer node shows */
+	int x, y;
+};
+
+/*
+ * A hardware renderer keeps only the texture of a picture that is the
+ * compositor's own and lets go of the buffer; the scene node then has none
+ * to copy. That happens to the title bar's background (its text and buttons
+ * are held elsewhere), which the theme still has.
+ */
+static struct wlr_buffer *
+released_content(struct view *view, struct wlr_scene_buffer *buffer)
+{
+	if (!view->ssd) {
+		return NULL;
+	}
+	enum ssd_active_state active;
+	FOR_EACH_ACTIVE_STATE(active) {
+		struct ssd_titlebar_subtree *subtree = &view->ssd->titlebar.subtrees[active];
+		struct lab_data_buffer *held = NULL;
+		if (buffer == subtree->bar) {
+			held = rc.theme->window[active].titlebar_fill;
+		} else if (buffer == subtree->corner_left) {
+			held = rc.theme->window[active].corner_top_left_normal;
+		} else if (buffer == subtree->corner_right) {
+			held = rc.theme->window[active].corner_top_right_normal;
+		}
+		if (held) {
+			return &held->base;
+		}
+	}
+	return NULL;
+}
+
+/* What a window is made of, back to front, in window coordinates. */
+static void
+collect_sources(struct view *view, struct wlr_scene_node *node, int x, int y,
+		struct source *sources, int *count)
+{
+	if (!node->enabled || *count >= MAX_MIRRORS) {
+		return;
+	}
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &wlr_scene_tree_from_node(node)->children, link) {
+			collect_sources(view, child, x + child->x, y + child->y,
+				sources, count);
+		}
+	} else if (node->type == WLR_SCENE_NODE_BUFFER) {
+		struct wlr_scene_buffer *buffer = wlr_scene_buffer_from_node(node);
+		struct wlr_buffer *content = buffer->buffer
+			? buffer->buffer : released_content(view, buffer);
+		if (content) {
+			sources[(*count)++] = (struct source){
+				.buffer = buffer, .content = content, .x = x, .y = y,
+			};
+		}
+	} else if (node->type == WLR_SCENE_NODE_RECT) {
+		struct wlr_scene_rect *rect = wlr_scene_rect_from_node(node);
+		if (rect->color[3] > 0 && rect->width > 0 && rect->height > 0) {
+			sources[(*count)++] = (struct source){ .rect = rect, .x = x, .y = y };
+		}
+	}
+}
+
+/* The window as it is drawn: its contents with title bar and border. */
+static struct wlr_box
+view_extents(struct view *view)
+{
+	struct wlr_box box = ssd_max_extents(view);
+	if (box.width <= 0 || box.height <= 0) {
+		box = view->current;
+	}
+	return box;
+}
+
+static int
+view_sources(struct view *view, struct source *sources)
+{
+	int count = 0;
+	/* The view's own tree is disabled while it is minimised: start below. */
+	struct wlr_box box = view_extents(view);
+	int x = view->current.x - box.x, y = view->current.y - box.y;
+	struct wlr_scene_node *child;
+	wl_list_for_each(child, &view->scene_tree->children, link) {
+		collect_sources(view, child, x + child->x, y + child->y, sources, &count);
+	}
+	return count;
+}
+
+static void
+source_size(const struct source *source, int *width, int *height)
+{
+	struct wlr_scene_buffer *buffer = source->buffer;
+	*width = buffer->dst_width;
+	*height = buffer->dst_height;
+	if (*width <= 0 || *height <= 0) {
+		bool turned = buffer->transform & WL_OUTPUT_TRANSFORM_90;
+		*width = turned ? source->content->height : source->content->width;
+		*height = turned ? source->content->width : source->content->height;
+	}
+}
+
+/*
+ * Software look: the window drawn once, at the size of its card, so that
+ * showing it afterwards is a plain copy.
+ */
+static struct wlr_buffer *
+render_snapshot(struct view *view, int width, int height)
+{
+	struct wlr_swapchain *swapchain = ov.output->wlr_output->swapchain;
+	struct wlr_box box = view_extents(view);
+	if (!swapchain || width <= 0 || height <= 0) {
+		return NULL;
+	}
+	struct wlr_buffer *buffer = wlr_allocator_create_buffer(server.allocator,
+		width, height, &swapchain->format);
+	if (!buffer) {
+		wlr_log(WLR_ERROR, "overview: no buffer for a window picture");
+		return NULL;
+	}
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(server.renderer, buffer, NULL);
+	if (!pass) {
+		wlr_buffer_drop(buffer);
+		return NULL;
+	}
+	float *bg = rc.theme->osd_bg_color;
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+		.box = { 0, 0, width, height },
+		.color = { bg[0], bg[1], bg[2], 1.0f },
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+	});
+	double kx = (double)width / box.width;
+	double ky = (double)height / box.height;
+	struct source sources[MAX_MIRRORS];
+	struct wlr_texture *made[MAX_MIRRORS];
+	int count = view_sources(view, sources), nr_made = 0;
+	for (int i = 0; i < count; i++) {
+		int w, h;
+		if (sources[i].rect) {
+			w = sources[i].rect->width;
+			h = sources[i].rect->height;
+		} else {
+			source_size(&sources[i], &w, &h);
+		}
+		int x0 = lround(sources[i].x * kx), y0 = lround(sources[i].y * ky);
+		int x1 = lround((sources[i].x + w) * kx), y1 = lround((sources[i].y + h) * ky);
+		struct wlr_box dst = { x0, y0, MAX(1, x1 - x0), MAX(1, y1 - y0) };
+		if (sources[i].rect) {
+			float *c = sources[i].rect->color;
+			wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+				.box = dst, .color = { c[0], c[1], c[2], c[3] },
+			});
+			continue;
+		}
+		struct wlr_scene_buffer *source = sources[i].buffer;
+		struct wlr_buffer *content = sources[i].content;
+		struct wlr_client_buffer *client = wlr_client_buffer_get(content);
+		struct wlr_texture *texture = client ? client->texture : NULL;
+		if (!client) {
+			/* The compositor's own: title text, buttons, icons. */
+			texture = wlr_texture_from_buffer(server.renderer, content);
+			if (texture) {
+				made[nr_made++] = texture;
+			}
+		}
+		if (!texture) {
+			continue;
+		}
+		wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+			.texture = texture,
+			.src_box = source->src_box,
+			.dst_box = dst,
+			.transform = source->transform,
+			.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+		});
+	}
+	bool ok = wlr_render_pass_submit(pass);
+	for (int i = 0; i < nr_made; i++) {
+		wlr_texture_destroy(made[i]);
+	}
+	if (!ok) {
+		wlr_buffer_drop(buffer);
+		return NULL;
+	}
+	return buffer;
+}
+
+static void
+part_snapshot(struct part *part, int width, int height)
+{
+	float scale = ov.output->wlr_output->scale;
+	int w = lround(width * scale), h = lround(height * scale);
+	if (part->snapshot && part->snapshot_width == w && part->snapshot_height == h) {
+		return;
+	}
+	struct wlr_buffer *buffer = render_snapshot(part->view, w, h);
+	if (!buffer) {
+		return;
+	}
+	if (!part->snapshot) {
+		part->snapshot = lab_wlr_scene_buffer_create(part->tree, buffer);
+	} else {
+		wlr_scene_buffer_set_buffer(part->snapshot, buffer);
+	}
+	wlr_buffer_drop(buffer);
+	part->snapshot_width = w;
+	part->snapshot_height = h;
+	part->dirty = true;
+}
+
+/* Hardware look: keep the card's copies of the window's pieces current. */
+static void
+part_sync_mirrors(struct part *part)
+{
+	struct source sources[MAX_MIRRORS];
+	int count = view_sources(part->view, sources);
+	bool same = count == part->nr_mirrors;
+	for (int i = 0; same && i < count; i++) {
+		same = part->mirrors[i].source == (sources[i].rect
+			? &sources[i].rect->node : &sources[i].buffer->node);
+	}
+	if (!same) {
+		for (int i = 0; i < part->nr_mirrors; i++) {
+			struct mirror *old = &part->mirrors[i];
+			wlr_scene_node_destroy(old->rect ? &old->rect->node : &old->node->node);
+		}
+		memset(part->mirrors, 0, sizeof(part->mirrors));
+		for (int i = 0; i < count; i++) {
+			struct mirror *mirror = &part->mirrors[i];
+			if (sources[i].rect) {
+				mirror->rect = lab_wlr_scene_rect_create(part->tree, 1, 1,
+					sources[i].rect->color);
+				mirror->source = &sources[i].rect->node;
+			} else {
+				mirror->node = lab_wlr_scene_buffer_create(part->tree, NULL);
+				mirror->source = &sources[i].buffer->node;
+			}
+		}
+		part->nr_mirrors = count;
+		part->dirty = true;
+	}
+	for (int i = 0; i < count; i++) {
+		struct mirror *mirror = &part->mirrors[i];
+		if (mirror->rect) {
+			struct wlr_scene_rect *source = sources[i].rect;
+			if (mirror->x != sources[i].x || mirror->y != sources[i].y
+					|| mirror->width != source->width
+					|| mirror->height != source->height
+					|| memcmp(mirror->color, source->color, sizeof(mirror->color))) {
+				mirror->x = sources[i].x;
+				mirror->y = sources[i].y;
+				mirror->width = source->width;
+				mirror->height = source->height;
+				memcpy(mirror->color, source->color, sizeof(mirror->color));
+				part->dirty = true;
+			}
+			continue;
+		}
+		struct wlr_scene_buffer *source = sources[i].buffer;
+		struct wlr_scene_surface *scene_surface =
+			wlr_scene_surface_try_from_buffer(source);
+		uint32_t seq = scene_surface ? scene_surface->surface->current.seq : 0;
+		struct wlr_buffer *content = sources[i].content;
+		if (mirror->shown != content || mirror->seq != seq) {
+			wlr_scene_buffer_set_buffer_with_damage(mirror->node, content, NULL);
+			mirror->shown = content;
+			mirror->seq = seq;
+		}
+		int w, h;
+		source_size(&sources[i], &w, &h);
+		if (mirror->x != sources[i].x || mirror->y != sources[i].y
+				|| mirror->width != w || mirror->height != h
+				|| mirror->transform != source->transform
+				|| memcmp(&mirror->src, &source->src_box, sizeof(mirror->src))
+				|| mirror->buffer_width != content->width
+				|| mirror->buffer_height != content->height) {
+			mirror->x = sources[i].x;
+			mirror->y = sources[i].y;
+			mirror->width = w;
+			mirror->height = h;
+			mirror->transform = source->transform;
+			mirror->src = source->src_box;
+			mirror->buffer_width = content->width;
+			mirror->buffer_height = content->height;
+			wlr_scene_buffer_set_transform(mirror->node, mirror->transform);
+			part->dirty = true;
+		}
+	}
+	struct wlr_box box = view_extents(part->view);
+	if (part->view_width != box.width || part->view_height != box.height) {
+		part->view_width = box.width;
+		part->view_height = box.height;
+		part->dirty = true;
+	}
+}
+
+/* Draw the part's pictures into a box of @width x @height. */
+static void
+part_place(struct part *part, int width, int height)
+{
+	if (part->snapshot) {
+		wlr_scene_buffer_set_dest_size(part->snapshot, width, height);
+	}
+	if (part->view_width <= 0 || part->view_height <= 0) {
+		return;
+	}
+	double kx = (double)width / part->view_width;
+	double ky = (double)height / part->view_height;
+	for (int i = 0; i < part->nr_mirrors; i++) {
+		struct mirror *mirror = &part->mirrors[i];
+		/* Only what lies inside the window: no client-side shadows. */
+		int x0 = MAX(mirror->x, 0), y0 = MAX(mirror->y, 0);
+		int x1 = MIN(mirror->x + mirror->width, part->view_width);
+		int y1 = MIN(mirror->y + mirror->height, part->view_height);
+		bool visible = x1 > x0 && y1 > y0 && mirror->width > 0 && mirror->height > 0;
+		struct wlr_scene_node *shown = mirror->rect
+			? &mirror->rect->node : &mirror->node->node;
+		wlr_scene_node_set_enabled(shown, visible);
+		if (!visible) {
+			continue;
+		}
+		if (mirror->rect) {
+			int left = lround(x0 * kx), top = lround(y0 * ky);
+			wlr_scene_node_set_position(shown, left, top);
+			wlr_scene_rect_set_size(mirror->rect,
+				MAX(1, (int)lround(x1 * kx) - left),
+				MAX(1, (int)lround(y1 * ky) - top));
+			continue;
+		}
+		struct wlr_fbox src = mirror->src;
+		bool cropped = x0 != mirror->x || y0 != mirror->y
+			|| x1 != mirror->x + mirror->width || y1 != mirror->y + mirror->height;
+		if (cropped && mirror->transform == WL_OUTPUT_TRANSFORM_NORMAL) {
+			if (wlr_fbox_empty(&src)) {
+				src = (struct wlr_fbox){
+					0, 0, mirror->buffer_width, mirror->buffer_height,
+				};
+			}
+			double px = src.width / mirror->width, py = src.height / mirror->height;
+			src.x += (x0 - mirror->x) * px;
+			src.y += (y0 - mirror->y) * py;
+			src.width = (x1 - x0) * px;
+			src.height = (y1 - y0) * py;
+		} else if (cropped) {
+			x0 = mirror->x;
+			y0 = mirror->y;
+			x1 = x0 + mirror->width;
+			y1 = y0 + mirror->height;
+		}
+		wlr_scene_buffer_set_source_box(mirror->node, &src);
+		int left = lround(x0 * kx), top = lround(y0 * ky);
+		wlr_scene_node_set_position(&mirror->node->node, left, top);
+		wlr_scene_buffer_set_dest_size(mirror->node,
+			MAX(1, (int)lround(x1 * kx) - left), MAX(1, (int)lround(y1 * ky) - top));
+	}
+}
