#!/usr/bin/env python3
"""Build common AArch64 desktop components and stage the pinned Omarchy UI."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from orchard_hardware.buildenv import native

HERE = Path(__file__).resolve().parent
INPUTS = HERE / 'arm64/inputs'
PINS = HERE / 'arm64/inputs.json'
FILES = {
    'omafox_xpi': INPUTS / '@omafox.xpi',
    'omacalc_package': INPUTS / 'omacalc.pkg.tar.zst',
}
KEYBOARD_PATH = 'home/tablet/.local/share/omarchy-ipad/trials/wvkbd-mobintl-v0.20-font18-special15-state'
XPI_PATH = 'usr/lib/firefox/distribution/extensions/@omafox.xpi'


def sha(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


def source_metadata(built):
    pins = json.loads((HERE / 'sources.json').read_text())
    if built['architecture'] != 'aarch64' or built['source_sha256'] != {
            name: entry['sha256'] for name, entry in pins.items()}:
        raise ValueError('Source-build pins differ')
    if any(built['source_urls'][name] not in entry['urls'] for name, entry in pins.items()):
        raise ValueError('Source-build URL differs')
    if (built['patch_sha256'] != sha(HERE / 'keyboard/wvkbd-0.20.patch') or
            built['pkgbuild_sha256'] != sha(HERE / 'packages/omafox/PKGBUILD')):
        raise ValueError('Source-build recipe differs')
    if set(built['files']) != {'wvkbd-mobintl', 'omafox.pkg.tar.xz'}:
        raise ValueError('Source-build files differ')
    return built['files']


def verify(directory):
    pins = json.loads(PINS.read_text())
    meta = json.loads((directory / 'manifest.json').read_text())
    lock = dict(line.split('=', 1) for line in (HERE / 'upstream.lock').read_text().splitlines() if '=' in line)
    if (meta['architecture'] != pins['architecture'] or
            meta['omarchy_commit'] != lock['omarchy_commit'] or
            meta['inputs'] != {name: pins[name] for name in FILES}):
        raise ValueError('Desktop input manifest differs')
    built_files = source_metadata(meta['source_build'])
    packages = directory / 'packages'
    if sha(packages / 'omafox.pkg.tar.xz') != built_files['omafox.pkg.tar.xz']:
        raise ValueError('Source-built Omafox package differs')
    if sha(packages / 'omacalc.pkg.tar.zst') != pins['omacalc_package']:
        raise ValueError('Signed Omacalc package differs')
    payload = directory / 'payload'
    manifest = payload / 'arch-ipad-ui-manifest.json'
    if sha(manifest) != meta['payload_manifest_sha256']:
        raise ValueError('Desktop UI manifest differs')
    contents = json.loads(manifest.read_text())
    for name, digest in contents.items():
        path = payload / name
        if path.is_symlink() or sha(path) != digest:
            raise ValueError(f'Desktop UI file differs: {name}')
    actual = {p.relative_to(payload).as_posix() for p in payload.rglob('*')
              if p.is_file() and not p.is_symlink()}
    if actual != set(contents) | {'arch-ipad-ui-manifest.json'}:
        raise ValueError('Desktop UI files differ from manifest')
    if sha(payload / KEYBOARD_PATH) != built_files['wvkbd-mobintl']:
        raise ValueError('Source-built keyboard differs')
    if sha(payload / XPI_PATH) != pins['omafox_xpi']:
        raise ValueError('Signed extension differs')
    return meta


def build(output):
    if output.exists():
        raise ValueError('Output already exists')
    pins = json.loads(PINS.read_text())
    for name, path in FILES.items():
        if sha(path) != pins[name]:
            raise ValueError(f'Pinned desktop input differs: {name}')
    lock = dict(line.split('=', 1) for line in (HERE / 'upstream.lock').read_text().splitlines() if '=' in line)
    commit = lock['omarchy_commit']
    if len(commit) != 40 or any(c not in '0123456789abcdef' for c in commit):
        raise ValueError('Invalid Omarchy commit pin')
    for tool in (('git', 'gpg') if native() else ('git', 'gpg', 'podman')):
        if shutil.which(tool) is None:
            raise RuntimeError(f'{tool} is required')
    (HERE / '.work').mkdir(exist_ok=True)
    # gpg's agent socket lives in its home directory, and socket paths are
    # limited to about 100 bytes: a deep checkout's .work/ is too long for it.
    with tempfile.TemporaryDirectory(prefix='desktop-', dir=HERE / '.work') as temporary, \
            tempfile.TemporaryDirectory(prefix='oa-gpg-') as gnupg:
        work = Path(temporary)
        subprocess.run(['gpg', '--homedir', str(gnupg), '--batch', '--import',
                        str(INPUTS / 'omarchy-pkgs.asc')], check=True, stdout=subprocess.DEVNULL)
        result = subprocess.run(['gpg', '--homedir', str(gnupg), '--batch', '--status-fd', '1',
                                 '--verify', str(INPUTS / 'omacalc.pkg.tar.zst.sig'),
                                 str(FILES['omacalc_package'])], check=True, capture_output=True, text=True)
        if not any(line.startswith('[GNUPG:] VALIDSIG ' + pins['omacalc_signer'] + ' ')
                   for line in result.stdout.splitlines()):
            raise ValueError('Omacalc signature has the wrong signer')
        sources = work / 'source-build'
        subprocess.run([sys.executable, str(HERE / 'build-sources'), '--output', str(sources)], check=True)
        built = json.loads((sources / 'manifest.json').read_text())
        built_files = source_metadata(built)
        for name, digest in built_files.items():
            if sha(sources / name) != digest:
                raise ValueError(f'Source-built file differs: {name}')
        upstream = work / 'upstream'
        upstream.mkdir()
        subprocess.run(['git', '-C', str(upstream), 'init', '-q'], check=True)
        subprocess.run(['git', '-C', str(upstream), 'remote', 'add', 'origin', lock['omarchy_url']], check=True)
        print('Fetching pinned Omarchy UI source...', flush=True)
        subprocess.run(['git', '-C', str(upstream), 'fetch', '--progress', '--depth', '1', 'origin', commit], check=True)
        subprocess.run(['git', '-C', str(upstream), 'checkout', '-q', '--detach', 'FETCH_HEAD'], check=True)
        head = subprocess.check_output(['git', '-C', str(upstream), 'rev-parse', 'HEAD'], text=True).strip()
        if head != commit:
            raise ValueError('Omarchy checkout differs from pin')
        result_dir = work / 'result'
        result_dir.mkdir()
        aop = work / 'apple-aop-daemon'
        subprocess.run([sys.executable, str(HERE / 'build-aop'), '--output', str(aop)], check=True)
        subprocess.run([sys.executable, str(HERE / 'stage.py'), str(result_dir / 'payload'),
                        '--upstream', str(upstream), '--keyboard', str(sources / 'wvkbd-mobintl'),
                        '--keyboard-sha256', built_files['wvkbd-mobintl'],
                        '--omafox-xpi', str(FILES['omafox_xpi']), '--aop-daemon', str(aop)], check=True)
        packages = result_dir / 'packages'
        packages.mkdir()
        shutil.copyfile(sources / 'omafox.pkg.tar.xz', packages / 'omafox.pkg.tar.xz')
        shutil.copyfile(FILES['omacalc_package'], packages / 'omacalc.pkg.tar.zst')
        meta = {'architecture': 'aarch64', 'omarchy_commit': commit,
                'inputs': {name: pins[name] for name in FILES}, 'source_build': built,
                'payload_manifest_sha256': sha(result_dir / 'payload/arch-ipad-ui-manifest.json')}
        (result_dir / 'manifest.json').write_text(json.dumps(meta, indent=2) + '\n')
        verify(result_dir)
        output.parent.mkdir(parents=True, exist_ok=True)
        os.replace(result_dir, output)
    print('Desktop output:', output)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    action = parser.add_mutually_exclusive_group(required=True)
    action.add_argument('--output', type=Path)
    action.add_argument('--verify', type=Path)
    args = parser.parse_args()
    try:
        if args.output:
            build(args.output.resolve())
        else:
            verify(args.verify)
            print('Verified desktop output:', args.verify)
    except (OSError, KeyError, ValueError, subprocess.CalledProcessError) as exc:
        parser.error(str(exc))


if __name__ == '__main__':
    main()
