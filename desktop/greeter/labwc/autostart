#!/bin/sh
# The greeter itself is started by labwc -S so its exit ends the compositor.
# The same logical scale as the desktop (and its lock screen): the native
# panel at scale 2, before the greeter maps.
/usr/local/libexec/arch-ipad-scale-output > "$XDG_RUNTIME_DIR/greeter-display.log" 2>&1 || true
