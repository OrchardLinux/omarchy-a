<?xml version="1.0"?>
<labwc_config>
  <!-- Session transitions (labwc/0003), as the desktop's rc.xml. -->
  <core>
    <decoration>server</decoration>
    <handoverDirectory>/run/omarchy-handover</handoverDirectory>
    <startupFade>yes</startupFade>
    <startupSignal>yes</startupSignal>
  </core>
  <keyboard>
    <!-- Startup-only reserved chord, as the desktop's: hides the cursor. -->
    <keybind key="A-W-h">
      <action name="HideCursor" />
    </keybind>
  </keyboard>
</labwc_config>
