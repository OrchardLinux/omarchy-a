[Unit]
Description=Apple J71b AOP orientation sensor
After=systemd-modules-load.service
ConditionPathExists=/sys/firmware/devicetree/base/chosen/apple,ecid
ConditionPathExists=/usr/lib/firmware/apple/j71b-aop.osbin

[Service]
Type=simple
ExecStartPre=/usr/bin/modprobe apple-aop-dma
ExecStart=/usr/libexec/apple-aop
RuntimeDirectory=apple-aop
RuntimeDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/apple-aop
Restart=no

[Install]
WantedBy=multi-user.target
