[Unit]
Description=Apple AOP labwc output and touchscreen rotation
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=LABWC_PID
ConditionPathExists=/run/apple-aop

[Service]
ExecStartPre=/usr/libexec/apple-aop-rotate --set normal
ExecStart=/usr/libexec/apple-aop-rotate
Restart=on-failure
RestartSec=3
