#!/usr/bin/env python3
"""Build P105 desktop support from Omarchy A's existing pinned sources."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
from urllib.request import urlopen
import xml.etree.ElementTree as ET

import stage

HERE = Path(__file__).resolve().parent
DESKTOP = HERE.parent


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def fetch(pin, destination):
    with urlopen(pin["url"], timeout=60) as response, destination.open("wb") as target:
        shutil.copyfileobj(response, target)
    if sha(destination) != pin["sha256"]:
        raise ValueError("Source archive differs from pin: " + pin["url"])


def unpack(archive, destination):
    destination.mkdir()
    with tarfile.open(archive, "r:gz") as source:
        source.extractall(destination, filter="data")
    children = list(destination.iterdir())
    if len(children) != 1 or not children[0].is_dir():
        raise ValueError("Unexpected source archive layout")
    return children[0]


def compile_labwc(work, output, jobs):
    pin = json.loads((DESKTOP / "labwc/source.json").read_text())
    patch = DESKTOP / "labwc/0001-cancel-super-tap-on-pointer.patch"
    if sha(patch) != pin["patch_sha256"]:
        raise ValueError("Labwc patch differs from pin")
    output.mkdir()
    archive = output / "source.tar.gz"
    fetch(pin, archive)
    source = unpack(archive, work / "labwc-source")
    subprocess.run(["patch", "--batch", "--fuzz=0", "-p1", "-i", str(patch)], cwd=source, check=True)
    build = work / "labwc-build"
    options = ["--buildtype=release", "--wrap-mode=nofallback", "-Dman-pages=disabled",
               "-Dlabnag=disabled", "-Dxwayland=enabled", "-Dnls=enabled", "-Dsystemd-session=disabled"]
    subprocess.run(["meson", "setup", str(build), str(source), *options], check=True)
    subprocess.run(["meson", "compile", "-C", str(build), "-j" + str(jobs)], check=True)
    shutil.copy2(build / "labwc", output / "labwc")
    stage.check_armhf(output / "labwc", "Labwc")
    shutil.copy2(source / "LICENSE", output / "LICENSE")
    shutil.copy2(patch, output / patch.name)
    version = subprocess.check_output([str(output / "labwc"), "--version"], text=True).strip()
    return {"source": pin, "build_options": options, "version": version}


def compile_cursor(work, output):
    pin = json.loads((DESKTOP / "cursor/wtype.json").read_text())
    output.mkdir()
    archive = output / "source.tar.gz"
    fetch(pin, archive)
    source = unpack(archive, work / "cursor-source")
    protocol = source / "protocol/virtual-keyboard-unstable-v1.xml"
    generated = source / "virtual-keyboard-unstable-v1-protocol.c"
    header = source / "virtual-keyboard-unstable-v1-client-protocol.h"
    subprocess.run(["wayland-scanner", "private-code", str(protocol), str(generated)], check=True)
    subprocess.run(["wayland-scanner", "client-header", str(protocol), str(header)], check=True)
    flags = shlex.split(subprocess.check_output([
        "pkg-config", "--cflags", "--libs", "wayland-client", "wayland-cursor", "xkbcommon",
    ], text=True))
    subprocess.run(["cc", "-O2", '-DVERSION="0.4"', "-I" + str(source), str(source / "main.c"),
                    str(generated), *flags, "-lrt", "-o", str(output / "wtype")], check=True)
    stage.check_armhf(output / "wtype", "Cursor helper")
    shutil.copy2(source / "LICENSE", output / "LICENSE")
    copyright_text = ET.parse(protocol).getroot().find("copyright").text.strip()
    with (output / "LICENSE").open("a") as license_file:
        license_file.write("\nVirtual keyboard protocol:\n\n" + copyright_text + "\n")
    return {"source": pin}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--jobs", type=int, default=2)
    args = parser.parse_args()
    output = args.output.resolve()
    if output.exists():
        parser.error("Choose a new output directory")
    if platform.machine() not in {"armv7l", "armv8l"}:
        parser.error("Run inside an armv7h Arch Linux ARM build environment")
    if sys.version_info < (3, 12) or args.jobs < 1:
        parser.error("Python >=3.12 and a positive --jobs value are required")
    for tool in ("cc", "meson", "ninja", "patch", "pkg-config", "readelf", "wayland-scanner", "pacman"):
        if not shutil.which(tool):
            parser.error("Missing build tool: " + tool)
    output.parent.mkdir(parents=True, exist_ok=True)
    try:
        with tempfile.TemporaryDirectory(prefix="p105-support-") as temporary:
            work = Path(temporary)
            result = work / "result"
            result.mkdir()
            components = {
                "labwc": compile_labwc(work, result / "labwc", args.jobs),
                "cursor": compile_cursor(work, result / "cursor"),
            }
            subprocess.run([sys.executable, str(DESKTOP / "build-bluetooth-tools"),
                            "--output", str(result / "bluetooth")], check=True)
            components["bluetooth"] = {"source": json.loads((DESKTOP / "bluetooth/dbus-next.json").read_text())}
            (result / "packages.lock").write_text(subprocess.check_output(["pacman", "-Q"], text=True))
            record = {
                "schema": 1, "architecture": "armv7h", "components": components,
                "compiler": subprocess.check_output(["cc", "--version"], text=True).splitlines()[0],
                "compiler_target": subprocess.check_output(["cc", "-dumpmachine"], text=True).strip(),
                "files": {path.relative_to(result).as_posix(): sha(path)
                          for path in sorted(result.rglob("*")) if path.is_file()},
            }
            (result / "manifest.json").write_text(json.dumps(record, indent=2) + "\n")
            with tempfile.TemporaryDirectory(prefix=".p105-export-", dir=output.parent) as export_work:
                staged = Path(export_work) / "result"
                shutil.copytree(result, staged)
                os.replace(staged, output)
        print("Built ARMv7h desktop support:", output)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.error(str(error))


if __name__ == "__main__":
    main()
