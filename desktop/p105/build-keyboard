#!/usr/bin/env python3
"""Build the patched Omarchy A Wayland keyboard in Arch Linux ARM armv7h."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import struct
import subprocess
import sys
import tarfile
import tempfile
from urllib.error import HTTPError, URLError
from urllib.request import urlopen

HERE = Path(__file__).resolve().parent
DESKTOP = HERE.parent


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def fetch(entry, output):
    for url in entry["urls"]:
        try:
            with urlopen(url, timeout=60) as response, output.open("wb") as stream:
                shutil.copyfileobj(response, stream)
        except (HTTPError, URLError, TimeoutError) as error:
            output.unlink(missing_ok=True)
            print("Source unavailable:", error, flush=True)
            continue
        if sha(output) != entry["sha256"]:
            output.unlink()
            raise ValueError("Keyboard source hash differs")
        return url
    raise ValueError("Pinned keyboard source is unavailable")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--jobs", type=int, default=2)
    args = parser.parse_args()
    output = args.output.resolve()
    if output.exists():
        parser.error("Choose a new output directory")
    if platform.machine() not in {"armv7l", "armv8l"}:
        parser.error("Run inside an armv7h Arch Linux ARM build environment")
    if args.jobs < 1:
        parser.error("--jobs must be positive")
    if sys.version_info < (3, 12):
        parser.error("Python 3.12 or newer is required for filtered archive extraction")
    for tool in ("cc", "make", "patch", "pkg-config", "readelf"):
        if not shutil.which(tool):
            parser.error("Missing build tool: " + tool)
    pins = json.loads((DESKTOP / "sources.json").read_text())["wvkbd"]
    patch = DESKTOP / "keyboard/wvkbd-0.20.patch"
    output.parent.mkdir(parents=True, exist_ok=True)
    try:
        with tempfile.TemporaryDirectory(prefix="p105-keyboard-") as temporary:
            work = Path(temporary)
            archive = work / "wvkbd-v0.20.tar.gz"
            url = fetch(pins, archive)
            source = work / "source"
            source.mkdir()
            with tarfile.open(archive, "r:gz") as tar:
                tar.extractall(source, filter="data")
            directories = [path for path in source.iterdir() if path.is_dir()]
            if len(directories) != 1:
                raise ValueError("Unexpected keyboard source archive layout")
            source = directories[0]
            subprocess.run(["patch", "--batch", "--fuzz=0", "-p1", "-i", str(patch)], cwd=source, check=True)
            subprocess.run(["make", "-j" + str(args.jobs), "wvkbd-mobintl"], cwd=source, check=True)
            binary = source / "wvkbd-mobintl"
            header = binary.read_bytes()[:52]
            if (len(header) != 52 or header[:6] != b"\x7fELF\x01\x01"
                    or struct.unpack_from("<H", header, 18)[0] != 40
                    or not struct.unpack_from("<I", header, 36)[0] & 0x400
                    or struct.unpack_from("<I", header, 36)[0] & 0x200):
                raise ValueError("Compiler did not produce an ARM ELF32 hard-float keyboard")
            result = work / "result"
            result.mkdir()
            shutil.copy2(binary, result / binary.name)
            shutil.copy2(archive, result / archive.name)
            shutil.copy2(patch, result / patch.name)
            for license_path in source.iterdir():
                if license_path.is_file() and license_path.name.upper().startswith(("LICENSE", "COPYING")):
                    shutil.copy2(license_path, result / license_path.name)
            record = {
                "schema": 1, "component": "omarchy-a-wayland-keyboard", "architecture": "armv7h",
                "source_version": pins["version"], "source_url": url,
                "source_sha256": pins["sha256"], "patch_sha256": sha(patch),
                "compiler": subprocess.check_output(["cc", "--version"], text=True).splitlines()[0],
                "compiler_target": subprocess.check_output(["cc", "-dumpmachine"], text=True).strip(),
                "files": {path.name: sha(path) for path in sorted(result.iterdir())},
            }
            (result / "manifest.json").write_text(json.dumps(record, indent=2) + "\n")
            with tempfile.TemporaryDirectory(prefix=".p105-export-", dir=output.parent) as export_work:
                staged = Path(export_work) / "result"
                shutil.copytree(result, staged)
                os.replace(staged, output)
        print("Built ARMv7h keyboard:", output)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.error(str(error))


if __name__ == "__main__":
    main()
