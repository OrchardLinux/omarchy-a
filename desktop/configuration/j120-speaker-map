#!/usr/bin/python3
"""Map the J120 speaker slots to screen-relative stereo."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import time


ROUTING_NODE = 'omarchy.j120-speaker-routing'
SLOTS = ('connector_left', 'connector_right', 'camera_left', 'camera_right')
# Upright portrait slot order is connector L/R, then camera L/R. When
# the panel is turned 90 degrees, the connector is on the viewer's left.
SLOT_CHANNELS = {
    'normal': ('L', 'R', 'L', 'R'),
    '90': ('L', 'L', 'R', 'R'),
    '180': ('R', 'L', 'R', 'L'),
    '270': ('R', 'R', 'L', 'L'),
}


def find_filter():
    dump = subprocess.check_output(['pw-dump', '-N', ROUTING_NODE], stderr=subprocess.PIPE, timeout=1)
    for entry in json.loads(dump or '[]'):
        props = entry.get('info', {}).get('props', {})
        if props.get('node.name') == ROUTING_NODE:
            return str(entry['id'])
    return None


def set_channels(path, node):
    transform = path.read_text().strip() if path.exists() else 'normal'
    channels = SLOT_CHANNELS.get(transform)
    if channels is None:
        raise ValueError(f'unexpected speaker transform {transform!r}')

    params = []
    for slot, channel in zip(SLOTS, channels, strict=True):
        params.extend((f'{slot}:Gain 1', float(channel == 'L'),
                       f'{slot}:Gain 2', float(channel == 'R')))
    subprocess.run(['pw-cli', 'set-param', node, 'Props', json.dumps({'params': params})],
                   check=True, stdout=subprocess.DEVNULL, timeout=1)


def apply(path, wait=False, *, timeout=3):
    deadline = time.monotonic() + (timeout if wait else 0)
    while True:
        try:
            node = find_filter()
            if node is not None:
                set_channels(path, node)
                return True
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
            if not wait:
                raise
        if time.monotonic() >= deadline:
            return False
        time.sleep(.25)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('transform', type=Path)
    parser.add_argument('--wait', type=int, nargs='?', const=3, default=0,
                        help='wait this many seconds for PipeWire')
    args = parser.parse_args()
    if args.wait < 0:
        parser.error('--wait must be nonnegative')
    try:
        if not apply(args.transform, wait=bool(args.wait), timeout=args.wait):
            sys.exit('J120 speaker routing node is unavailable')
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        sys.exit(f'J120 speaker mapping failed: {error}')
