#!/bin/bash
# Started by greetd on VT1 at boot, without a prompt (its initial session),
# never from SSH. The session starts locked: the PIN is the lock's.
set -euo pipefail
[[ ${XDG_VTNR:-} == 1 && ${USER:-} == tablet && -z ${SSH_CONNECTION:-} ]] || exit 1
[[ -n ${XDG_SESSION_ID:-} && -d ${XDG_RUNTIME_DIR:-/nonexistent} && -O $XDG_RUNTIME_DIR ]] || {
  echo 'No active logind session/runtime directory; refusing GUI startup' >&2
  exit 1
}
[[ -S $XDG_RUNTIME_DIR/bus && -O $XDG_RUNTIME_DIR/bus ]] || {
  echo 'No PAM/systemd user D-Bus socket; refusing a private session bus' >&2
  exit 1
}
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
export OMARCHY_PATH=/usr/share/omarchy
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=labwc
export WLR_RENDERER=pixman QT_QUICK_BACKEND=software QT_QPA_PLATFORM=wayland
# Match pinned upstream Omarchy's GTK-backed Qt platform theme.
export QT_QPA_PLATFORMTHEME=gtk3
# Qt Quick hovers what lies under a finger while it is down (its
# frame-synchronous hover takes the touch point for the mouse): close marks,
# tooltips and hover tints appeared under a press or a drag, in the shell and
# in every Qt Quick app. Off, hover follows a real pointer only; with a mouse
# it is then updated when the mouse moves, not when content moves under it.
export QT_QUICK_FRAME_SYNCHRONOUS_HOVER_INTERVAL=-1
export OMARCHY_TOUCH_MODE=1
export LIBGL_ALWAYS_SOFTWARE=1 LIBSEAT_BACKEND=seatd MOZ_ENABLE_WAYLAND=1
# A board with a GPU this image has a Vulkan driver for (kernel driver powervr,
# the A10's and the A9's): Labwc draws on wlroots' GLES2 renderer and
# applications on OpenGL, both through Zink on that driver, once gpu-probe has
# drawn a frame that way in this boot and the display took its buffer. Every
# other board, a boot with modprobe.blacklist=powervr and a boot whose probe
# fails or does not finish keep the software desktop above; the journal says
# which (journalctl -t omarchy-gpu-probe). On the GPU desktop the shell and
# its apps draw with Qt Quick on the GPU; on the software desktop with Qt's
# software renderer.
gpu=
for node in /sys/class/drm/renderD*; do
  if [[ $(basename "$(readlink -f "$node/device/driver")") == powervr ]]; then gpu=$node; fi
done
if [[ -n $gpu ]]; then
  gpu_probe=/usr/lib/omarchy-a/gpu-probe
  gpu_log=$XDG_RUNTIME_DIR/omarchy-gpu-probe.log
  # The GPU has no display outputs: Labwc must open the display's card only.
  display=
  for card in /sys/class/drm/card*; do
    if [[ ${card##*/} =~ ^card[0-9]+$ && $(readlink -f "$card/device") != "$(readlink -f "$gpu/device")" ]]; then
      display=/dev/dri/${card##*/}
    fi
  done
  gpu_desktop=(WLR_RENDERER=gles2 "WLR_RENDER_DRM_DEVICE=/dev/dri/${gpu##*/}"
    MESA_LOADER_DRIVER_OVERRIDE=zink PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1)
  if [[ -n $display ]]; then
    gpu_desktop+=("WLR_DRM_DEVICES=$display")
    # simpledrm cannot scan out a buffer the GPU drew (it takes no dma-buf), so
    # wlroots' direct scan-out of a fullscreen client fails, and that client
    # was then never shown: always composite there. A display driver that
    # imports the GPU's buffers keeps direct scan-out.
    display_driver=$(basename "$(readlink -f "/sys/class/drm/${display##*/}/device/driver")")
    if [[ $display_driver == simple-framebuffer || $display_driver == simpledrm ]]; then
      gpu_desktop+=(WLR_SCENE_DISABLE_DIRECT_SCANOUT=1)
    fi
  fi
  if [[ ! -e /usr/share/vulkan/icd.d/powervr_mesa_icd.json ]]; then
    gpu_verdict='software desktop: this image has no Vulkan driver for the GPU'
  elif [[ -z $display || ! -x $gpu_probe ]]; then
    gpu_verdict='software desktop: no display card or no gpu-probe to test the GPU with'
  else
    # Cache a passing GPU probe keyed by kernel release, display driver and
    # Mesa/probe timestamps so repeat boots skip the ~1 s probe while any
    # kernel, Mesa or DTB change re-runs it automatically.
    gpu_cache_base=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
    gpu_cache=${gpu_cache_base:+$gpu_cache_base/omarchy-a/gpu-probe.cache}
    gpu_key=
    if [[ -n $gpu_cache ]]; then
      gpu_icd_sig=$(stat -Lc '%Y:%s' /usr/share/vulkan/icd.d/powervr_mesa_icd.json 2>/dev/null || echo icd)
      gpu_probe_sig=$(stat -Lc '%Y:%s' "$gpu_probe" 2>/dev/null || echo probe)
      gpu_key="$(uname -r)|${display_driver:-none}|$gpu_icd_sig|$gpu_probe_sig"
    fi
    if [[ -n $gpu_cache && -r $gpu_cache ]] && IFS= read -r cached_key <"$gpu_cache" && [[ $cached_key == "$gpu_key" ]]; then
      gpu_detail=$(sed -n '2p' "$gpu_cache" 2>/dev/null || true)
      gpu_verdict="GPU desktop (cached): ${gpu_detail:-GPU-PROBE PASS}"
      export "${gpu_desktop[@]}" MESA_DISK_CACHE_SINGLE_FILE=1
      unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND
      export QSG_NO_DEPTH_BUFFER=1 QSG_NO_STENCIL_BUFFER=1
    else
      # The probe runs with the environment the desktop would get. The login
      # waits for it 10 s at most and does not depend on it ending: a probe
      # stuck in the kernel is left behind.
      env -u LIBGL_ALWAYS_SOFTWARE "${gpu_desktop[@]}" "$gpu_probe" "/dev/dri/${gpu##*/}" "$display" \
        >"$gpu_log" 2>&1 </dev/null &
      gpu_pid=$!
      gpu_ended=
      gpu_verdict='software desktop: the GPU probe did not finish within 10 s'
      for ((tick = 0; tick < 100; tick++)); do
        if ! kill -0 "$gpu_pid" 2>/dev/null; then
          gpu_detail=$(grep -m 1 GPU-PROBE "$gpu_log" 2>/dev/null || tail -n 1 "$gpu_log" 2>/dev/null || true)
          gpu_ended=1
          if wait "$gpu_pid"; then
            gpu_verdict="GPU desktop after $((tick / 10)).$((tick % 10)) s: $gpu_detail"
            export "${gpu_desktop[@]}" MESA_DISK_CACHE_SINGLE_FILE=1
            # The shell (and every app) draws on the GPU too, not Qt's software renderer.
            unset LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND
            # Qt Quick draws without a depth or stencil buffer, as iOS draws its 2D
            # UI: on these tile-based GPUs each window and each layer otherwise
            # keeps a full-size depth/stencil buffer in memory that the UI never
            # reads (on the iPod touch 6 that is about 50 MB in the shell alone).
            export QSG_NO_DEPTH_BUFFER=1 QSG_NO_STENCIL_BUFFER=1
            if [[ -n $gpu_cache ]]; then
              mkdir -p "$(dirname "$gpu_cache")" 2>/dev/null || true
              printf '%s\n%s\n' "$gpu_key" "$gpu_detail" >"$gpu_cache.tmp" 2>/dev/null &&
                mv -f "$gpu_cache.tmp" "$gpu_cache" 2>/dev/null || true
            fi
          else
            gpu_verdict="software desktop: ${gpu_detail:-the GPU probe failed}"
          fi
          break
        fi
        sleep 0.1
      done
      if [[ -z $gpu_ended ]]; then kill -KILL "$gpu_pid" 2>/dev/null || true; fi
    fi
  fi
  logger -t omarchy-gpu-probe -- "$gpu_verdict" 2>/dev/null || true
fi
# A hardware video decoder (kernel driver apple-vxd, H.264): VA-API
# applications reach it through libva-v4l2-request. Firefox uses it only when
# it draws on the GPU, and only with its media decoding sandbox off, which
# does not let the driver's device files through; /usr/lib/firefox/omarchy-a.cfg
# sets its preferences to match. Web content stays sandboxed.
for video in /sys/class/video4linux/video*; do
  if [[ $(basename "$(readlink -f "$video/device/driver")") == apple-vxd ]]; then
    export LIBVA_DRIVER_NAME=v4l2_request
    if [[ ${WLR_RENDERER:-} == gles2 ]]; then export MOZ_DISABLE_RDD_SANDBOX=1; fi
  fi
done
export PATH=/usr/local/bin:/usr/bin
# What an update changed in the tablet user's own files (desktop/shell/migrations),
# once each, before anything reads them; a plain `pacman -Syu` gets them here.
# An update still running is left to finish: they run at the next login then.
OMARCHY_MIGRATE_LOCK_WAIT=0 timeout 120 omarchy-migrate 2>&1 | logger -t omarchy-migrate || true
# Services such as PipeWire and WirePlumber use the same user manager/bus as
# Quickshell. Do not spawn a separate dbus-run-session instance.
systemctl --user import-environment DBUS_SESSION_BUS_ADDRESS XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QUICK_FRAME_SYNCHRONOUS_HOVER_INTERVAL
if [[ -n ${LIBVA_DRIVER_NAME:-} ]]; then systemctl --user import-environment LIBVA_DRIVER_NAME; fi
if [[ -n ${QT_QPA_PLATFORMTHEME:-} ]]; then systemctl --user import-environment QT_QPA_PLATFORMTHEME; fi
/usr/libexec/arch-ipad-first-theme
# Windows open maximized unless the person turned that off (Trigger > Toggle).
omarchy-toggle-maximize-windows --apply || true
# labwc -m reads labwc/rc.xml from each XDG config dir, then ~/.config/labwc/rc.xml.
# Menu toggles keep their rules under ~/.local/state, which a release never replaces.
# Touch follows the panel when it rotates: map the touchscreens to it for this session.
session_config=$XDG_RUNTIME_DIR/omarchy-xdg-config
/usr/libexec/arch-ipad-touch-output "$session_config/labwc/rc.xml" || true
export XDG_CONFIG_DIRS="$HOME/.local/state/omarchy/xdg-config:$session_config:${XDG_CONFIG_DIRS:-/etc/xdg}"
# The shell takes the lock before the desktop is seen: Labwc's startup cover
# lifts only once the lock is drawn (plugins/lock/Service.qml).
export OMARCHY_START_LOCKED=1
# A logout ends Labwc; so does a crash. Either way the desktop starts again
# here, behind the lock: there is no login screen to go back to. A desktop that
# ends within 10 s three times in a row (a second apart) is not restarted: greetd then runs
# omarchy-session-failed, and serial and SSH are there.
quick=0
while :; do
  started=$SECONDS
  /usr/bin/labwc -m || true
  if (( SECONDS - started < 10 )); then
    (( ++quick < 3 )) || { logger -t omarchy-session 'The desktop ended at once three times; not restarting it'; exit 1; }
    sleep 1
  else
    quick=0
  fi
done
