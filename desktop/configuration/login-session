#!/bin/bash
# Started by greetd on VT1 once PAM accepted the PIN, never from SSH.
set -euo pipefail
[[ ${XDG_VTNR:-} == 1 && ${USER:-} == tablet && -z ${SSH_CONNECTION:-} ]] || exit 1
[[ -n ${XDG_SESSION_ID:-} && -d ${XDG_RUNTIME_DIR:-/nonexistent} && -O $XDG_RUNTIME_DIR ]] || {
  echo 'No active logind session/runtime directory; refusing GUI startup' >&2
  exit 1
}
[[ -S $XDG_RUNTIME_DIR/bus && -O $XDG_RUNTIME_DIR/bus ]] || {
  echo 'No PAM/systemd user D-Bus socket; refusing a private session bus' >&2
  exit 1
}
export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
# The user session must read its live theme, not the greeter's snapshot.
unset OMARCHY_GREETER_THEME_DIR
export OMARCHY_PATH="$HOME/.local/share/omarchy-ipad"
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=labwc
export WLR_RENDERER=pixman QT_QUICK_BACKEND=software QT_QPA_PLATFORM=wayland
# Match pinned upstream Omarchy's GTK-backed Qt platform theme.
export QT_QPA_PLATFORMTHEME=gtk3
export OMARCHY_TOUCH_MODE=1
# Actual RAM/CPU, independent of board or GPU. Clear a previous login's policy.
unset OMARCHY_LOW_MEMORY
if (( $(awk '/^MemTotal:/ {print $2}' /proc/meminfo) <= 2097152 && $(getconf _NPROCESSORS_ONLN) <= 2 )); then
  export OMARCHY_LOW_MEMORY=1
fi
systemctl --user unset-environment OMARCHY_LOW_MEMORY
if [[ ${OMARCHY_LOW_MEMORY:-} == 1 ]]; then systemctl --user import-environment OMARCHY_LOW_MEMORY; fi
export LP_NUM_THREADS=${LP_NUM_THREADS:-2}
export LIBGL_ALWAYS_SOFTWARE=1 LIBSEAT_BACKEND=seatd MOZ_ENABLE_WAYLAND=1
# A board with a GPU this image has a Vulkan driver for (the A10's, kernel
# driver powervr): Labwc draws on wlroots' GLES2 renderer and applications on
# OpenGL, both through Zink on that driver. Every other board, and a boot with
# modprobe.blacklist=powervr, keeps the software desktop above. The shell stays
# on Qt's software renderer either way; the apps it starts don't (uwsm-app).
gpu=
for node in /sys/class/drm/renderD*; do
  if [[ $(basename "$(readlink -f "$node/device/driver")") == powervr ]]; then gpu=$node; fi
done
if [[ -n $gpu && -e /usr/share/vulkan/icd.d/powervr_mesa_icd.json ]]; then
  export WLR_RENDERER=gles2 WLR_RENDER_DRM_DEVICE=/dev/dri/${gpu##*/}
  export MESA_LOADER_DRIVER_OVERRIDE=zink PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1
  unset LIBGL_ALWAYS_SOFTWARE
  # The GPU has no display outputs: Labwc must open the display's card only.
  for card in /sys/class/drm/card*; do
    if [[ ${card##*/} =~ ^card[0-9]+$ && $(readlink -f "$card/device") != "$(readlink -f "$gpu/device")" ]]; then
      export WLR_DRM_DEVICES=/dev/dri/${card##*/}
    fi
  done
fi
# G5P uses a private matched GL/ICD stack; A10 above keeps Arch GL.
# No Zink override here. That stack's Mesa already routes each device: the
# G5P render node to Zink, and the ADBE card, which has no render node, to
# kmsro. kmsro allocates every scanout buffer as an ADBE dumb buffer and
# imports it into Zink. ADBE scans out only physically contiguous memory.
# MESA_LOADER_DRIVER_OVERRIDE=zink would also send the ADBE card to Zink,
# which then allocates Labwc's output buffers in G5P memory that ADBE cannot
# import, and Labwc is left without an output.
for node in /sys/class/drm/renderD*; do
  driver=$(basename "$(readlink -f "$node/device/driver")")
  if [[ $driver != apple-g5p && $driver != apple-g5p-drm ]]; then continue; fi
  prefix=/opt/orchard/g5p
  probe=$prefix/libexec/omarchy-g5p-probe
  if [[ ! -e $prefix/share/vulkan/icd.d/powervr_mesa_icd.aarch64.json || ! -e $prefix/lib/libEGL_mesa.so.0 || ! -x $probe ]]; then
    echo 'G5P private GL/ICD package missing; retaining software desktop' >&2
    break
  fi
  kms=
  for card in /sys/class/drm/card*; do
    if [[ ${card##*/} =~ ^card[0-9]+$ && $(basename "$(readlink -f "$card/device/driver")") == apple-adbe ]]; then
      kms=/dev/dri/${card##*/}
    fi
  done
  if [[ -z $kms ]]; then
    echo 'No ADBE display card; retaining software desktop' >&2
    break
  fi
  g5p_stack=("LD_LIBRARY_PATH=$prefix/lib" "GBM_BACKENDS_PATH=$prefix/lib/gbm" GBM_BACKEND=dri
    "LIBGL_DRIVERS_PATH=$prefix/lib/dri"
    "__EGL_VENDOR_LIBRARY_FILENAMES=$prefix/share/glvnd/egl_vendor.d/50_mesa.json"
    "VK_DRIVER_FILES=$prefix/share/vulkan/icd.d/powervr_mesa_icd.aarch64.json"
    "VK_ICD_FILENAMES=$prefix/share/vulkan/icd.d/powervr_mesa_icd.aarch64.json"
    PVR_I_WANT_A_BROKEN_VULKAN_DRIVER=1)
  # Leave software only once this stack renders on G5P and draws into a
  # buffer allocated the way Labwc's output buffers are (GBM on ADBE). The
  # probe never modesets and needs no DRM master.
  if ! env -u LIBGL_ALWAYS_SOFTWARE -u MESA_LOADER_DRIVER_OVERRIDE -u GALLIUM_DRIVER "${g5p_stack[@]}" \
      timeout -k 2 12 "$probe" "/dev/dri/${node##*/}" "$kms" >"$XDG_RUNTIME_DIR/omarchy-g5p-probe.log" 2>&1; then
    echo "G5P probe failed (see $XDG_RUNTIME_DIR/omarchy-g5p-probe.log); retaining software desktop" >&2
    break
  fi
  export OMARCHY_G5P=1 "${g5p_stack[@]}"
  export WLR_RENDERER=gles2 WLR_BACKENDS=drm,libinput
  export WLR_DRM_DEVICES=$kms WLR_RENDER_DRM_DEVICE=/dev/dri/${node##*/}
  # Client buffers are G5P memory, which ADBE cannot scan out: direct
  # scanout would only fail its import every frame, and its scanout
  # feedback would ask clients for linear buffers. ADBE has no cursor plane.
  export WLR_SCENE_DISABLE_DIRECT_SCANOUT=1 WLR_NO_HARDWARE_CURSORS=1
  unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE GALLIUM_DRIVER
  break
done
# A hardware video decoder (kernel driver apple-vxd, H.264): VA-API
# applications reach it through libva-v4l2-request. Firefox uses it only when
# it draws on the GPU, and only with its media decoding sandbox off, which
# does not let the driver's device files through; /usr/lib/firefox/omarchy-a.cfg
# sets its preferences to match. Web content stays sandboxed.
for video in /sys/class/video4linux/video*; do
  if [[ $(basename "$(readlink -f "$video/device/driver")") == apple-vxd ]]; then
    export LIBVA_DRIVER_NAME=v4l2_request
    if [[ ${WLR_RENDERER:-} == gles2 ]]; then export MOZ_DISABLE_RDD_SANDBOX=1; fi
  fi
done
export PATH=/usr/local/bin:/usr/bin
# Services such as PipeWire and WirePlumber use the same user manager/bus as
# Quickshell. Do not spawn a separate dbus-run-session instance.
systemctl --user import-environment DBUS_SESSION_BUS_ADDRESS XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
# D-Bus/user-manager launched applications need the same G5P stack as labwc.
# Clear the previous login's private selection before importing this one.
g5p_env=(OMARCHY_G5P LD_LIBRARY_PATH GBM_BACKENDS_PATH GBM_BACKEND LIBGL_DRIVERS_PATH
  __EGL_VENDOR_LIBRARY_FILENAMES VK_DRIVER_FILES VK_ICD_FILENAMES GALLIUM_DRIVER
  MESA_LOADER_DRIVER_OVERRIDE PVR_I_WANT_A_BROKEN_VULKAN_DRIVER WLR_RENDERER
  WLR_RENDER_DRM_DEVICE WLR_DRM_DEVICES WLR_BACKENDS WLR_SCENE_DISABLE_DIRECT_SCANOUT
  WLR_NO_HARDWARE_CURSORS)
systemctl --user unset-environment "${g5p_env[@]}"
if [[ ${OMARCHY_G5P:-} == 1 ]]; then
  g5p_set=()
  for name in "${g5p_env[@]}"; do if [[ -v $name ]]; then g5p_set+=("$name"); fi; done
  systemctl --user import-environment "${g5p_set[@]}"
fi
if [[ -n ${QT_QPA_PLATFORMTHEME:-} ]]; then systemctl --user import-environment QT_QPA_PLATFORMTHEME; fi
/usr/local/libexec/arch-ipad-first-theme
# labwc -m reads labwc/rc.xml from each XDG config dir, then ~/.config/labwc/rc.xml.
# Menu toggles keep their rules under ~/.local/state, which a release never replaces.
# Touch follows the panel when it rotates: map the touchscreens to it for this session.
session_config=$XDG_RUNTIME_DIR/omarchy-xdg-config
/usr/local/libexec/arch-ipad-touch-output "$session_config/labwc/rc.xml" || true
export XDG_CONFIG_DIRS="$HOME/.local/state/omarchy/xdg-config:$session_config:${XDG_CONFIG_DIRS:-/etc/xdg}"
exec /usr/bin/labwc -m
