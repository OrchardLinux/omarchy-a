#!/bin/bash
# One balanced, compositor-owned HideCursor action. No pointer warping or
# recurring key injection; normal pointer motion restores visibility.
/usr/libexec/omarchy-wtype -M alt -M logo h -m logo -m alt > "$XDG_RUNTIME_DIR/omarchy-startup-cursor.log" 2>&1 || true
# No overview is open in a new session, whatever the last one left behind.
rm -f "$XDG_RUNTIME_DIR/omarchy-overview-open"
# Hardware output timing and mode come from the kernel bundle.
# On the verified native portrait panel, set logical scale before mapping UI.
/usr/local/libexec/arch-ipad-scale-output > "$XDG_RUNTIME_DIR/arch-ipad-display.log" 2>&1 || true
# Turn the panel with the device (iio-sensor-proxy); a no-op without an accelerometer.
/usr/local/libexec/arch-ipad-rotate-output > "$XDG_RUNTIME_DIR/arch-ipad-rotation.log" 2>&1 &
# Let user services launched after the compositor see its actual Wayland socket.
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE > "$XDG_RUNTIME_DIR/arch-ipad-user-env.log" 2>&1
# Sensor policy follows the compositor lifetime; it stays off until enabled.
/usr/local/libexec/arch-ipad-auto-brightness > "$XDG_RUNTIME_DIR/arch-ipad-auto-brightness.log" 2>&1 &
# Keep the theme-coloured keyboard resident but hidden until the user taps Show.
export OMARCHY_PATH="$HOME/.local/share/omarchy-ipad"
printf '0\n' > "$XDG_RUNTIME_DIR/omarchy-keyboard-visible"
"$OMARCHY_PATH/bin/omarchy-keyboard" run > "$XDG_RUNTIME_DIR/omarchy-keyboard.log" 2>&1 &
qs -p "$OMARCHY_PATH/shell/shell.qml" > "$XDG_RUNTIME_DIR/omarchy-shell.log" 2>&1 &

# Removable storage mounts for the user through udisks (no programs run from
# it; omarchy-powerd keeps new USB devices off while the screen is locked).
# Unplugging is still an explicit safe removal.
(
  udiskie --no-notify --no-tray &
  media=$!
  trap 'kill "$media" 2>/dev/null || true; wait "$media" 2>/dev/null || true' EXIT
  while kill -0 "$LABWC_PID" 2>/dev/null && kill -0 "$media" 2>/dev/null; do sleep 2; done
) > "$XDG_RUNTIME_DIR/omarchy-media.log" 2>&1 &
