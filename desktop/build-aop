#!/usr/bin/env python3
"""Compile the J71b AOP service for AArch64 without accessing a device."""
import argparse
from pathlib import Path
import shutil
import platform
import subprocess
import tempfile
from orchard_hardware import buildenv

HERE = Path(__file__).resolve().parent
IMAGE = "localhost/orchard-hardware-kernel-toolchain:bookworm"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--test", action="store_true", help="build and run synthetic AFK checks")
    args = parser.parse_args()
    output = args.output.resolve()
    if output.exists():
        parser.error("output must be a new path")
    import orchard_hardware
    kernel = Path(orchard_hardware.__file__).resolve().parent / "kernel"
    buildenv.build(IMAGE, kernel / "Containerfile", kernel)
    with tempfile.TemporaryDirectory(prefix="orchard-aop-") as temporary:
        work = Path(temporary)
        compiler = "cc" if buildenv.native() else "clang-19 --target=aarch64-linux-gnu"
        source = "test-protocol.c" if args.test else "aop.c"
        flags = " -static" if args.test else ""
        buildenv.run(IMAGE, ["sh", "-ec", compiler + flags + ''' -O2 -Wall -Wextra -Werror \
  -Wno-unused-parameter "$ORCHARD_AOP/''' + source + '''" -o "$ORCHARD_RESULT/apple-aop-daemon"
readelf -h "$ORCHARD_RESULT/apple-aop-daemon" | grep -q 'Machine:.*AArch64'
'''], [(HERE / "aop", "/aop", True), (work, "/result", False)])
        output.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(work / "apple-aop-daemon", output)
        output.chmod(0o755)
    if args.test:
        runner = [] if platform.machine() in ("aarch64", "arm64") else ["qemu-aarch64-static"]
        subprocess.run([*runner, str(output)], check=True)


if __name__ == "__main__":
    main()
