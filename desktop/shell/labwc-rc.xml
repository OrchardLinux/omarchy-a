<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <theme>
    <name>Omarchy-Current</name>
    <cornerRadius>0</cornerRadius>
    <dropShadows>no</dropShadows>
    <!-- Unlike Hyprland, labwc retains titlebar controls for desktop mouse use. -->
    <titlebar>
      <layout>:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <font place="ActiveWindow" name="monospace" size="9" />
    <font place="InactiveWindow" name="monospace" size="9" />
  </theme>
  <keyboard>
    <default />
    <!-- Startup-only reserved chord; leave ordinary Alt+H to applications. -->
    <keybind key="A-W-h">
      <action name="HideCursor" />
    </keybind>
    <!-- Physical gpio-keys: volume, in 5% steps with the shell's OSD.
         Brightness is in the Control Center. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="omarchy-volume raise" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="omarchy-volume lower" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="omarchy-volume mute-toggle" />
    </keybind>
    <!-- Lock before blanking; suspend is intentionally deferred until supported. -->
    <keybind key="XF86PowerOff" onRelease="yes" allowWhenLocked="yes">
      <action name="Execute" command="omarchy-tablet-power power" />
    </keybind>
    <!-- Modifier-only release bindings preserve ordinary Cmd/Super chords. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="omarchy-shell omarchy.dock apps" />
    </keybind>
    <keybind key="Super_R" onRelease="yes">
      <action name="Execute" command="omarchy-shell omarchy.dock apps" />
    </keybind>
    <!-- J71b Home emits KEY_HOMEPAGE (172), not navigation KEY_HOME. -->
    <keybind key="XF86HomePage" onRelease="yes" allowWhenLocked="yes">
      <action name="Execute" command="omarchy-tablet-power home" />
    </keybind>
    <!-- Keyboard shortcuts for a Bluetooth keyboard, after upstream Omarchy (W = Super).
         labwc has no directional focus, so Super+arrows cycle windows; Super+Shift+arrows
         snap the window to that half (top/bottom suit the portrait screen). -->
    <keybind key="W-Return">
      <action name="Execute" command="foot" />
    </keybind>
    <keybind key="W-S-b">
      <action name="Execute" command="firefox" />
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="omarchy-shell omarchy.dock apps" />
    </keybind>
    <keybind key="W-A-space">
      <action name="Execute" command="omarchy-shell shell toggle omarchy.menu &apos;{&quot;menu&quot;:&quot;root&quot;}&apos;" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="omarchy-shell shell toggle omarchy.menu &apos;{&quot;menu&quot;:&quot;system&quot;}&apos;" />
    </keybind>
    <keybind key="W-w">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-m">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Up">
      <action name="PreviousWindowImmediate" />
    </keybind>
    <keybind key="W-S-Up">
      <action name="SnapToEdge" direction="up" />
    </keybind>
    <keybind key="W-Down">
      <action name="NextWindowImmediate" />
    </keybind>
    <keybind key="W-S-Down">
      <action name="SnapToEdge" direction="down" />
    </keybind>
    <keybind key="W-Left">
      <action name="PreviousWindowImmediate" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="NextWindowImmediate" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="Print">
      <action name="Execute" command="sh -c &apos;mkdir -p ~/Pictures &amp;&amp; grim ~/Pictures/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png&apos;" />
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute" command="sh -c &apos;mkdir -p ~/Pictures &amp;&amp; grim ~/Pictures/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png&apos;" />
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="omarchy-brightness-display --no-osd +5%" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="omarchy-brightness-display --no-osd -5%" />
    </keybind>
    <!-- Super+Shift+Space hides or shows the top bar, as in upstream Omarchy. -->
    <keybind key="W-S-space">
      <action name="Execute" command="omarchy-toggle-bar" />
    </keybind>
  </keyboard>
  <touch mouseEmulation="no" />
  <snapping>
    <!-- Keep titlebar double-click maximize; top-edge dragging tiles upward. -->
    <topMaximize>no</topMaximize>
  </snapping>
</labwc_config>
