{
  "version": 1,
  "idle": { "screensaver": 0, "lock": 300 },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [{ "id": "omarchy.menu" }],
      "centerBegin": [{ "id": "omarchy.indicators", "items": ["StayAwake"] }],
      "center": [{ "id": "omarchy.clock", "format": "HH:mm" }],
      "centerEnd": [],
      "right": [
        { "id": "ipadlinux.keyboard", "narrow": "left" },
        { "id": "omarchy.audio", "narrow": false },
        { "id": "omarchy.bluetooth", "narrow": false },
        { "id": "omarchy.network", "narrow": "left" },
        { "id": "omarchy.monitor", "narrow": false },
        { "id": "omarchy.activity", "mode": "cpu" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "disabledPlugins": [
    "omarchy.dock", "omarchy.polkit",
    "omarchy.notifications", "omarchy.media",
    "omarchy.battery", "omarchy.nightlight", "omarchy.remote-session",
    "omarchy.reminders", "omarchy.emojis",
    "omarchy.clipboard"
  ],
  "plugins": []
}
