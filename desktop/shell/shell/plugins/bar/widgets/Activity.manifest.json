{
  "schemaVersion": 1,
  "id": "omarchy.activity",
  "name": "Activity",
  "version": "1.0.0",
  "author": "Omarchy A",
  "description": "CPU or memory use, tap opens Omactivity",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Activity.qml"
  },
  "barWidget": {
    "displayName": "Activity",
    "description": "CPU or memory use, tap opens Omactivity",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false,
    "schema": [
      {
        "key": "mode",
        "type": "enum",
        "label": "Show",
        "description": "Which figure the bar shows. A long press or right click on the widget switches it.",
        "options": ["cpu", "memory"],
        "defaultValue": "cpu"
      },
      {
        "key": "interval",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      }
    ]
  },
  "omarchy": {
    "clonePaths": [
      {
        "source": "ActivityModel.js",
        "target": "ActivityModel.js"
      }
    ]
  }
}
