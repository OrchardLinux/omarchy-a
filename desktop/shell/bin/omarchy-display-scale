#!/bin/sh
# Show or set the panel's display scale. The choice persists: the session's
# arch-ipad-scale-output applies it again at the next login.
#   omarchy-display-scale         prints the current scale, e.g. 2
#   omarchy-display-scale 1.75    applies and saves 1.75
set -eu
allowed='1 1.25 1.5 1.75 2 2.25 2.5 3'
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-ipad
output=$(wlr-randr | awk '/^[^[:space:]]/ {print $1; exit}')
[ -n "$output" ] || { echo 'omarchy-display-scale: no output' >&2; exit 1; }
if [ $# -eq 0 ]; then
    wlr-randr | awk '/^[^[:space:]]/ {seen = 1} seen && $1 == "Scale:" {print $2 + 0; exit}'
    exit 0
fi
case " $allowed " in
    *" $1 "*) ;;
    *) echo "omarchy-display-scale: unsupported scale $1 (one of: $allowed)" >&2; exit 2 ;;
esac
wlr-randr --output "$output" --scale "$1"
mkdir -p "$state_dir"
printf '%s\n' "$1" > "$state_dir/display-scale"
