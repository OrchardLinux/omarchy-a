#!/bin/bash
# Labwc port of Omarchy's display-brightness command. Only a real Linux
# backlight is supported; virtual VM displays are reported as unavailable.
set -euo pipefail

# The override is for isolated tests, never set by the desktop session.
base=${IPADLINUX_BACKLIGHT_DIR:-/sys/class/backlight}
# The one built-in panel backlight, as omarchy-screen-toggle picks it.
device=""
for candidate in "$base"/*; do
  [[ -d $candidate && -r $candidate/max_brightness ]] || continue
  [[ -z $device ]] || { echo unavailable; exit 1; }
  device=$candidate
done
[[ -n $device && -r $device/max_brightness && -r $device/brightness ]] || { echo unavailable; exit 1; }
read -r max < "$device/max_brightness"
[[ $max =~ ^[0-9]+$ && $max -gt 0 ]] || { echo unavailable; exit 1; }

if (( $# == 0 )); then
  value_file=$device/actual_brightness
  [[ -r $value_file ]] || value_file=$device/brightness
  read -r current < "$value_file"
  [[ $current =~ ^[0-9]+$ ]] || { echo unavailable; exit 1; }
  printf '%d\n' "$(( (100 * current + max / 2) / max ))"
  exit 0
fi

[[ ${1:-} == --no-osd ]] && shift
[[ $# == 1 && $1 =~ ^([+-]?)([0-9]{1,3})%$ ]] || { echo 'Usage: omarchy-brightness-display [--no-osd] [1..100%|+5%|-5%]' >&2; exit 2; }
sign=${BASH_REMATCH[1]}
percent=$((10#${BASH_REMATCH[2]}))
if [[ -n $sign ]]; then
  read -r current < "$device/brightness"
  [[ $current =~ ^[0-9]+$ ]] || exit 1
  # 0 means omarchy-screen-toggle turned the panel off. Stepping from there
  # would light it at 1-5%, which the next toggle then saves as the level to
  # restore, so the screen looks dead. Only the toggle turns the panel back on.
  if (( current == 0 )); then printf '0\n'; exit 0; fi
  current_percent=$(( (100 * current + max / 2) / max ))
  if [[ $sign == + ]]; then percent=$((current_percent+percent)); else percent=$((current_percent-percent)); fi
  if (( percent < 1 )); then percent=1; fi
  if (( percent > 100 )); then percent=100; fi
fi
(( percent >= 1 && percent <= 100 )) || exit 2
raw=$(( (max * percent + 50) / 100 ))
(( raw >= 1 )) || raw=1
[[ -w $device/brightness ]] || { echo "Backlight is not writable: $device/brightness" >&2; exit 1; }
printf '%d\n' "$raw" > "$device/brightness"
printf '%d\n' "$percent"
# Update an already-open display panel after physical-button writes too.
# Quiet IPC changes its value only; it never opens a popup or OSD.
if [[ ${OMARCHY_TOUCH_MODE:-} == 1 ]] && command -v omarchy-shell >/dev/null; then
  omarchy-shell -q omarchy.monitor refresh >/dev/null 2>&1 || true
fi
