#!/bin/bash

# omarchy:summary=The iPad's Home button: open the launcher, or the overview when pressed twice; close the overview
# omarchy:hidden=true

# omarchy-powerd runs this when Home comes up after a press alone on a lit
# screen: it reads the button itself, so a press that woke the screen or
# was half of Home + Power (a screenshot) never gets here, and no keyboard
# state or compositor binding stands in between.
runtime="${XDG_RUNTIME_DIR:-/run/user/$UID}"
stamp="$runtime/omarchy-home-press"
# When the press happened, in ms, from bash's own clock (no fork).
now=$(( ${EPOCHREALTIME/[.,]/} / 1000 ))

# A locked session's Home is the lock screen's (waking is omarchy-powerd's).
[[ $(omarchy-shell lock status 2>/dev/null) == *'"secure":true'* ]] && exit 0

# In the overview Home goes back to the desktop (omarchy-overview-changed
# keeps the note).
if [[ -e $runtime/omarchy-overview-open ]]; then
  rm -f "$stamp"
  exec labwc --overview
fi

# Two presses open the overview of all windows, and must not flash the
# launcher on the way. So one press waits a moment for a second: the launcher
# opens only once it is certain that the press stays alone. The stamp is
# this press's at once, so the first one, still waiting, will not open the
# launcher meanwhile.
last=$(cat "$stamp" 2>/dev/null)
echo "$now" >"$stamp"
if [[ $last =~ ^[0-9]+$ ]] && (( now - last < 300 )); then
  rm -f "$stamp"
  exec labwc --overview
fi
sleep 0.3
# A second press has taken the stamp.
[[ $(cat "$stamp" 2>/dev/null) == "$now" ]] || exit 0
rm -f "$stamp"
exec omarchy-shell omarchy.dock apps
