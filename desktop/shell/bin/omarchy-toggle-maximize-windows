#!/bin/bash

# omarchy:summary=Open new windows maximized, or not
# On by default: a tablet's windows fill its screen. Turned off, the
# maximize-windows-off flag says so; omarchy-labwc-window-rules writes the
# rule.
#
#   omarchy-toggle-maximize-windows           switch it, and reload labwc
#   omarchy-toggle-maximize-windows --apply   write the rules for the current choices
set -euo pipefail
# Beside this command, as installed and in the source tree alike.
rules=${BASH_SOURCE[0]%/*}/omarchy-labwc-window-rules
toggles=$HOME/.local/state/omarchy/toggles
off=$toggles/maximize-windows-off

case ${1:-} in
  --apply) exec "$rules" ;;
  '') ;;
  *) echo 'Usage: omarchy-toggle-maximize-windows [--apply]' >&2; exit 2 ;;
esac

mkdir -p "$toggles"
if [[ -e $off ]]; then rm -f "$off"; else : >"$off"; fi
"$rules"
labwc=${LABWC_PID:-$(pgrep -u "$(id -u)" -x labwc | head -1 || true)}
[[ -z $labwc ]] || kill -HUP "$labwc"
