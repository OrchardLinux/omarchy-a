#!/bin/bash

# omarchy:summary=Run pending Omarchy migrations.
# omarchy:args=[--pending]

# Upstream Omarchy's, for Omarchy A: a migration changes the tablet user's own
# files once, after an update brought a release that needs it. omarchy-update
# runs them after the packages, and the login runs them before the desktop
# starts (OMARCHY_MIGRATE_LOCK_WAIT=0: an update still running is left to
# finish, and they run at the next login). What root has to change is the
# omarchy-a package's (package/omarchy-a.install), never a migration's.

set -euo pipefail

mode="run"

usage() {
  echo "Usage: omarchy-migrate [--pending]"
}

while (($#)); do
  case "$1" in
    --pending|--check)
      mode="pending"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
STATE_DIR="${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}"
MIGRATIONS_DIR="$OMARCHY_PATH/migrations"
LOCK_WAIT="${OMARCHY_MIGRATE_LOCK_WAIT:-900}"
PACMAN_LOCK="${OMARCHY_PACMAN_LOCK:-/var/lib/pacman/db.lck}"

migration_entries() {
  [[ -d $MIGRATIONS_DIR ]] || return 0

  local file filename

  for file in "$MIGRATIONS_DIR"/*.sh; do
    [[ -f $file ]] || continue
    filename=$(basename "$file")
    printf '%s\t%s\t%s\n' "$filename" "$file" "$STATE_DIR/$filename"
  done
}

pending_migrations() {
  local name file marker

  while IFS=$'\t' read -r name file marker; do
    [[ -n $name ]] || continue
    if [[ ! -f $marker ]]; then
      printf '%s\n' "$name"
    fi
  done < <(migration_entries)
}

if [[ $mode == "pending" ]]; then
  pending_output=$(pending_migrations)
  if [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  else
    exit 1
  fi
fi

# Migrations are written against the packages an update installs: never
# against a half-finished transaction.
wait_for_pacman_transaction() {
  [[ -e $PACMAN_LOCK ]] || return 0
  echo "Waiting for pacman transaction to finish before running Omarchy migrations..."

  for ((second = 0; second < LOCK_WAIT; second++)); do
    [[ -e $PACMAN_LOCK ]] || return 0
    sleep 1
  done

  [[ -e $PACMAN_LOCK ]] || return 0
  echo "Pacman transaction is still running; Omarchy migrations will run on the next login."
  exit 0
}

wait_for_pacman_transaction

mkdir -p "$STATE_DIR"
[[ -d $MIGRATIONS_DIR ]] || exit 0

while IFS=$'\t' read -r name file marker <&3; do
  [[ -n $name ]] || continue

  if [[ ! -f $marker ]]; then
    echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
    OMARCHY_PATH="$OMARCHY_PATH" bash -euo pipefail "$file" 3<&-
    mkdir -p "$(dirname "$marker")"
    touch "$marker"
  fi
done 3< <(migration_entries)
