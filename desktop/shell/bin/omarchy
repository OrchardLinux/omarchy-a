#!/bin/bash
# Minimal CLI routing for the labwc port. The version comes from the pinned
# Quattro source, not a claim that the full Omarchy distribution is installed.
set -euo pipefail
case "${1:-}" in
  version)
    (($# == 1)) || exit 2
    root=${OMARCHY_PATH:-$HOME/.local/share/omarchy-ipad}
    [[ -r $root/version ]] || { echo 'Pinned Omarchy version missing' >&2; exit 1; }
    head -n1 "$root/version"
    ;;
  hook)
    if [[ ${2:-} == install ]]; then
      shift 2
      exec omarchy-hook-install "$@"
    fi
    echo 'Only hook install is supported by this labwc port' >&2
    exit 2
    ;;
  *)
    echo 'Unsupported Omarchy CLI command in this labwc port' >&2
    exit 2
    ;;
esac
