#!/usr/bin/env python3
"""Manual rotation uses the same output protocol as auto-rotation; holds auto until unlock."""
import json, os, subprocess, sys
from pathlib import Path
mode = sys.argv[1] if len(sys.argv)>1 else 'status'
outputs = json.loads(subprocess.check_output(['wlr-randr', '--json'], text=True))
panel = next((o for o in outputs if o['name'] == 'eDP-1'), None)
if panel is None:
    panel = next(o for o in outputs if o.get('enabled'))
current = panel['transform']
turns = ['normal', '90', '180', '270']
if mode == 'status':
    print(current); raise SystemExit(0)
if mode == 'next': mode = turns[(turns.index(current)+1)%4]
mode = {'portrait':'normal','landscape':'90','portrait-flipped':'180','landscape-flipped':'270'}.get(mode,mode)
if mode not in turns: raise SystemExit('Usage: omarchy-rotate status|next|normal|90|180|270')
lock = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home()/'.config')))/'omarchy/rotation-lock'
was_locked = lock.exists()
lock.parent.mkdir(parents=True,exist_ok=True); lock.touch()
try:
    subprocess.run(['wlr-randr','--output',panel['name'],'--transform',mode],check=True,timeout=5)
except (OSError, subprocess.SubprocessError):
    if not was_locked: lock.unlink(missing_ok=True)
    raise
