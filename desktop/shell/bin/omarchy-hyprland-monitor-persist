#!/bin/bash

# omarchy:summary=Save a monitor's scale, and optionally its mode, position and rotation, for that monitor
# omarchy:args=OUTPUT SCALE [MODE] [POSITION] [TRANSFORM]
# omarchy:hidden=true

# Labwc port of upstream Omarchy's command (basecamp/omarchy 4aa003c), under
# upstream's name: same arguments, file and line format. What differs: the
# identity is the connector name (an iPad has one built-in panel that is never
# renamed, and upstream's omarchy-hyprland-monitor-identity reads Hyprland),
# and the trailing hyprctl GDK_SCALE refresh is gone. The file is read back by
# arch-ipad-scale-output at login instead of default/hypr/monitor-settings.lua.

# Saves the settings by the physical monitor rather than its connector, since a
# dock renames connectors between plugs: one line per monitor in
# $XDG_STATE_HOME/omarchy/monitors/settings, which default/hypr/monitor-settings.lua
# applies whenever the config loads or the monitor arrives. Each line holds the
# mode, position, scale and transform, then the monitor's identity last; lines
# saved before rotation was saved lack the transform. An empty MODE, POSITION
# or TRANSFORM keeps the saved one. hypr/monitors.lua is the user's and is never
# written here.

output="${1:-}"
scale="${2:-}"
mode="${3:-}"
position="${4:-}"
transform="${5:-}"

if [[ -z $output || -z $scale ]]; then
  echo "Usage: omarchy-hyprland-monitor-persist OUTPUT SCALE [MODE] [POSITION] [TRANSFORM]" >&2
  exit 1
fi

# The file is read back as config, so a value out of place would leave the
# monitor misconfigured on every load.
if [[ ! $output =~ ^[A-Za-z0-9._-]+$ || ! $scale =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  [[ -n $mode && ! $mode =~ ^[0-9]+x[0-9]+(@[0-9.]+)?$ ]] ||
  [[ -n $position && ! $position =~ ^-?[0-9]+x-?[0-9]+$ ]] ||
  [[ -n $transform && ! $transform =~ ^[0-7]$ ]]; then
  echo "Refusing to save an unsafe monitor setting: $*" >&2
  exit 1
fi

settings="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitors/settings"
identity="$output"

mkdir -p "${settings%/*}"
touch "$settings"
tmp=$(mktemp "$settings.XXXXXX")
awk -F'\t' -v OFS='\t' -v identity="$identity" -v mode="$mode" -v position="$position" -v scale="$scale" -v transform="$transform" '
  $NF == identity {
    if (mode == "") mode = $1
    if (position == "") position = $2
    if (transform == "" && NF > 4) transform = $4
    next
  }
  { print }
  END { print mode, position, scale, transform, identity }
' "$settings" >"$tmp"
mv "$tmp" "$settings"
