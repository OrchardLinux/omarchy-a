#!/bin/bash
# Share the orientation lock with arch-ipad-rotate-output.
set -euo pipefail
lock=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/rotation-lock
case ${1:-toggle} in
  enabled) [[ -e $lock ]]; exit ;;
  status) if [[ -e $lock ]]; then echo locked; else echo automatic; fi ;;
  on) mkdir -p "$(dirname "$lock")"; touch "$lock" ;;
  off) rm -f -- "$lock" ;;
  toggle) if [[ -e $lock ]]; then rm -f -- "$lock"; else mkdir -p "$(dirname "$lock")"; touch "$lock"; fi ;;
  *) echo 'Usage: omarchy-rotation-lock [on|off|toggle|enabled|status]' >&2; exit 2 ;;
esac
