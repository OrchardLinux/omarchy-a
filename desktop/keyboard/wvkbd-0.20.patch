+static void report_visibility(bool visible)
+{
+    const char *path = getenv("WVKBD_STATE_FILE");
+    if (!path || !*path) return;
+    FILE *file = fopen(path, "w");
+    if (!file) return;
+    fputs(visible ? "1\n" : "0\n", file);
