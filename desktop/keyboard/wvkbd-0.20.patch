@@ -0,0 +1,35 @@
+#ifndef KEY_PREVIEW_H
+#define KEY_PREVIEW_H
+
+struct key_preview_bounds { int x, y, w, h, tip; };
+
+/* Coordinates are in the two-keyboard-height, input-transparent popup surface. */
+static inline struct key_preview_bounds
+key_preview_place(int width, int height, int key_x, int key_y, int key_w, int key_h)
+{
+    struct key_preview_bounds p = {0};
+    int margin = width >= 16 ? 4 : 0;
+    int available = width - 2 * margin;
+    if (available < 1 || height < 1) return p;
+    p.w = key_w + 18;
+    if (p.w < 56) p.w = 56;
+    if (p.w > 96) p.w = 96;
+    if (p.w > available) p.w = available;
+    p.h = key_h + 14;
+    if (p.h < 40) p.h = 40;
+    if (p.h > 88) p.h = 88;
+    if (p.h > height) p.h = height;
+    p.x = key_x + key_w / 2 - p.w / 2;
+    if (p.x < margin) p.x = margin;
+    if (p.x + p.w > width - margin) p.x = width - margin - p.w;
+    p.y = height + key_y - p.h - 8;
+    if (p.y < 0) p.y = 0;
+    if (p.y + p.h + 8 > height * 2) p.y = height * 2 - p.h - 8;
+    if (p.y < 0) p.y = 0;
+    p.tip = key_x + key_w / 2;
+    int inset = p.w < 24 ? p.w / 2 : 12;
+    if (p.tip < p.x + inset) p.tip = p.x + inset;
+    if (p.tip > p.x + p.w - inset) p.tip = p.x + p.w - inset;
+    return p;
+}
+#endif
