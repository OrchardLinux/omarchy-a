+static void drag_position(int offset)
+{
+    if (!layer_surface) return;
+    if (offset < 0) offset = 0;
+    if (offset > (int)height) offset = height;
+    drag_offset = offset;
+    zwlr_layer_surface_v1_set_margin(layer_surface, 0, 0, -offset, 0);
+    if (keyboard.exclusive)
+        zwlr_layer_surface_v1_set_exclusive_zone(layer_surface, height + offset);
+    wl_surface_commit(draw_surf.surf);
+}
