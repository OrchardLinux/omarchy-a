+static void drag_begin(enum drag_source source, int32_t id, int y, uint32_t time)
+{
+    animating = false;
+    drag_source = source;
+    drag_touch_id = id;
+    drag_start_y = y + drag_offset;
+    drag_last_y = drag_start_y;
+    drag_last_time = time;
+    drag_velocity = 0;
+}
+
+static void drag_motion(int y, uint32_t time)
+{
+    int absolute_y = y + drag_offset;
+    uint32_t dt = time - drag_last_time;
+    if (dt > 0 && dt < 150) {
+        drag_velocity = (double)(absolute_y - drag_last_y) / dt;
+    } else if (dt >= 150) {
+        drag_velocity = 0;
+    }
+    drag_last_time = time;
+    drag_last_y = absolute_y;
+    drag_position(absolute_y - drag_start_y);
+}
+
+static void drag_finish(bool cancelled, uint32_t time)
+{
+    bool flick = time - drag_last_time < 120 && drag_velocity > 0.6;
+    /* Near the bottom edge there is less screen left for the finger to travel. */
+    int threshold = ((int)height - drag_start_y) * 2 / 3;
+    if (threshold < 12) threshold = 12;
+    if (threshold > (int)height / 3) threshold = height / 3;
+    bool dismiss = !cancelled && (drag_offset >= threshold ||
+                                  (drag_offset >= 20 && flick));
+    drag_source = DRAG_NONE;
+    animation_from = drag_offset;
+    animation_to = dismiss ? height : 0;
+    animation_hide = dismiss;
+    animation_started = monotonic_ms();
+    animating = animation_from != animation_to;
+    if (!animating && dismiss) hide();
+}
+
+static void animation_tick(void)
+{
+    if (!animating) return;
+    double t = (monotonic_ms() - animation_started) / 180.0;
+    if (t >= 1.0) {
+        animating = false;
+        drag_position(animation_to);
+        if (animation_hide) hide();
+        return;
+    }
+    if (t < 0) t = 0;
+    double ease = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
+    drag_position(animation_from + (int)((animation_to - animation_from) * ease));
+}
+
+static void pending_begin(enum drag_source source, int32_t id, int x, int y, uint32_t time)
+{
+    pending_source = source;
+    pending_id = id;
+    pending_x = x;
+    pending_y = y;
+    pending_time = time;
+    pending_started = monotonic_ms();
+    preview_until = 0;
+    kbd_preview_key(&keyboard, kbd_get_key(&keyboard, x, y), keyboard.mods);
+}
+
+static void pending_commit(void)
+{
+    if (pending_source == DRAG_NONE) return;
+    pending_source = DRAG_NONE;
+    kbd_unpress_key(&keyboard, pending_time);
+    struct key *key = kbd_get_key(&keyboard, pending_x, pending_y);
+    if (key) kbd_press_key(&keyboard, key, pending_time);
+    else if (keyboard.compose) {
+        keyboard.compose = 0;
+        kbd_switch_layout(&keyboard, keyboard.prevlayout, keyboard.last_abc_index);
+    }
+}
+
+static void pending_motion(int x, int y, uint32_t time)
+{
+    int dx = x - pending_x, dy = y - pending_y;
+    if (dy >= 12 && dy > abs(dx)) {
+        enum drag_source source = pending_source;
+        int32_t id = pending_id;
+        int start_y = pending_y;
+        uint32_t start_time = pending_time;
+        pending_source = DRAG_NONE;
+        kbd_release_key(&keyboard, time);
+        drag_begin(source, id, start_y, start_time);
+        drag_motion(y, time);
+    } else if (abs(dx) >= 12 || dy <= -12) {
+        pending_commit();
+        kbd_motion_key(&keyboard, time, x, y);
+    }
+}
