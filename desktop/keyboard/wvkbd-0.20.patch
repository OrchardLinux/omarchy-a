+/* Show feedback immediately, without emitting a key or changing modifiers. */
+bool
+kbd_preview_key(struct kbd *kb, struct key *k, uint8_t mods)
+{
+    kbd_clear_last_popup(kb);
+    if (!kb->show_popup || !k || (k->type != Code && k->type != Copy) ||
+        (k->type == Code && k->code == KEY_SPACE)) return false;
+    const char *label = ((mods & Shift) || ((mods & CapsLock) &&
+        strlen(k->label) == 1 && isalpha((unsigned char)k->label[0])))
+        ? k->shift_label : k->label;
+    if (!label || !*label) return false;
+    struct key_preview_bounds p = key_preview_place(kb->w, kb->h, k->x, k->y, k->w, k->h);
+    if (p.w < 24 || p.h < 24) return false;
+    struct clr_scheme *scheme = &kb->schemes[k->scheme];
+    Color shadow = {.bgra = {0, 0, 0, 85}};
+    kb->last_popup_x = p.x;
+    kb->last_popup_y = p.y;
+    kb->last_popup_w = p.w + 3;
+    kb->last_popup_h = p.h + 12;
+    drw_fill_rectangle(kb->popup_surf, shadow, p.x + 2, p.y + 3, p.w, p.h, 12);
+    drw_fill_triangle(kb->popup_surf, shadow, p.tip - 4, p.y + p.h + 2, 12, 8);
+    drw_fill_triangle(kb->popup_surf, scheme->high, p.tip - 6, p.y + p.h - 1, 12, 9);
+    drw_fill_rectangle(kb->popup_surf, scheme->high, p.x, p.y, p.w, p.h, 12);
+    drw_fill_rectangle(kb->popup_surf, scheme->fg, p.x + 2, p.y + 2, p.w - 4, p.h - 4, 10);
+    PangoFontDescription *font = pango_font_description_copy(scheme->font_description);
+    int size = pango_font_description_get_size(font);
+    pango_font_description_set_size(font, (size > 0 ? size : 16 * PANGO_SCALE) * 3 / 2);
+    drw_draw_text(kb->popup_surf, scheme->text, p.x + 2, p.y + 2,
+                  p.w - 4, p.h - 4, 2, label, font);
+    pango_font_description_free(font);
+    return true;
+}
+
