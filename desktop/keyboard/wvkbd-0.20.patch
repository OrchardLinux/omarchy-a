+/* Downward tooltip tip, drawn on the same input-transparent popup as the key. */
+void
+drw_fill_triangle(struct drwsurf *ds, Color color, uint32_t x, uint32_t y,
+                  uint32_t w, uint32_t h)
+{
+    drwsurf_flip(ds);
+    drwsurf_damage(ds, x, y, w + 1, h + 1);
+    cairo_t *cr = ds->back_buffer->cairo;
+    cairo_save(cr);
+    cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+    cairo_set_source_rgba(cr, color.bgra[2] / 255.0, color.bgra[1] / 255.0,
+                         color.bgra[0] / 255.0, color.bgra[3] / 255.0);
+    cairo_move_to(cr, x, y);
+    cairo_line_to(cr, x + w, y);
+    cairo_line_to(cr, x + w / 2.0, y + h);
+    cairo_close_path(cr);
+    cairo_fill(cr);
+    cairo_restore(cr);
+}
